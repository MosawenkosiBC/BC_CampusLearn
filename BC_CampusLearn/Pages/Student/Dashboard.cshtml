@page
@model BC_CampusLearn.Pages.Student.DashboardModel
@using BC_CampusLearn.Models.Entities

@{
    ViewData["Title"] = "Student dashboard";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/tutor-dashboard.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/Dashboard.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/components/navigation-drawer.css"
          asp-append-version="true" />
}

@await Html.PartialAsync(
    "~/Pages/Shared/Components/NavigationDrawer/_NavigationDrawer.cshtml")

<section class="container py-4 dashboard-page">
    <h1 class="text-center">Dashboard</h1>

    <div class="row g-4 my-4 dashboard-summary">
        <div class="col-6 col-xl-3">
            <a asp-page="/Bookings/Index"
               asp-route-StatusFilter="Confirmed"
               class="tutor-stat-card dashboard-stat-link"
               aria-label="View confirmed upcoming sessions">
                <div class="tutor-stat-main">
                    <div class="tutor-stat-icon tutor-stat-icon--magenta">
                        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24">
                            <path d="M0 0h24v24H0z" fill="none" />
                            <path fill="currentColor" d="M18.25 3h-.75V2H16v1H8V2H6.5v1h-.75A2.755 2.755 0 0 0 3 5.75v12.5A2.755 2.755 0 0 0 5.75 21h12.5A2.755 2.755 0 0 0 21 18.25V5.75A2.755 2.755 0 0 0 18.25 3M5.75 4.5h.75V6H8V4.5h8V6h1.5V4.5h.75c.69 0 1.25.56 1.25 1.25V7.5h-15V5.75c0-.69.56-1.25 1.25-1.25m12.5 15H5.75c-.69 0-1.25-.56-1.25-1.25V9h15v9.25c0 .69-.56 1.25-1.25 1.25" />
                        </svg>
                    </div>
                    <div>
                        <h2>Upcoming sessions</h2>
                        <p>@Model.Summary.UpcomingSessionCount</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-6 col-xl-3">
            <a asp-page="/Bookings/Index"
               asp-route-StatusFilter="Pending"
               class="tutor-stat-card dashboard-stat-link"
               aria-label="View pending sessions">
                <div class="tutor-stat-main">
                    <div class="tutor-stat-icon tutor-stat-icon--teal">
                        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24">
                            <path d="M0 0h24v24H0z" fill="none" />
                            <path fill="currentColor" fill-rule="evenodd" d="m12.6 11.503l3.891 3.891l-.848.849L11.4 12V6h1.2zM12 22C6.477 22 2 17.523 2 12S6.477 2 12 2s10 4.477 10 10s-4.477 10-10 10m0-1.2a8.8 8.8 0 1 0 0-17.6a8.8 8.8 0 0 0 0 17.6" />
                        </svg>
                    </div>
                    <div>
                        <h2>Pending sessions</h2>
                        <p>@Model.Summary.PendingSessionCount</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-6 col-xl-3">
            <a asp-page="/Bookings/Index"
               asp-route-StatusFilter="Completed"
               class="tutor-stat-card dashboard-stat-link"
               aria-label="View completed sessions">
                <div class="tutor-stat-main">
                    <div class="tutor-stat-icon tutor-stat-icon--magenta">
                        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24">
                            <path d="M0 0h24v24H0z" fill="none" />
                            <path fill="currentColor" d="M6 5h2.5a3 3 0 0 1 3-3a3 3 0 0 1 3 3H17a3 3 0 0 1 3 3v11a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3m0 1a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-1v3H7V6zm2 2h7V6H8zm3.5-5a2 2 0 0 0-2 2h4a2 2 0 0 0-2-2m5.65 8.6L10 18.75l-3.2-3.2l.7-.71l2.5 2.5l6.44-6.45z" />
                        </svg>
                    </div>
                    <div>
                        <h2>Completed sessions</h2>
                        <p>@Model.Summary.CompletedSessionCount</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-6 col-xl-3">
            <a asp-page="/Bookings/Index"
               asp-route-StatusFilter="Cancelled"
               class="tutor-stat-card dashboard-stat-link"
               aria-label="View cancelled sessions">
                <div class="tutor-stat-main">
                    <div class="tutor-stat-icon tutor-stat-icon--teal">
                        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 20 20">
                            <path d="M0 0h20v20H0z" fill="none" />
                            <g fill="currentColor" fill-rule="evenodd" clip-rule="evenodd">
                                <path d="M10 3.5a6.5 6.5 0 1 0 0 13a6.5 6.5 0 0 0 0-13M2.5 10a7.5 7.5 0 1 1 15 0a7.5 7.5 0 0 1-15 0" />
                                <path d="M15.304 4.697a.5.5 0 0 1 0 .707l-9.9 9.9a.5.5 0 1 1-.707-.707l9.9-9.9a.5.5 0 0 1 .707 0" />
                            </g>
                        </svg>
                    </div>
                    <div>
                        <h2>Cancelled sessions</h2>
                        <p>@Model.Summary.CancelledSessionCount</p>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <div class="dashboard-primary-grid">
        <section class="dashboard-session-column"
                 aria-labelledby="student-next-session-title">
            <h2 id="student-next-session-title"
                class="tutor-availability-section-title">
                Next session
            </h2>

            <div class="tutor-next-session">
                @if (Model.NextSession is null)
                {
                    <div class="tutor-next-session-empty">
                        <svg aria-hidden="true" width="34" height="34" viewBox="0 0 20 20">
                            <path d="M0 0h20v20H0z" fill="none" />
                            <path fill="currentColor" d="M4 4.707L2.146 2.854a.5.5 0 1 1 .708-.708l15 15a.5.5 0 0 1-.708.708l-1.241-1.242A2 2 0 0 1 14 18H6a2 2 0 0 1-2-2zm11 11l-1.032-1.032A.5.5 0 0 1 13.5 15h-5a.5.5 0 0 1 0-1h4.793l-1-1H8.5a.5.5 0 0 1 0-1h2.793l-1-1H8.5a.5.5 0 0 1 0-1h.793L5 5.707V16a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1zM12.121 10l1 1h.379a.5.5 0 0 0 0-1zM15 8v4.879l1 1V7.414a1.5 1.5 0 0 0-.44-1.06l-3.914-3.915A1.5 1.5 0 0 0 10.586 2H6c-.521 0-.996.2-1.352.526l.708.709A1 1 0 0 1 6 3h4v3.5A1.5 1.5 0 0 0 11.5 8zm-9 2.5a.5.5 0 1 0 1 0a.5.5 0 0 0-1 0m.5 1.5a.5.5 0 1 0 0 1a.5.5 0 0 0 0-1M6 14.5a.5.5 0 1 1 1 0a.5.5 0 0 1-1 0M14.793 7H11.5a.5.5 0 0 1-.5-.5V3.207z" />
                        </svg>
                        <h3>No upcoming sessions</h3>
                        <p>Your next confirmed session will appear here.</p>
                    </div>
                }
                else
                {
                    DateTimeOffset sessionStart =
                        Model.NextSession.AvailableTime.ToLocalTime();
                    DateTimeOffset sessionEnd =
                        Model.NextSession.SessionEnd.ToLocalTime();
                    string sessionDate =
                        sessionStart.Date == DateTimeOffset.Now.Date
                            ? "Today"
                            : sessionStart.ToString("dd MMM yyyy");

                    <div class="tutor-next-session-content">
                        <div class="tutor-next-session-topline">
                            <div class="tutor-next-session-student">
                                <h3>@Model.NextSession.TutorName</h3>
                                <p>
                                    @Model.NextSession.ModuleCode:
                                    @Model.NextSession.ModuleName
                                </p>
                            </div>

                            <span class="tutor-session-countdown"
                                  data-student-session-countdown
                                  data-session-start="@Model.NextSession.AvailableTime.ToString("O")">
                            </span>
                        </div>

                        <dl class="tutor-next-session-details">
                            <div>
                                <dt>Date</dt>
                                <dd>@sessionDate</dd>
                            </div>
                            <div>
                                <dt>Time</dt>
                                <dd>@sessionStart.ToString("HH:mm")&ndash;@sessionEnd.ToString("HH:mm")</dd>
                            </div>
                            <div>
                                <dt>Location</dt>
                                <dd>@Model.NextSession.Location</dd>
                            </div>
                        </dl>

                        <div class="tutor-next-session-actions dashboard-next-session-actions">
                            <a asp-page="/Bookings/Index"
                               class="tutor-view-session">
                                View session
                            </a>
                            <button type="button"
                                    class="tutor-join-session">
                                <iconify-icon
                                    icon="mdi:microsoft-teams"
                                    aria-hidden="true"></iconify-icon>
                                Join Meeting
                            </button>
                        </div>
                    </div>
                }
            </div>
        </section>

        <section class="dashboard-session-column">
            <article class="dashboard-support-card dashboard-tutor-card"
                     aria-labelledby="student-support-title">
                <div class="dashboard-tutor-icon">
                    <svg aria-hidden="true" width="42" height="42" viewBox="0 0 24 24">
                        <path d="M0 0h24v24H0z" fill="none" />
                        <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5">
                            <path d="M17.252 12.49c-.284 2.365-1.833 3.31-2.502 3.996c-.67.688-.55.825-.505 1.834a.916.916 0 0 1-.916.971h-2.658a.92.92 0 0 1-.917-.971c0-.99.092-1.22-.504-1.834c-.76-.76-2.548-1.833-2.548-4.784a5.307 5.307 0 1 1 10.55.788" />
                            <path d="M10.46 19.236v1.512c0 .413.23.752.513.752h2.053c.285 0 .514-.34.514-.752v-1.512m-2.32-10.54a2.227 2.227 0 0 0-2.226 2.227m10.338.981h1.834m-3.68-6.012l1.301-1.301M18.486 17l1.301 1.3M12 2.377V3.86m-6.76.73l1.292 1.302M4.24 18.3L5.532 17m-.864-5.096H2.835" />
                        </g>
                    </svg>
                </div>

                <div class="dashboard-tutor-content">
                    <h2 id="student-support-title">
                        Get The Support You Need
                    </h2>
                    <p>
                        Get personalised tutor support or discover helpful
                        information and shared resources.
                    </p>

                    <div class="dashboard-tutor-actions">
                        <a asp-page="/Tutors/Index"
                           class="dashboard-find-tutor">
                            Find A Tutor
                        </a>
                        <button type="button"
                                class="dashboard-explore-resources"
                                data-bs-toggle="modal"
                                data-bs-target="#moduleSubscriptionsModal"
                                aria-controls="moduleSubscriptionsModal">
                            Explore Resources
                        </button>
                    </div>
                </div>
            </article>
        </section>
    </div>

    <section class="dashboard-all-sessions"
             aria-labelledby="student-all-sessions-title">
        <div class="dashboard-section-heading">
            <h2 id="student-all-sessions-title"
                class="dashboard-section-title">
                All sessions
            </h2>
            @if (Model.Sessions.Count > 0)
            {
                <a asp-page="/Bookings/Index"
                   class="dashboard-view-all-sessions">
                    <span>View all sessions</span>
                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="1em"
                         height="1em"
                         viewBox="0 0 24 24"
                         aria-hidden="true">
                        <path d="M0 0h24v24H0z" fill="none" />
                        <path fill="currentColor"
                              d="M18 7.05a1 1 0 0 0-1-1L9 6a1 1 0 0 0 0 2h5.56l-8.27 8.29a1 1 0 0 0 0 1.42a1 1 0 0 0 1.42 0L16 9.42V15a1 1 0 0 0 1 1a1 1 0 0 0 1-1Z" />
                    </svg>
                </a>
            }
        </div>

            <div class="tutor-sessions">
                <div class="tutor-sessions-table-wrap">
                    <table class="tutor-sessions-table">
                        <thead>
                            <tr>
                                <th scope="col">Tutor</th>
                                <th scope="col">Module</th>
                                <th scope="col">Date &amp; Time</th>
                                <th scope="col">Location</th>
                                <th scope="col">Status</th>
                                <th scope="col">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Sessions.Count == 0)
                            {
                                <tr>
                                    <td colspan="6"
                                        class="tutor-sessions-empty">
                                        No sessions to display
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var booking in Model.Sessions)
                                {
                                    DateTimeOffset localStart =
                                        booking.AvailableTime.ToLocalTime();
                                    DateTimeOffset localEnd =
                                        booking.SessionEnd.ToLocalTime();
                                    string statusClass =
                                        booking.Status.ToString()
                                            .ToLowerInvariant();

                                <tr>
                                    <td data-label="Tutor Name">
                                        @booking.TutorName
                                    </td>
                                    <td data-label="Module">
                                        @booking.ModuleCode
                                    </td>
                                    <td data-label="Date &amp; Time">
                                        <span class="tutor-session-date">
                                            @localStart.ToString("dd MMM yyyy")
                                        </span>
                                        <span class="tutor-session-time">
                                            @localStart.ToString("HH:mm")&ndash;@localEnd.ToString("HH:mm")
                                        </span>
                                    </td>
                                    <td data-label="Location">
                                        @booking.Location
                                    </td>
                                    <td data-label="Status">
                                        <span class="tutor-session-status tutor-session-status--@statusClass">
                                            @booking.Status
                                        </span>
                                    </td>
                                    <td data-label="Action">
                                        <div class="dropdown dashboard-session-action-menu">
                                            <button type="button"
                                                    class="tutor-session-action"
                                                    data-bs-toggle="dropdown"
                                                    data-bs-display="static"
                                                    aria-expanded="false"
                                                    aria-label="Actions for session with @booking.TutorName">
                                                <svg class="tutor-session-action-dots"
                                                     viewBox="0 0 24 24"
                                                     aria-hidden="true">
                                                    <circle cx="12" cy="5" r="1.6" />
                                                    <circle cx="12" cy="12" r="1.6" />
                                                    <circle cx="12" cy="19" r="1.6" />
                                                </svg>
                                            </button>
                                            <div class="dropdown-menu dropdown-menu-end">
                                                <button type="button"
                                                        class="dropdown-item">
                                                    Session Details
                                                </button>
                                                @if (booking.Status == BookingStatus.Pending ||
                                                    booking.Status == BookingStatus.Confirmed)
                                                {
                                                    <button type="button"
                                                            class="dropdown-item">
                                                        Cancel session
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="dashboard-resources" aria-labelledby="subscribed-modules-title">
        <h2 id="subscribed-modules-title">Subscribed Modules</h2>

        <div class="dashboard-resources-empty">
            <svg aria-hidden="true" width="38" height="38" viewBox="0 0 24 24">
                <path d="M0 0h24v24H0z" fill="none" />
                <path fill="currentColor" d="M8.25 8A.75.75 0 0 1 9 7.25h7a.75.75 0 0 1 0 1.5H9A.75.75 0 0 1 8.25 8M9 10.25a.75.75 0 0 0 0 1.5h5a.75.75 0 0 0 0-1.5z" />
                <path fill="currentColor" fill-rule="evenodd" d="M8.5 3.25A4.75 4.75 0 0 0 3.75 8v10a3.75 3.75 0 0 0 3.75 3.75h11A1.75 1.75 0 0 0 20.25 20V5a1.75 1.75 0 0 0-1.75-1.75zm10.25 11V5a.25.25 0 0 0-.25-.25h-10A3.25 3.25 0 0 0 5.25 8v7a3.73 3.73 0 0 1 2.25-.75zm0 1.5H7.5a2.25 2.25 0 0 0 0 4.5h11a.25.25 0 0 0 .25-.25z" clip-rule="evenodd" />
            </svg>

            <h3>No module resources yet</h3>
            <p>
                Module subscriptions are coming soon. Once available, resources
                for your subscribed modules will appear here.
            </p>
        </div>
    </section>
</section>

<div class="modal fade dashboard-subscriptions-modal"
     id="moduleSubscriptionsModal"
     tabindex="-1"
     aria-labelledby="moduleSubscriptionsModalTitle"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div class="dashboard-subscriptions-title">
                    <svg aria-hidden="true" width="34" height="34" viewBox="0 0 24 24">
                        <path d="M0 0h24v24H0z" fill="none" />
                        <path fill="currentColor" d="M8.25 8A.75.75 0 0 1 9 7.25h7a.75.75 0 0 1 0 1.5H9A.75.75 0 0 1 8.25 8M9 10.25a.75.75 0 0 0 0 1.5h5a.75.75 0 0 0 0-1.5z" />
                        <path fill="currentColor" fill-rule="evenodd" d="M8.5 3.25A4.75 4.75 0 0 0 3.75 8v10a3.75 3.75 0 0 0 3.75 3.75h11A1.75 1.75 0 0 0 20.25 20V5a1.75 1.75 0 0 0-1.75-1.75zm10.25 11V5a.25.25 0 0 0-.25-.25h-10A3.25 3.25 0 0 0 5.25 8v7a3.73 3.73 0 0 1 2.25-.75zm0 1.5H7.5a2.25 2.25 0 0 0 0 4.5h11a.25.25 0 0 0 .25-.25z" clip-rule="evenodd" />
                    </svg>
                    <h2 class="modal-title" id="moduleSubscriptionsModalTitle">Module Subscriptions</h2>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <p class="dashboard-subscriptions-description">
                    Subscribe to a module to view and engage with learning resources shared by tutors.
                </p>

                <div class="dashboard-subscriptions-fields">
                    <label for="subscribe-module">Select a Module to Subscribe:</label>
                    <select id="subscribe-module" disabled>
                        <option selected></option>
                    </select>

                    <label for="unsubscribe-module">Select a Module to Unsubscribe:</label>
                    <select id="unsubscribe-module" disabled>
                        <option selected></option>
                    </select>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.iconify.design/iconify-icon/3.0.0/iconify-icon.min.js"></script>
    <script src="~/js/components/navigation-drawer.js"
            asp-append-version="true"></script>
    <script src="~/js/student-dashboard.js"
            asp-append-version="true"></script>
}
