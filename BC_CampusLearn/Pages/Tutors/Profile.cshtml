@page
@model BC_CampusLearn.Pages.Tutors.ProfileModel
@using BC_CampusLearn.Models.Entities

@{
    ViewData["Title"] = "Personal Details";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/components/navigation-drawer.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/tutor-profile.css"
          asp-append-version="true" />
}

@await Html.PartialAsync(
    "~/Pages/Shared/Components/NavigationDrawer/_NavigationDrawer.cshtml")

<section class="tutor-profile-page py-4">
    <h1 class="tutor-manage-profile-title">Manage Account</h1>

    <div class="tutor-profile-mobile-card">
    <aside class="tutor-profile-card" aria-label="Tutor account navigation">
        <div class="tutor-profile-identity">
            <div class="tutor-profile-photo-wrap">
                @if (!string.IsNullOrWhiteSpace(Model.ProfileImagePath))
                {
                    <img class="tutor-profile-photo"
                         src="@Model.ProfileImagePath"
                         alt="Profile photo of @Model.DisplayName" />
                }
                else
                {
                    <div class="tutor-profile-photo tutor-profile-initials"
                         aria-label="@Model.DisplayName initials">
                        @Model.Initials
                    </div>
                }

                <form method="post"
                      enctype="multipart/form-data"
                      asp-page-handler="UploadProfileImage"
                      class="tutor-profile-photo-form">
                    <label class="tutor-profile-camera"
                           for="tutor-profile-image"
                           title="Add profile image">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             aria-hidden="true">
                            <path d="M9 4.5 7.7 6H5a3 3 0 0 0-3 3v8a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3V9a3 3 0 0 0-3-3h-2.7L15 4.5zm3 13a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9m0-2a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5" />
                        </svg>
                        <span class="visually-hidden">Add profile image</span>
                    </label>
                    <input id="tutor-profile-image"
                           asp-for="ProfileImage"
                           class="visually-hidden"
                           type="file"
                           accept="image/jpeg,image/png,image/webp"
                           onchange="this.form.submit()" />
                </form>
            </div>

            @if (TempData["ProfileImageError"] is string imageError)
            {
                <p class="tutor-profile-image-error" role="alert">@imageError</p>
            }

            <h1>@Model.DisplayName</h1>
            <p>@Model.StudentNumber</p>
        </div>

        <div class="tutor-profile-divider"></div>

        <nav class="tutor-profile-nav" aria-label="Tutor profile sections">
            <a asp-page="/Tutors/Profile"
               class="tutor-profile-nav-link is-active"
               aria-current="page">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="1em" height="1em" viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M0 0h24v24H0z" fill="none" />
                    <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5">
                        <circle cx="10" cy="7" r="4" />
                        <path d="M11 14.035A14 14 0 0 0 10 14c-5 0-8 2.5-8 5a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2q0-.504-.16-1m3.849-9.066l-.623-.623a1.063 1.063 0 0 0-1.503 0l-3.349 3.35a3.2 3.2 0 0 0-.872 1.629L15 15l1.71-.342a3.2 3.2 0 0 0 1.63-.872l3.349-3.349a1.063 1.063 0 0 0 0-1.503" />
                    </g>
                </svg>
                <span>Personal Details</span>
            </a>
            <a asp-page="/Tutors/PublicProfile"
               class="tutor-profile-nav-link">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="1em" height="1em" viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M0 0h24v24H0z" fill="none" />
                    <g fill="none" stroke="currentColor" stroke-width="1.5">
                        <circle cx="12" cy="12" r="10" />
                        <ellipse cx="12" cy="12" rx="4" ry="10" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2 12h20" />
                    </g>
                </svg>
                <span>Public Profile</span>
            </a>
            <a asp-page="/Tutors/StatisticsOverview"
               class="tutor-profile-nav-link">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="1em" height="1em" viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M0 0h24v24H0z" fill="none" />
                    <path fill="currentColor"
                          d="M7 21H3v-8h4zm7 0h-4V3h4zm7-13v13h-4V8z" />
                </svg>
                <span>Statistics Overview</span>
            </a>
        </nav>
    </aside>

    <div class="tutor-personal-details">
        <h2>Personal Details</h2>

        <section class="tutor-personal-details-card"
                 aria-label="Tutor personal details">
            <dl class="tutor-personal-details-grid">
                <div>
                    <dt>Name</dt>
                    <dd>@Model.FirstName</dd>
                </div>
                <div>
                    <dt>Surname</dt>
                    <dd>@Model.Surname</dd>
                </div>
                <div>
                    <dt>Student Number</dt>
                    <dd>@Model.StudentNumber</dd>
                </div>
                <div>
                    <dt>Email Address</dt>
                    <dd>@Model.EmailAddress</dd>
                </div>
                <div>
                    <dt>Year of Study</dt>
                    <dd>@Model.YearOfStudy</dd>
                </div>
                <div>
                    <dt>Program Of Study</dt>
                    <dd>@Model.ProgramOfStudy</dd>
                </div>
                <div class="tutor-phone-detail">
                    <dt>Phone Number</dt>
                    <dd>
                        <form method="post" asp-page-handler="UpdatePhone"
                              class="tutor-phone-form"
                              data-phone-form>
                            <input asp-for="PhoneInput.PhoneNumber"
                                   inputmode="numeric"
                                   autocomplete="tel"
                                   maxlength="10"
                                   pattern="[0-9]{10}"
                                   required
                                   data-phone-input />
                            <button type="submit" aria-label="Update phone number" title="Update phone number">
                                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M0 0h24v24H0z" fill="none" />
                                    <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.782 16.31L3 21l4.69-.782a3.96 3.96 0 0 0 2.151-1.106L20.42 8.532a1.98 1.98 0 0 0 0-2.8L18.269 3.58a1.98 1.98 0 0 0-2.802 0L4.888 14.16a3.96 3.96 0 0 0-1.106 2.15M14 6l4 4" />
                                </svg>
                                <span class="visually-hidden">Update phone number</span>
                            </button>
                            <span asp-validation-for="PhoneInput.PhoneNumber"></span>
                        </form>
                    </dd>
                </div>
                <div class="tutor-personal-details-modules">
                    <dt class="tutor-modules-heading">
                        <span>Modules Allowed to Tutor</span>
                        <div class="tutor-module-update-action">
                            <button type="button"
                                    data-bs-toggle="modal"
                                    data-bs-target="#module-change-modal">
                                <span class="tutor-module-update-icon" aria-hidden="true">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
                                        <path d="M0 0h24v24H0z" fill="none" />
                                        <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.782 16.31L3 21l4.69-.782a3.96 3.96 0 0 0 2.151-1.106L20.42 8.532a1.98 1.98 0 0 0 0-2.8L18.269 3.58a1.98 1.98 0 0 0-2.802 0L4.888 14.16a3.96 3.96 0 0 0-1.106 2.15M14 6l4 4" />
                                    </svg>
                                </span>
                                <span class="tutor-module-update-copy">
                                    <strong>Request Module Changes</strong>
                                </span>
                            </button>
                        </div>
                    </dt>
                    <dd>
                        @if (Model.ModulesAllowedToTutor.Count == 0)
                        {
                            <span class="tutor-profile-empty-value">None</span>
                        }
                        else
                        {
                            @foreach (var module in Model.ModulesAllowedToTutor)
                            {
                                <span class="tutor-profile-module">@module.ModuleName</span>
                            }
                        }
                    </dd>

                    @if (Model.PendingModuleRequests.Count > 0)
                    {
                        <div class="tutor-pending-module-requests">
                            <strong>Pending requests</strong>
                            @foreach (var request in Model.PendingModuleRequests)
                            {
                                <span>
                                    @(request.RequestType == TutorModuleChangeRequestType.Add ? "Add" : "Remove")
                                    @request.ModuleName
                                </span>
                            }
                        </div>
                    }
                </div>
            </dl>

            @if (TempData["PhoneNumberSaved"] is true)
            {
                <div class="tutor-profile-success" role="status">
                    Phone number updated successfully.
                </div>
            }
            @if (TempData["ModuleRequestSaved"] is true)
            {
                <div class="tutor-profile-success" role="status">
                    Your module change request has been submitted for review.
                </div>
            }
        </section>

        <section class="tutor-danger-zone" aria-labelledby="profile-danger-zone-title">
            <div>
                <h3 id="profile-danger-zone-title">Danger Zone</h3>
                <p>Submit a request to permanently leave the tutor programme.</p>
            </div>
            <a asp-page="/Tutors/StatisticsOverview"
               asp-route-openDeregistration="true"
               class="tutor-deregistration-button">
                Request Tutor Deregistration
            </a>
        </section>
    </div>
    </div>
</section>

<div class="modal fade tutor-account-modal"
     id="module-change-modal"
     tabindex="-1"
     aria-labelledby="module-change-title"
     aria-hidden="true"
     data-open-on-load="@Model.OpenModuleRequestModal.ToString().ToLowerInvariant()">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="RequestModuleChange">
                <div class="modal-header">
                    <div>
                        <h2 class="modal-title" id="module-change-title">Request a module change</h2>
                        <p>Your request will be reviewed before your approved modules change.</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="tutor-profile-validation"></div>
                    <div class="tutor-profile-field">
                        <label asp-for="ModuleRequestInput.RequestType"></label>
                        <select asp-for="ModuleRequestInput.RequestType" data-module-request-type>
                            <option value="@TutorModuleChangeRequestType.Add">Add a module</option>
                            <option value="@TutorModuleChangeRequestType.Remove">Remove a module</option>
                        </select>
                        <span asp-validation-for="ModuleRequestInput.RequestType"></span>
                    </div>
                    <div class="tutor-profile-field">
                        <label asp-for="ModuleRequestInput.ProgrammeModuleId"></label>
                        <div class="tutor-module-combobox" data-module-combobox>
                            <button type="button"
                                    class="tutor-module-combobox-toggle"
                                    data-module-toggle
                                    aria-haspopup="listbox"
                                    aria-expanded="false">
                                <span data-module-selected>Select a module</span>
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="m7 10l5 5l5-5" />
                                </svg>
                            </button>
                            <div class="tutor-module-combobox-menu"
                                 data-module-menu
                                 hidden>
                                <div class="tutor-module-combobox-search">
                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <circle cx="11" cy="11" r="7" />
                                        <path d="m16 16l4 4" />
                                    </svg>
                                    <input type="search"
                                           data-module-search
                                           placeholder="Search modules..."
                                           autocomplete="off"
                                           aria-label="Search modules" />
                                </div>
                                <div class="tutor-module-combobox-options"
                                     data-module-options
                                     role="listbox"></div>
                            </div>
                            <select asp-for="ModuleRequestInput.ProgrammeModuleId"
                                    class="visually-hidden"
                                    data-module-selector
                                    tabindex="-1"
                                    aria-hidden="true">
                                <option value="">Select a module</option>
                                @foreach (var module in Model.ModulesAvailableToAdd)
                                {
                                    <option value="@module.ProgrammeModuleId" data-request-type="Add">
                                        @module.ModuleName
                                    </option>
                                }
                                @foreach (var module in Model.ModulesAllowedToTutor)
                                {
                                    <option value="@module.ProgrammeModuleId" data-request-type="Remove">
                                        @module.ModuleName
                                    </option>
                                }
                            </select>
                        </div>
                        <span asp-validation-for="ModuleRequestInput.ProgrammeModuleId"></span>
                    </div>
                    <div class="tutor-profile-field">
                        <label asp-for="ModuleRequestInput.Reason">
                            Reason <span class="tutor-required-marker" aria-hidden="true">*</span>
                        </label>
                        <textarea asp-for="ModuleRequestInput.Reason"
                                  rows="4"
                                  maxlength="500"
                                  required
                                  placeholder="Tell the reviewer why you need this change."></textarea>
                        <span asp-validation-for="ModuleRequestInput.Reason"></span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="tutor-modal-cancel" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="tutor-modal-primary">Submit request</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/components/navigation-drawer.js" asp-append-version="true"></script>
    <script src="~/js/tutor-profile.js" asp-append-version="true"></script>
}
