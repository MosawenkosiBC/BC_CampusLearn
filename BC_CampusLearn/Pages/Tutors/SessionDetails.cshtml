@page "{bookingId:int}"
@model BC_CampusLearn.Pages.Tutors.SessionDetailsModel
@using BC_CampusLearn.Services.Sessions

@{
    ViewData["Title"] = "Manage session";
    DateTimeOffset start = Model.Session.ScheduledStartTime.ToOffset(TimeSpan.FromHours(2));
    DateTimeOffset end = start.AddHours((int)Model.Session.Duration);
    bool hasAttachedLinks = Model.Session.PreparationLinks.Count > 0;
    bool hasAttachedDocuments = Model.Session.Documents.Count > 0;
    bool hasSessionCountdown = Model.Session.Status is
        BC_CampusLearn.Models.Entities.BookingStatus.Confirmed or
        BC_CampusLearn.Models.Entities.BookingStatus.InProgress;
    bool isCompletedSession = Model.Session.Status ==
        BC_CampusLearn.Models.Entities.BookingStatus.Completed;
    bool chatIsClosed = SessionCommunicationPolicy.IsClosed(
        Model.Session.Status,
        Model.Session.TutorEvaluation is not null,
        Model.Session.StudentEvaluation is not null);
    string[] studentNameParts = Model.Session.StudentName.Split(
        ' ',
        StringSplitOptions.RemoveEmptyEntries);
    string studentInitials = studentNameParts.Length > 1
        ? $"{studentNameParts[0][0]}{studentNameParts[^1][0]}".ToUpperInvariant()
        : Model.Session.StudentName[..Math.Min(2, Model.Session.StudentName.Length)].ToUpperInvariant();
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Valley+Sans:ital,wght@0,100..900;1,100..900&amp;display=swap"
          rel="stylesheet" />
    <link rel="stylesheet" href="~/css/tutor-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/navigation-drawer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-session-details.css" asp-append-version="true" />
}

@await Html.PartialAsync("~/Pages/Shared/Components/NavigationDrawer/_NavigationDrawer.cshtml")

<main class="container-fluid px-3 px-xl-5 pt-2 pb-4 tutor-session-details-page">
    <header class="manage-session-heading">
        <h1>Session Details</h1>
        @if (Model.Session.Status is BC_CampusLearn.Models.Entities.BookingStatus.Confirmed or
             BC_CampusLearn.Models.Entities.BookingStatus.InProgress or
             BC_CampusLearn.Models.Entities.BookingStatus.Completed)
        {
            <div class="completed-session-review manage-session-review-action">
                @if (Model.Session.Status == BC_CampusLearn.Models.Entities.BookingStatus.Completed)
                {
                    @if (Model.Session.TutorEvaluation is not null)
                    {
                        <button type="button" disabled aria-label="Evaluation submitted" title="Evaluation submitted">
                            <span class="review-action-label">Evaluation Submitted</span>
                            <svg class="review-action-mobile-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M0 0h24v24H0z" fill="none" />
                                <g fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5">
                                    <path d="m16.425 4.605l.99-.99a2.1 2.1 0 0 1 2.97 2.97l-.99.99m-2.97-2.97l-6.66 6.66a3.96 3.96 0 0 0-1.041 1.84L8 16l2.896-.724a3.96 3.96 0 0 0 1.84-1.042l6.659-6.659m-2.97-2.97l2.97 2.97" />
                                    <path stroke-linecap="round" d="M19 13.5c0 3.288 0 4.931-.908 6.038a4 4 0 0 1-.554.554C16.43 21 14.788 21 11.5 21H11c-3.771 0-5.657 0-6.828-1.172S3 16.771 3 13v-.5c0-3.287 0-4.931.908-6.038q.25-.304.554-.554C5.57 5 7.212 5 10.5 5" />
                                </g>
                            </svg>
                        </button>
                    }
                    else
                    {
                        <button type="button" data-bs-toggle="modal" data-bs-target="#review-session-modal"
                                aria-label="Review session" title="Review session">
                            <span class="review-action-label">Review Session</span>
                            <svg class="review-action-mobile-icon" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M0 0h24v24H0z" fill="none" />
                                <g fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5">
                                    <path d="m16.425 4.605l.99-.99a2.1 2.1 0 0 1 2.97 2.97l-.99.99m-2.97-2.97l-6.66 6.66a3.96 3.96 0 0 0-1.041 1.84L8 16l2.896-.724a3.96 3.96 0 0 0 1.84-1.042l6.659-6.659m-2.97-2.97l2.97 2.97" />
                                    <path stroke-linecap="round" d="M19 13.5c0 3.288 0 4.931-.908 6.038a4 4 0 0 1-.554.554C16.43 21 14.788 21 11.5 21H11c-3.771 0-5.657 0-6.828-1.172S3 16.771 3 13v-.5c0-3.287 0-4.931.908-6.038q.25-.304.554-.554C5.57 5 7.212 5 10.5 5" />
                                </g>
                            </svg>
                        </button>
                    }
                }
                else
                {
                    <button type="button" disabled aria-label="Review session unavailable" title="Review session unavailable">
                        <span class="review-action-label">Review Session</span>
                        <svg class="review-action-mobile-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M0 0h24v24H0z" fill="none" />
                            <g fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="1.5">
                                <path d="m16.425 4.605l.99-.99a2.1 2.1 0 0 1 2.97 2.97l-.99.99m-2.97-2.97l-6.66 6.66a3.96 3.96 0 0 0-1.041 1.84L8 16l2.896-.724a3.96 3.96 0 0 0 1.84-1.042l6.659-6.659m-2.97-2.97l2.97 2.97" />
                                <path stroke-linecap="round" d="M19 13.5c0 3.288 0 4.931-.908 6.038a4 4 0 0 1-.554.554C16.43 21 14.788 21 11.5 21H11c-3.771 0-5.657 0-6.828-1.172S3 16.771 3 13v-.5c0-3.287 0-4.931.908-6.038q.25-.304.554-.554C5.57 5 7.212 5 10.5 5" />
                            </g>
                        </svg>
                    </button>
                }
            </div>
        }
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.SessionActionMessage))
    {
        @await Html.PartialAsync("_CampusAlert",
            new CampusAlertViewModel(
                Model.SessionActionMessage,
                Model.SessionActionError
                    ? CampusAlertVariant.Danger
                    : CampusAlertVariant.Success))
    }

    <div class="manage-session-layout session-overview-layout">
        <div class="manage-session-primary">
            <section class="session-information-section is-mobile-collapsed" aria-labelledby="session-information-title">
                <header class="manage-card-heading">
                    <h2 id="session-information-title">Session Information</h2>
                </header>

                <div class="manage-session-card session-information-card">
                    <div class="session-information-summary">
                        <div class="session-information-summary-person">
                            <span>Student Name</span>
                            <strong>@Model.Session.StudentName</strong>
                        </div>
                        <button type="button" class="session-information-toggle"
                                aria-expanded="false" aria-controls="tutor-session-information-details"
                                aria-label="Show all session information" data-session-information-toggle>
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="m7 10 5 5 5-5" />
                            </svg>
                        </button>
                    </div>

                    <span class="session-status-badge status-@Model.Session.Status.ToString().ToLowerInvariant()">
                        <span>@Model.Session.Status.ToDisplayText()</span>
                        @if (Model.Session.Status == BC_CampusLearn.Models.Entities.BookingStatus.Confirmed)
                        {
                            <span class="session-status-start-remaining"
                                  data-session-start-remaining
                                  data-session-start="@Model.Session.ScheduledStartTime.ToString("O")"
                                  data-session-active="false"
                                  data-session-locked="false">
                                @Model.SessionStartRemainingText
                            </span>
                        }
                    </span>
                    <div class="session-information-content" id="tutor-session-information-details">
                        <div class="session-information-main">
                            <div class="session-information-grid">
                                <div class="session-readonly-field session-primary-person-field">
                                    <label for="session-student-name">Student Name</label>
                                    <input id="session-student-name"
                                           type="text"
                                           value="@Model.Session.StudentName"
                                           readonly />
                                </div>
                                <div class="session-readonly-field">
                                    <label for="session-student-email">Student Email</label>
                                    <input id="session-student-email"
                                           type="email"
                                           value="@(string.IsNullOrWhiteSpace(Model.Session.StudentEmail) ? "Not available" : Model.Session.StudentEmail)"
                                           readonly />
                                </div>
                            </div>

                            <div class="session-information-grid">
                                <div class="session-readonly-field">
                                    <label for="session-location">Location</label>
                                    <input id="session-location"
                                           type="text"
                                           value="@Model.Session.Location"
                                           readonly />
                                </div>
                                <div class="session-readonly-field">
                                    <label for="session-duration">Duration</label>
                                    <input id="session-duration"
                                           type="text"
                                           value="@((int)Model.Session.Duration) hour"
                                           readonly />
                                </div>
                            </div>

                            <div class="session-information-grid session-date-grid">
                                <div class="session-readonly-field">
                                    <label for="session-date">Session Date</label>
                                    <input id="session-date"
                                           type="text"
                                           value="@start.ToString("dd MMM yyyy, HH:mm")"
                                           readonly />
                                </div>
                            </div>

                            <div class="session-information-grid">
                                <div class="session-readonly-field">
                                    <label for="session-module-code">Module Code</label>
                                    <input id="session-module-code"
                                           type="text"
                                           value="@Model.Session.ProgrammeModule.ModuleCode"
                                           readonly />
                                </div>
                                <div class="session-readonly-field">
                                    <label for="session-module-name">Module Name</label>
                                    <input id="session-module-name"
                                           type="text"
                                           value="@Model.Session.ProgrammeModule.ModuleName"
                                           readonly />
                                </div>
                            </div>

                            <section class="session-summary-panel" aria-labelledby="session-summary-title">
                                <label id="session-summary-title" for="session-summary">Booking Summary</label>
                                <textarea id="session-summary"
                                          rows="5"
                                          readonly>@(string.IsNullOrWhiteSpace(Model.Session.Summary) ? "The student did not add a booking summary." : Model.Session.Summary)</textarea>
                            </section>

                            <section class="session-attachments" aria-labelledby="session-attachments-title">
                                <h3 id="session-attachments-title">Attachments</h3>
                                @if (!hasAttachedLinks && !hasAttachedDocuments)
                                {
                                    <p class="session-no-attachments">No links or documents were attached.</p>
                                }
                                else
                                {
                                <div class="session-attachments-grid @(!hasAttachedLinks || !hasAttachedDocuments ? "single-column" : null)">
                                    @if (hasAttachedLinks)
                                    {
                                        <div class="session-material-list">
                                        @foreach (var link in Model.Session.PreparationLinks.OrderBy(item => item.Position))
                                        {
                                            <div class="session-readonly-row">
                                                <input type="url" value="@link.Url" aria-label="Preparation link" readonly />
                                                <a href="@link.Url" target="_blank" rel="noopener noreferrer" aria-label="Open preparation link">
                                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                                                        <path d="M0 0h24v24H0z" fill="none" />
                                                        <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M5.576 13.481a3.5 3.5 0 0 0 4.95 4.95m2.473-7.423a3.5 3.5 0 0 1 0 4.95l-2.475 2.475m-2.475-7.425l-2.475 2.475m12.857-2.957a3.5 3.5 0 1 0-4.95-4.95M11.01 13a3.5 3.5 0 0 1 0-4.95l2.474-2.475M15.958 13l2.475-2.475" />
                                                    </svg>
                                                </a>
                                            </div>
                                        }
                                        </div>
                                    }

                                    @if (hasAttachedDocuments)
                                    {
                                        <div class="session-material-list">
                                            @foreach (var document in Model.Session.Documents.OrderBy(item => item.Position))
                                            {
                                                <div class="session-readonly-row">
                                                    <input type="text" value="@document.OriginalFileName (@SessionDetailsModel.FormatFileSize(document.SizeBytes))" aria-label="Uploaded document" readonly />
                                                    <span class="session-material-actions">
                                                        <a asp-page="/Tutors/SessionDetails" asp-page-handler="Document" asp-route-bookingId="@Model.Session.BookingId" asp-route-documentId="@document.BookingDocumentId" aria-label="Download @document.OriginalFileName">
                                                            <i class="bi bi-download" aria-hidden="true"></i>
                                                        </a>
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                                }
                            </section>

                            <div class="session-status-card session-information-status-control"
                                 data-session-status-control>
                                <label for="session-status-action">Change Session Status</label>
                                <select id="session-status-action" data-session-status-select
                                        data-system-dropdown
                                        disabled="@(Model.Session.Status is not (BC_CampusLearn.Models.Entities.BookingStatus.Pending or BC_CampusLearn.Models.Entities.BookingStatus.Confirmed))">
                                    <option value="">@Model.Session.Status.ToDisplayText()</option>
                                    @if (Model.Session.Status == BC_CampusLearn.Models.Entities.BookingStatus.Pending)
                                    {
                                        <option value="confirm">Confirmed</option>
                                        <option value="decline">Declined</option>
                                    }
                                    else if (Model.Session.Status == BC_CampusLearn.Models.Entities.BookingStatus.Confirmed)
                                    {
                                        <option value="cancel">Cancelled</option>
                                    }
                                </select>

                                @if (Model.Session.Status is BC_CampusLearn.Models.Entities.BookingStatus.Pending or
                                    BC_CampusLearn.Models.Entities.BookingStatus.Confirmed)
                                {
                                    <button type="button" class="session-status-save" data-session-status-save>
                                        Save
                                    </button>
                                }

                                <form method="post" asp-page-handler="Decline" data-session-decline-form hidden>
                                    <input type="hidden" name="bookingId" value="@Model.Session.BookingId" />
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

        </div>

        @if (!string.IsNullOrWhiteSpace(Model.LatestStatusReason) ||
             hasSessionCountdown ||
             isCompletedSession)
        {
        <aside class="manage-session-sidebar session-top-sidebar @(hasSessionCountdown ? "has-session-countdown" : null)" aria-label="Session status">
            @if (!string.IsNullOrWhiteSpace(Model.LatestStatusReason))
            {
                <section class="session-status-reason">
                    <div class="session-status-warning @(Model.LatestStatusReasonIsUnreviewedWarning ? "is-unreviewed" : null)" role="alert">
                        <span class="session-status-warning-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24">
                                <path d="M12 7v6" />
                                <path d="M12 17h.01" />
                            </svg>
                        </span>
                        @if (!string.IsNullOrWhiteSpace(Model.LatestStatusReasonTitle))
                        {
                            <h2>@Model.LatestStatusReasonTitle</h2>
                        }
                        <p>@Model.LatestStatusReason</p>
                    </div>
                </section>
            }

            @if (hasSessionCountdown)
            {
                <section class="completed-session-countdown" aria-labelledby="completed-countdown-title">
                    <div class="completed-session-countdown-heading">
                        <h2 id="completed-countdown-title">Session Countdown</h2>
                    </div>
                    <div class="manage-session-card session-countdown-card"
                         data-session-runtime
                         data-countdown-target="@(Model.Session.SessionExecution?.ExpectedCompletionAt.ToString("O") ?? Model.Session.ScheduledStartTime.ToString("O"))"
                         data-countdown-duration-seconds="@((int)BC_CampusLearn.Services.Sessions.SessionSchedulingRules.TriggeredCountdownLength.TotalSeconds)"
                         data-countdown-mode="@(Model.Session.SessionExecution is null ? "idle" : "session-completion")">
                        <p class="session-countdown-caption">
                            @(Model.Session.Status == BC_CampusLearn.Models.Entities.BookingStatus.InProgress
                                ? "Time remaining"
                                : "Session duration")
                        </p>
                        <div class="session-countdown-timer-row">
                            <output class="session-clock" data-session-runtime-countdown>
                                <span><strong><span data-session-hours>01</span></strong><small>Hour</small></span>
                                <span><strong><span data-session-minutes>05</span></strong><small>minutes</small></span>
                                <span><strong><span data-session-seconds>59</span></strong><small>Seconds</small></span>
                            </output>
                        </div>

                        <div class="session-countdown-actions">
                            <form method="post" asp-page-handler="Start" class="session-countdown-start">
                                <input type="hidden" name="bookingId" value="@Model.Session.BookingId" />
                                <button type="submit"
                                        aria-label="Start session"
                                        data-session-start-trigger
                                        disabled="@(Model.Session.Status != BC_CampusLearn.Models.Entities.BookingStatus.Confirmed || !Model.CanStartSession)">
                                    <i class="bi bi-play-fill" aria-hidden="true"></i>
                                </button>
                            </form>

                            @if (Model.Session.Status is BC_CampusLearn.Models.Entities.BookingStatus.Confirmed or
                                 BC_CampusLearn.Models.Entities.BookingStatus.InProgress)
                            {
                                <form method="post" asp-page-handler="Join" class="session-countdown-join"
                                      data-session-join-form
                                      target="_blank" rel="noopener noreferrer">
                                    <input type="hidden" name="bookingId" value="@Model.Session.BookingId" />
                                    <button type="submit"
                                            class="session-join-button"
                                            data-session-start-trigger
                                            data-session-join-trigger
                                            data-meeting-link-available="@(!string.IsNullOrWhiteSpace(Model.Session.MeetingLink?.Url) ? "true" : "false")"
                                            disabled="@(string.IsNullOrWhiteSpace(Model.Session.MeetingLink?.Url) || (Model.Session.Status == BC_CampusLearn.Models.Entities.BookingStatus.Confirmed && !Model.CanStartSession))">
                                        <i class="bi bi-microsoft-teams" aria-hidden="true"></i>
                                        Join Meeting
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </section>
            }

                @if (isCompletedSession)
                {
                    bool studentReviewCompleted =
                        Model.Session.StudentEvaluation is not null;
                    bool tutorReviewCompleted =
                        Model.Session.TutorEvaluation is not null;

                    <section class="completed-session-reviews"
                             aria-labelledby="completed-session-reviews-title">
                        <div class="completed-session-reviews-heading">
                            <h2 id="completed-session-reviews-title">
                                Review status
                            </h2>
                        </div>
                        <div class="manage-session-card session-review-status-card">
                            <div class="review-status-row @(studentReviewCompleted ? "is-completed" : "is-pending")"
                                 role="status"
                                 aria-label="Student review @(studentReviewCompleted ? "completed" : "not completed")">
                                <span class="review-status-check"
                                      aria-hidden="true"></span>
                                <span class="review-status-label">
                                    Student review
                                </span>
                                <strong>
                                    @(studentReviewCompleted
                                        ? "Completed"
                                        : "Not completed")
                                </strong>
                            </div>
                            @if (tutorReviewCompleted)
                            {
                                <div class="review-status-row is-completed"
                                     role="status"
                                     aria-label="Tutor review completed">
                                    <span class="review-status-check"
                                          aria-hidden="true"></span>
                                    <span class="review-status-label">
                                        Tutor review
                                    </span>
                                    <strong>Completed</strong>
                                </div>
                            }
                            else
                            {
                                <button type="button"
                                        class="review-status-row is-pending is-action"
                                        data-bs-toggle="modal"
                                        data-bs-target="#review-session-modal"
                                        aria-label="Complete tutor review">
                                    <span class="review-status-check"
                                          aria-hidden="true"></span>
                                    <span class="review-status-label">
                                        Tutor review
                                    </span>
                                    <strong>Not completed</strong>
                                </button>
                            }
                        </div>
                    </section>
                }
        </aside>
        }
    </div>

    <div class="manage-session-layout session-lower-layout">
        <div class="manage-session-primary">

            <section class="manage-session-card session-chat" aria-labelledby="communication-title"
                     data-session-chat
                     data-booking-id="@Model.Session.BookingId"
                     data-current-user-id="@Model.CurrentBcUserId">
                <header class="communication-placeholder-heading session-chat-recipient-header">
                    <span class="communication-avatar" aria-hidden="true">
                        <span>@studentInitials</span>
                    </span>
                    <h2 id="communication-title">@Model.Session.StudentName</h2>
                </header>
                <div class="session-chat-messages" data-session-chat-messages aria-live="polite">
                    @{
                        DateOnly? lastMessageDate = null;
                        DateOnly today = DateOnly.FromDateTime(
                            DateTimeOffset.UtcNow.ToOffset(TimeSpan.FromHours(2)).DateTime);
                    }
                    @foreach (var message in Model.Session.SessionMessages
                        .Where(item => item.DeletedAt == null)
                        .OrderBy(item => item.SentAt))
                    {
                        DateTimeOffset localSentAt = message.SentAt.ToOffset(TimeSpan.FromHours(2));
                        DateOnly messageDate = DateOnly.FromDateTime(localSentAt.DateTime);
                        if (messageDate != lastMessageDate)
                        {
                            string dateLabel = messageDate == today
                                ? "Today"
                                : messageDate == today.AddDays(-1)
                                    ? "Yesterday"
                                    : localSentAt.ToString("ddd, dd MMM");
                            <div class="session-chat-date-separator" data-message-date-separator="@messageDate.ToString("yyyy-MM-dd")">
                                <span>@dateLabel</span>
                            </div>
                            lastMessageDate = messageDate;
                        }
                        bool isMine = message.SenderBcUserId == Model.CurrentBcUserId;
                        <article id="message-@message.SessionMessageId"
                                 data-message-date="@messageDate.ToString("yyyy-MM-dd")"
                                 class="session-chat-message @(isMine ? "is-mine" : null)">
                            <p>@message.MessageText</p>
                            <span class="session-chat-message-meta">
                                <time datetime="@message.SentAt.ToString("O")">@localSentAt.ToString("HH:mm")</time>
                                @if (isMine)
                                {
                                    <span class="session-message-read-receipt @(message.ReadAt.HasValue ? "is-read" : null)"
                                          aria-label="@(message.ReadAt.HasValue ? "Read" : "Sent")"
                                          title="@(message.ReadAt.HasValue ? "Read" : "Sent")"
                                          data-message-read-receipt>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M0 0h24v24H0z" fill="none" />
                                            <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.5 13.833L6 17.5l1.024-1.073M16.5 6.5l-6.063 6.352m-2.937.981L11 17.5l10.5-11" />
                                        </svg>
                                    </span>
                                }
                            </span>
                        </article>
                    }
                    <div class="session-typing-indicator"
                         data-session-typing-indicator
                         aria-label="@Model.Session.StudentName is typing"
                         role="status"
                         hidden>
                        <span></span><span></span><span></span>
                    </div>
                </div>
                @if (chatIsClosed)
                {
                    <p class="session-chat-closed">Messaging is closed for this session.</p>
                }
                else
                {
                    <form class="session-chat-form" data-session-chat-form>
                        <label class="visually-hidden" for="session-chat-message">Message</label>
                        <div class="session-chat-composer">
                            <textarea id="session-chat-message"
                                      rows="1"
                                      maxlength="2000"
                                      autocomplete="off"
                                      placeholder="Write a message..."
                                      data-session-chat-input></textarea>
                            <span class="session-chat-emoji-control">
                                <button type="button"
                                        class="session-chat-emoji-toggle"
                                        data-session-emoji-toggle
                                        aria-expanded="false"
                                        aria-controls="session-emoji-picker"
                                        aria-label="Add emoji"
                                        title="Add emoji">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M0 0h24v24H0z" fill="none" />
                                        <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5">
                                            <circle cx="12" cy="12" r="10" />
                                            <path d="M8 15a5 5 0 0 0 4 2a5 5 0 0 0 4-2m-.375-6.613v.53m-7.25-.53v.53m.375-.167c0-.414-.168-.75-.375-.75S8 8.336 8 8.75s.168.75.375.75s.375-.336.375-.75m7.25 0c0-.414-.168-.75-.375-.75s-.375.336-.375.75s.168.75.375.75s.375-.336.375-.75" />
                                        </g>
                                    </svg>
                                </button>
                                <span id="session-emoji-picker"
                                      class="session-emoji-picker"
                                      data-session-emoji-picker
                                      aria-label="Choose an emoji"
                                      hidden>
                                    @foreach (string emoji in new[] { "😀", "😂", "😊", "👍", "🙏", "👏", "🎉", "❤️", "🤔", "✅", "📚", "💡" })
                                    {
                                        <button type="button" data-session-emoji="@emoji" aria-label="Add @emoji">@emoji</button>
                                    }
                                </span>
                            </span>
                            <button type="submit" class="session-chat-send-button" aria-label="Send message">
                                <i class="bi bi-arrow-up" aria-hidden="true"></i>
                                <span>Send</span>
                            </button>
                        </div>
                    </form>
                }
                <p class="session-chat-error" data-session-chat-error role="alert" hidden></p>
            </section>
        </div>

    </div>
</main>

<div class="modal fade meeting-link-modal"
     id="meeting-link-modal"
     tabindex="-1"
     aria-labelledby="meeting-link-modal-title"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post"
                  asp-page-handler="@(Model.Session.Status == BC_CampusLearn.Models.Entities.BookingStatus.Pending ? "Confirm" : "SaveMeetingLink")"
                  novalidate>
                <input type="hidden"
                       name="bookingId"
                       value="@Model.Session.BookingId" />
                <div class="modal-header">
                    <div>
                        <h2 class="modal-title" id="meeting-link-modal-title">
                            @(Model.Session.Status == BC_CampusLearn.Models.Entities.BookingStatus.Pending
                                ? "Confirm session"
                                : "Edit meeting link")
                        </h2>
                        <p>Paste the link students will use to join this session.</p>
                    </div>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (Model.MeetingLinkError &&
                         !string.IsNullOrWhiteSpace(Model.MeetingLinkMessage))
                    {
                        <div class="meeting-link-modal-error" role="alert">
                            <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                            @Model.MeetingLinkMessage
                        </div>
                    }
                    <label asp-for="MeetingLink">Meeting link</label>
                    <div class="meeting-link-entry">
                        <i class="bi bi-link-45deg" aria-hidden="true"></i>
                        <input asp-for="MeetingLink"
                               type="url"
                               maxlength="2048"
                               placeholder="https://teams.microsoft.com/..."
                               autocomplete="url" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button"
                            class="meeting-link-modal-cancel"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="meeting-link-modal-save">
                        @(Model.Session.Status == BC_CampusLearn.Models.Entities.BookingStatus.Pending
                            ? "Confirm session"
                            : "Save meeting link")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade meeting-link-modal" id="decline-session-modal" tabindex="-1"
     aria-labelledby="decline-session-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Cancel">
                <input type="hidden" name="bookingId" value="@Model.Session.BookingId" />
                <div class="modal-header">
                    <div><h2 id="decline-session-title">Cancel session</h2><p>Tell the student why this confirmed session is being cancelled.</p></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <label asp-for="DeclineReason">Reason</label>
                    <textarea asp-for="DeclineReason" rows="4" minlength="5" maxlength="1000" required></textarea>
                    <label class="session-checkbox">
                        <input asp-for="ReopenAvailability" />
                        Reopen this time as availability if it does not conflict
                    </label>
                </div>
                <div class="modal-footer">
                    <button type="button" class="meeting-link-modal-cancel" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="meeting-link-modal-save">Cancel session</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade meeting-link-modal" id="review-session-modal" tabindex="-1"
     data-open-on-load="@Model.OpenReviewPanel.ToString().ToLowerInvariant()"
     aria-labelledby="review-session-title" aria-hidden="true">
    <div class="modal-dialog tutor-evaluation-modal">
        <div class="modal-content">
            <form method="post" asp-page-handler="Review" novalidate data-tutor-evaluation-form>
                <input type="hidden" name="bookingId" value="@Model.Session.BookingId" />
                <div class="modal-header">
                    <div><h2 id="review-session-title">Evaluate @Model.Session.StudentName</h2></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body tutor-evaluation-form">
                    <fieldset class="evaluation-question" data-evaluation-required>
                        <legend>1. Was the session planned in advance? <span aria-hidden="true">*</span></legend>
                        <div class="evaluation-radio-group">
                            <label><input asp-for="EvaluationInput.SessionPlan" id="session-plan-yes" type="radio" value="true" /> <span>Yes</span></label>
                            <label><input asp-for="EvaluationInput.SessionPlan" id="session-plan-no" type="radio" value="false" /> <span>No</span></label>
                        </div>
                    </fieldset>
                    <fieldset class="evaluation-question" data-evaluation-required>
                        <legend>2. Did the student provide information beforehand? <span aria-hidden="true">*</span></legend>
                        <div class="evaluation-radio-group">
                            <label><input asp-for="EvaluationInput.StudentPreparationInfo" id="preparation-info-yes" type="radio" value="true" /> <span>Yes</span></label>
                            <label><input asp-for="EvaluationInput.StudentPreparationInfo" id="preparation-info-no" type="radio" value="false" /> <span>No</span></label>
                        </div>
                    </fieldset>
                    <fieldset class="evaluation-question" data-evaluation-required>
                        <legend>3. Was the student punctual? <span aria-hidden="true">*</span></legend>
                        <div class="evaluation-radio-group">
                            <label><input asp-for="EvaluationInput.StudentPunctuality" id="student-punctuality-yes" type="radio" value="true" /> <span>Yes</span></label>
                            <label><input asp-for="EvaluationInput.StudentPunctuality" id="student-punctuality-no" type="radio" value="false" /> <span>No</span></label>
                        </div>
                    </fieldset>
                    <fieldset class="evaluation-question" data-evaluation-required>
                        <legend>4. Was the student prepared? <span aria-hidden="true">*</span></legend>
                        <div class="evaluation-radio-group">
                            <label><input asp-for="EvaluationInput.StudentPrepared" id="student-prepared-yes" type="radio" value="true" /> <span>Yes</span></label>
                            <label><input asp-for="EvaluationInput.StudentPrepared" id="student-prepared-no" type="radio" value="false" /> <span>No</span></label>
                        </div>
                    </fieldset>
                    <div class="evaluation-question" data-evaluation-required>
                        <label asp-for="EvaluationInput.PreviousHomework">5. If homework was given in the previous session, was it completed?</label>
                        <textarea asp-for="EvaluationInput.PreviousHomework" rows="2" maxlength="250"></textarea>
                    </div>
                    <div class="evaluation-question">
                        <label asp-for="EvaluationInput.StudentInteract">6. Did the student interact when encouraged? <span aria-hidden="true">*</span></label>
                        <textarea asp-for="EvaluationInput.StudentInteract" rows="2" maxlength="250"></textarea>
                    </div>
                    <div class="evaluation-question" data-evaluation-required>
                        <label asp-for="EvaluationInput.StudentFocus">7. Was the student engaged and focused throughout the session? <span aria-hidden="true">*</span></label>
                        <textarea asp-for="EvaluationInput.StudentFocus" rows="2" maxlength="250"></textarea>
                    </div>
                    <div class="evaluation-question" data-evaluation-required>
                        <label asp-for="EvaluationInput.StudentIssues">8. Did any conflict or issues arise between you and the student? <span aria-hidden="true">*</span></label>
                        <textarea asp-for="EvaluationInput.StudentIssues" rows="2" maxlength="250" placeholder="Enter None if no issues occurred"></textarea>
                    </div>
                    <div class="evaluation-question" data-evaluation-required>
                        <label asp-for="EvaluationInput.TutorComments">9. Comments <span aria-hidden="true">*</span></label>
                        <textarea asp-for="EvaluationInput.TutorComments" rows="4"></textarea>
                    </div>
                    <div class="evaluation-question" data-evaluation-required data-evaluation-url>
                        <label asp-for="EvaluationInput.RecordingLink">10. Recording link for the meeting <span aria-hidden="true">*</span></label>
                        <input asp-for="EvaluationInput.RecordingLink" type="text" inputmode="url" maxlength="2048" placeholder="https://..." />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="meeting-link-modal-cancel" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="meeting-link-modal-save">Submit evaluation</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/components/navigation-drawer.js" asp-append-version="true"></script>
    <script src="~/js/components/system-dropdown.js" asp-append-version="true"></script>
    <script src="~/js/tutor-session-details.js" asp-append-version="true"></script>
    @if (Model.MeetingLinkError)
    {
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const modalElement = document.getElementById("meeting-link-modal");
                if (modalElement && window.bootstrap) {
                    bootstrap.Modal.getOrCreateInstance(modalElement).show();
                }
            });
        </script>
    }
}
