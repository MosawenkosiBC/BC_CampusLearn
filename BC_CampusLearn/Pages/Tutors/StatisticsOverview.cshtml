@page
@model BC_CampusLearn.Pages.Tutors.StatisticsOverviewModel

@{
    ViewData["Title"] = "Statistics Overview";
    string moduleLabels = System.Text.Json.JsonSerializer.Serialize(
        Model.Statistics.TopModules.Select(item => item.ModuleCode));
    string moduleCompletedValues = System.Text.Json.JsonSerializer.Serialize(
        Model.Statistics.TopModules.Select(item => item.SessionCount));
    string averageStudentRating = Model.Statistics.AverageStudentReviewRating
        .ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
    string studentRatingWidth = Math.Clamp(
            Model.Statistics.AverageStudentReviewRating * 20m,
            0m,
            100m)
        .ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/components/navigation-drawer.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/tutor-profile.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/tutor-statistics.css"
          asp-append-version="true" />
}

@await Html.PartialAsync(
    "~/Pages/Shared/Components/NavigationDrawer/_NavigationDrawer.cshtml")

<section class="tutor-profile-page tutor-statistics-page py-4">
    <h1 class="tutor-manage-profile-title">Manage Account</h1>

    @if (TempData["ProfileImageError"] is string imageError)
    {
        @await Html.PartialAsync("_CampusAlert",
            new CampusAlertViewModel(
                imageError,
                CampusAlertVariant.Danger))
    }
    <div class="tutor-profile-mobile-card">
    <aside class="tutor-profile-card" aria-label="Tutor account navigation">
        <div class="tutor-profile-identity">
            <div class="tutor-profile-photo-wrap">
                @if (!string.IsNullOrWhiteSpace(Model.ProfileImagePath))
                {
                    <img class="tutor-profile-photo"
                         src="@Model.ProfileImagePath"
                         alt="Profile photo of @Model.DisplayName" />
                }
                else
                {
                    <div class="tutor-profile-photo tutor-profile-initials"
                         aria-label="@Model.DisplayName initials">
                        @Model.Initials
                    </div>
                }

                <form method="post"
                      enctype="multipart/form-data"
                      asp-page="/Tutors/Profile"
                      asp-page-handler="UploadProfileImage"
                      class="tutor-profile-photo-form">
                    <input type="hidden"
                           name="returnPage"
                           value="/Tutors/StatisticsOverview" />
                    <label class="tutor-profile-camera"
                           for="tutor-statistics-profile-image"
                           title="Add profile image">
                        <svg xmlns="http://www.w3.org/2000/svg"
                             viewBox="0 0 24 24"
                             aria-hidden="true">
                            <path d="M9 4.5 7.7 6H5a3 3 0 0 0-3 3v8a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3V9a3 3 0 0 0-3-3h-2.7L15 4.5zm3 13a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9m0-2a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5" />
                        </svg>
                        <span class="visually-hidden">Add profile image</span>
                    </label>
                    <input id="tutor-statistics-profile-image"
                           name="ProfileImage"
                           class="visually-hidden"
                           type="file"
                           accept="image/jpeg,image/png,image/webp"
                           onchange="this.form.submit()" />
                </form>
            </div>

            <h1>@Model.DisplayName</h1>
            <p>@Model.StudentNumber</p>
        </div>

        <div class="tutor-profile-divider"></div>

        <nav class="tutor-profile-nav" aria-label="Tutor profile sections">
            <a asp-page="/Tutors/Profile" class="tutor-profile-nav-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M0 0h24v24H0z" fill="none" />
                    <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5">
                        <circle cx="10" cy="7" r="4" />
                        <path d="M11 14.035A14 14 0 0 0 10 14c-5 0-8 2.5-8 5a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2q0-.504-.16-1m3.849-9.066l-.623-.623a1.063 1.063 0 0 0-1.503 0l-3.349 3.35a3.2 3.2 0 0 0-.872 1.629L15 15l1.71-.342a3.2 3.2 0 0 0 1.63-.872l3.349-3.349a1.063 1.063 0 0 0 0-1.503" />
                    </g>
                </svg>
                <span>Personal Details</span>
            </a>
            <a asp-page="/Tutors/PublicProfile" class="tutor-profile-nav-link">
                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M0 0h24v24H0z" fill="none" />
                    <g fill="none" stroke="currentColor" stroke-width="1.5">
                        <circle cx="12" cy="12" r="10" />
                        <ellipse cx="12" cy="12" rx="4" ry="10" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2 12h20" />
                    </g>
                </svg>
                <span>Public Profile</span>
            </a>
            <a asp-page="/Tutors/StatisticsOverview"
               class="tutor-profile-nav-link is-active"
               aria-current="page">
                <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M0 0h24v24H0z" fill="none" />
                    <path fill="currentColor"
                          d="M7 21H3v-8h4zm7 0h-4V3h4zm7-13v13h-4V8z" />
                </svg>
                <span>Statistics Overview</span>
            </a>
        </nav>
    </aside>

    <div class="tutor-statistics-content">
        <header class="tutor-statistics-header">
            <div>
                <h2>Statistics Overview</h2>
                <p>Performance based on your recorded tutoring sessions.</p>
            </div>
            <form method="get"
                  class="tutor-statistics-range"
                  data-statistics-period-form
                  data-current-period="@Model.Range">
                <div class="tutor-statistics-range-field">
                    <label for="statistics-range">Period</label>
                    <select id="statistics-range"
                            asp-for="Range"
                            data-statistics-period>
                        <option value="daily">Daily</option>
                        <option value="weekly">Weekly</option>
                        <option value="monthly">Monthly</option>
                        <option value="custom">Customize dates</option>
                    </select>
                </div>
                @if (Model.Range == "custom")
                {
                    <button type="button"
                            class="tutor-statistics-edit-dates"
                            data-statistics-edit-dates>
                        Edit dates
                    </button>
                }
            </form>
        </header>

        <div class="tutor-statistics-summary">
            <article class="tutor-stat-card-premium is-magenta">
                <span class="tutor-stat-card-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M8 2v3m8-3v3M4 9h16M5 4h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm3 9h3v3H8Z" /></svg>
                </span>
                <div>
                    <p>Completed sessions</p>
                    <strong>@Model.Statistics.CompletedSessions</strong>
                </div>
            </article>
            <article class="tutor-stat-card-premium is-teal">
                <span class="tutor-stat-card-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m7-10a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm13 10v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></svg>
                </span>
                <div>
                    <p>Students helped</p>
                    <strong>@Model.Statistics.UniqueStudents</strong>
                </div>
            </article>
            <article class="tutor-stat-card-premium is-charcoal">
                <span class="tutor-stat-card-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
                </span>
                <div>
                    <p>Tutoring hours</p>
                    <strong>@Model.Statistics.TutoringHours</strong>
                </div>
            </article>
            <article class="tutor-stat-card-premium is-green">
                <span class="tutor-stat-card-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M4 14l5-5 4 4 7-8" /><path d="M15 5h5v5" /></svg>
                </span>
                <div>
                    <p>Completion rate</p>
                    <strong>@Model.Statistics.CompletionRate.ToString("0.#")%</strong>
                </div>
            </article>
        </div>

        <div class="tutor-statistics-primary-grid">
            <div class="tutor-statistics-panel-group">
                <h3 class="tutor-statistics-section-title">Top completed modules</h3>
                <section class="tutor-statistics-panel tutor-statistics-trend-panel">
                    <div class="tutor-statistics-chart-wrap">
                        <canvas data-tutor-module-chart
                                data-labels="@moduleLabels"
                                data-completed-values="@moduleCompletedValues"
                                aria-label="Completed sessions across the top five modules chart">
                            Completed session counts across the top five modules.
                        </canvas>
                    </div>
                </section>
            </div>

            <div class="tutor-statistics-panel-group">
                <h3 class="tutor-statistics-section-title">Session status</h3>
                <section class="tutor-statistics-panel tutor-statistics-status-panel">
                    <dl class="tutor-session-status-stats">
                        <div>
                            <dt>Total sessions completed</dt>
                            <dd>@Model.Statistics.CompletedSessions</dd>
                        </div>
                        <div>
                            <dt>Pending student review</dt>
                            <dd>@Model.Statistics.PendingStudentReviews</dd>
                        </div>
                        <div>
                            <dt>Pending tutor review</dt>
                            <dd>@Model.Statistics.PendingTutorReviews</dd>
                        </div>
                        <div class="tutor-session-status-divider" role="presentation"></div>
                        <div class="tutor-session-rating-row">
                            <dt>Average student review rating</dt>
                            <dd class="tutor-session-rating">
                                <span class="tutor-session-rating-stars"
                                      role="img"
                                      aria-label="@averageStudentRating out of 5 stars"
                                      style="--rating-width: @studentRatingWidth%">
                                    <span aria-hidden="true">★★★★★</span>
                                </span>
                                <span class="tutor-session-rating-number">
                                    <strong>@averageStudentRating</strong><span>/5</span>
                                </span>
                            </dd>
                        </div>
                    </dl>
                </section>
            </div>
        </div>

        <partial name="_TutorSupportPanel" />
    </div>
    </div>
</section>

<div class="modal fade tutor-account-modal"
     id="statistics-custom-date-modal"
     tabindex="-1"
     aria-labelledby="statistics-custom-date-title"
     aria-hidden="true"
     data-open-on-load="@((!string.IsNullOrWhiteSpace(Model.DateRangeError)).ToString().ToLowerInvariant())">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="get" class="tutor-statistics-date-form">
                <input type="hidden" name="Range" value="custom" />
                <div class="modal-header">
                    <div>
                        <h2 class="modal-title" id="statistics-custom-date-title">
                            Customize dates
                        </h2>
                        <p>Choose the period to include in your statistics.</p>
                    </div>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="tutor-statistics-modal-dates">
                        <label class="tutor-statistics-date-field">
                            <span>From</span>
                            <input asp-for="StartDate" type="date" required />
                        </label>
                        <label class="tutor-statistics-date-field">
                            <span>To</span>
                            <input asp-for="EndDate" type="date" required />
                        </label>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.DateRangeError))
                    {
                        <p class="tutor-statistics-range-error" role="alert">
                            @Model.DateRangeError
                        </p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button"
                            class="tutor-modal-cancel"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="tutor-modal-primary">
                        Apply dates
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>
    <script src="~/js/components/navigation-drawer.js"
            asp-append-version="true"></script>
    <script src="~/js/tutor-statistics.js"
            asp-append-version="true"></script>
    <script src="~/js/tutor-profile.js"
            asp-append-version="true"></script>
}
