@page
@model BC_CampusLearn.Pages.Tutors.IndexModel

@{
    ViewData["Title"] = "All Tutors";
    bool hasActiveFilters =
        !string.IsNullOrWhiteSpace(Model.SearchName) ||
        !string.IsNullOrWhiteSpace(Model.SearchModule) ||
        Model.ProgrammeId.HasValue ||
        Model.ProgrammeModuleId.HasValue ||
        Model.TutoringMode.HasValue ||
        !string.IsNullOrWhiteSpace(Model.Campus);
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/components/navigation-drawer.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/tutors.css"
          asp-append-version="true" />
}

@await Html.PartialAsync(
    "~/Pages/Shared/Components/NavigationDrawer/_NavigationDrawer.cshtml")

<section class="tutors-page" aria-labelledby="tutors-page-title">
    <header class="tutors-intro">
        <h1 id="tutors-page-title">Meet Your Tutors</h1>
    </header>

    <div class="tutors-workspace">
        <aside id="tutor-filter-panel"
               class="tutor-filters"
               aria-labelledby="tutor-filter-title"
               data-filter-breakpoint="991.98"
               data-filter-panel>
            <div class="filter-heading">
                <h2 id="tutor-filter-title">Filters</h2>
                <a asp-page="/Tutors/Index">Clear all</a>
                <button type="button"
                        class="filter-modal-close"
                        data-filter-close
                        aria-label="Close filters">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 6l12 12M18 6 6 18" />
                    </svg>
                </button>
            </div>

            <form id="tutor-filter-form" method="get">
                <div class="filter-group">
                    <label asp-for="SearchName">Search by name</label>
                    <div class="filter-search">
                        <input asp-for="SearchName"
                               type="search"
                               autocomplete="off" />
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" />
                        </svg>
                    </div>
                </div>

                <div class="filter-group">
                    <label asp-for="SearchModule">Search by module</label>
                    <div class="filter-search">
                        <input asp-for="SearchModule"
                               type="search"
                               autocomplete="off" />
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" />
                        </svg>
                    </div>
                </div>

                <div class="filter-group course-filter">
                    <label asp-for="ProgrammeId">Filter by course</label>
                    <select asp-for="ProgrammeId"
                            asp-items="Model.ProgrammeOptions">
                        <option value="">All courses</option>
                    </select>
                </div>

                <div class="filter-group tutoring-mode-filter">
                    <label asp-for="TutoringMode">Tutoring mode</label>
                    <select asp-for="TutoringMode"
                            asp-items="Html.GetEnumSelectList<PreferredTutoringMode>()">
                        <option value="">All tutoring modes</option>
                    </select>
                </div>

                <button type="submit" class="apply-filters">
                    Apply filters
                </button>
            </form>
        </aside>
        <button type="button"
                class="tutor-filter-backdrop"
                data-filter-close
                aria-label="Close filters"></button>

        <div class="tutor-results">
            <div class="results-toolbar">
                <div class="results-count">
                    Showing <strong>@Model.Tutors.Count</strong> tutors
                </div>
                <button type="button"
                        class="mobile-filter-trigger @(hasActiveFilters ? "has-active-filters" : null)"
                        data-filter-open
                        aria-controls="tutor-filter-panel"
                        aria-expanded="false">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M0 0h24v24H0z" fill="none" />
                        @if (hasActiveFilters)
                        {
                            <path fill="currentColor"
                                  d="M4.38 3.22A1 1 0 0 1 5 3h14a1 1 0 0 1 .79 1.62L15 10.75v9.13c.04.3-.06.62-.29.83a.996.996 0 0 1-1.41 0l-4.01-4.01a.99.99 0 0 1-.29-.83v-5.12L4.21 4.62a1 1 0 0 1 .17-1.4Z" />
                        }
                        else
                        {
                            <path fill="currentColor"
                                  d="M4.38 3.22A1 1 0 0 1 5 3h14a1 1 0 0 1 .79 1.62L15 10.75v9.13c.04.3-.06.62-.29.83a.996.996 0 0 1-1.41 0l-4.01-4.01a.99.99 0 0 1-.29-.83v-5.12L4.21 4.62a1 1 0 0 1 .17-1.4Z" />
                        }
                    </svg>
                    <span>Filter</span>
                </button>
                <select asp-for="Campus"
                        asp-items="Model.CampusOptions"
                        class="campus-select"
                        form="tutor-filter-form"
                        aria-label="Filter tutors by campus"
                        onchange="this.form.submit()">
                    <option value="">All campuses</option>
                </select>
            </div>

            @if (Model.Tutors.Count == 0)
            {
                <div class="empty-tutors">
                    <span aria-hidden="true">⌕</span>
                    <h2>No tutors match those filters</h2>
                    <p>Try clearing a filter or searching for another module.</p>
                    <a asp-page="/Tutors/Index">Clear all filters</a>
                </div>
            }
            else
            {
                <div class="tutor-grid">
                    @foreach (var tutor in Model.Tutors)
                    {
                        string tutoringModeLabel =
                            tutor.PreferredTutoringMode switch
                        {
                            PreferredTutoringMode.FaceToFace =>
                                "Face-to-face",
                            PreferredTutoringMode.Online =>
                                "Online",
                            PreferredTutoringMode.Both =>
                                "Face-to-face & online",
                            _ => "Tutoring mode unavailable"
                        };

                        <article class="tutor-card">
                            <a asp-page="/Tutors/Details"
                               asp-route-id="@tutor.TutorId"
                               class="tutor-card-link"
                               aria-label="View @tutor.DisplayName's profile">
                                <div class="tutor-image-wrap">
                                    @if (!string.IsNullOrWhiteSpace(
                                        tutor.ProfileImagePath))
                                    {
                                        <img src="@tutor.ProfileImagePath"
                                             alt="Profile photo of @tutor.DisplayName"
                                             loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="tutor-card-initials"
                                              aria-label="@tutor.DisplayName initials">
                                            @tutor.Initials
                                        </span>
                                    }
                                </div>

                                <div class="tutor-card-body">
                                    <h2>@tutor.DisplayName</h2>
                                    <div class="tutor-academic-meta">
                                        <p class="tutor-programme">@tutor.ProgrammeName</p>
                                        <p class="tutor-mode">@tutoringModeLabel</p>
                                    </div>

                                    <div class="module-tags" aria-label="Modules taught">
                                        @foreach (string code in tutor.ModuleCodes.Take(3))
                                        {
                                            <span>@code</span>
                                        }
                                        @if (tutor.ModuleCodes.Count > 3)
                                        {
                                            <span>+@(tutor.ModuleCodes.Count - 3)</span>
                                        }
                                    </div>
                                </div>
                            </a>
                        </article>
                    }
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/components/navigation-drawer.js"
            asp-append-version="true"></script>
    <script src="~/js/tutors.js"
            asp-append-version="true"></script>
}
