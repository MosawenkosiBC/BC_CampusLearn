@page
@model BC_CampusLearn.Pages.Bookings.CreateModel

@{
    ViewData["Title"] = "Book session";
}

<section class="container py-4"
         style="max-width: 720px;">

    <h1>Confirm your booking</h1>

    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5">
                @Model.Preview.TutorName
            </h2>

            <p>
                @Model.Preview.AvailableTime.ToString(
                    "dddd, dd MMMM yyyy")
            </p>

            <p>
                @Model.Preview.AvailableTime.ToString("HH:mm")
            </p>
        </div>
    </div>

    <form method="post">
        <input type="hidden"
               asp-for="Input.TutorAvailabilityId" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Input.ProgrammeModuleId"
                   class="form-label"></label>

            <select asp-for="Input.ProgrammeModuleId"
                    class="form-select">
                <option value="">Select a module</option>
                @foreach (var module in Model.Preview.Modules)
                {
                    <option value="@module.ProgrammeModuleId">
                        @module.ModuleCode - @module.ModuleName
                    </option>
                }
            </select>

            <span asp-validation-for="Input.ProgrammeModuleId"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Location"
                   class="form-label"></label>

            <input asp-for="Input.Location"
                   class="form-control" />

            <span asp-validation-for="Input.Location"
                  class="text-danger"></span>
        </div>

        <p><strong>Duration:</strong> 1 hour</p>

        <div class="mb-3">
            <label asp-for="Input.Summary"
                   class="form-label"></label>

            <textarea asp-for="Input.Summary"
                      class="form-control"
                      rows="4"></textarea>

            <span asp-validation-for="Input.Summary"
                  class="text-danger"></span>
        </div>

        <fieldset class="mb-3">
            <legend class="form-label">
                Preparation links (optional, maximum 3)
            </legend>

            @for (int index = 0; index < 3; index++)
            {
                <input type="url"
                       name="Input.PreparationLinks[@index]"
                       value="@Model.Input.PreparationLinks.ElementAtOrDefault(index)"
                       class="form-control mb-2"
                       maxlength="2048"
                       placeholder="https://" />
            }
        </fieldset>

        <button type="submit"
                class="btn btn-primary">
            Confirm booking
        </button>

        <a asp-page="/Tutors/Details"
           asp-route-id="@Model.Preview.TutorId"
           class="btn btn-link">
            Cancel
        </a>
    </form>
</section>
