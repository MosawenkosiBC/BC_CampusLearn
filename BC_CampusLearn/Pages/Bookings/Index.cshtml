@page
@model BC_CampusLearn.Pages.Bookings.IndexModel

@{
    ViewData["Title"] = "My bookings";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/tutor-dashboard.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/tutors.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/components/navigation-drawer.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/bookings-index.css"
          asp-append-version="true" />
}

@await Html.PartialAsync(
    "~/Pages/Shared/Components/NavigationDrawer/_NavigationDrawer.cshtml")

<main class="container py-4 bookings-page">
    <header class="bookings-heading">
        <h1>All Sessions</h1>
    </header>

    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="alert alert-success bookings-alert" role="status">
            @message
        </div>
    }

    <div class="bookings-workspace">
        <aside id="booking-filter-panel"
               class="tutor-filters bookings-filters"
               aria-labelledby="booking-filter-title"
               data-filter-breakpoint="1199.98"
               data-filter-panel>
            <div class="filter-heading">
                <h2 id="booking-filter-title">Filters</h2>
                <a asp-page="/Bookings/Index">Clear all</a>
                <button type="button"
                        class="filter-modal-close"
                        data-filter-close
                        aria-label="Close filters">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 6l12 12M18 6 6 18" />
                    </svg>
                </button>
            </div>

            <form method="get">
                <div class="filter-group">
                    <label asp-for="TutorFilter">Search by tutor</label>
                    <div class="filter-search">
                        <input asp-for="TutorFilter"
                               type="search"
                               autocomplete="off" />
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" />
                        </svg>
                    </div>
                </div>

                <div class="filter-group">
                    <label asp-for="ModuleFilter">Search by module</label>
                    <div class="filter-search">
                        <input asp-for="ModuleFilter"
                               type="search"
                               autocomplete="off" />
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" />
                        </svg>
                    </div>
                </div>

                <div class="filter-group">
                    <label asp-for="StatusFilter">Filter by status</label>
                    <select asp-for="StatusFilter"
                            asp-items="Model.StatusOptions">
                        <option value="">All statuses</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label asp-for="DateFilter">Filter by date</label>
                    <div class="filter-search bookings-date-filter">
                        <input asp-for="DateFilter" type="date" />
                    </div>
                </div>

                <div class="filter-group">
                    <label asp-for="LocationFilter">Search by location</label>
                    <div class="filter-search">
                        <input asp-for="LocationFilter"
                               type="search"
                               autocomplete="off" />
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" />
                        </svg>
                    </div>
                </div>

                <button type="submit" class="apply-filters">
                    Apply filters
                </button>
            </form>
        </aside>
        <button type="button"
                class="tutor-filter-backdrop"
                data-filter-close
                aria-label="Close filters"></button>

        <div class="bookings-results">
            <div class="results-toolbar bookings-results-toolbar">
                <div id="all-bookings-title" class="results-count">
                    <span class="visually-hidden">All sessions. </span>
                    <strong>@Model.Bookings.Count</strong>
                    @(Model.Bookings.Count == 1 ? "session" : "sessions")
                    displayed
                </div>

                <button type="button"
                        class="mobile-filter-trigger @(Model.HasActiveFilters ? "has-active-filters" : null)"
                        data-filter-open
                        aria-controls="booking-filter-panel"
                        aria-expanded="false">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="currentColor"
                              d="M4.38 3.22A1 1 0 0 1 5 3h14a1 1 0 0 1 .79 1.62L15 10.75v9.13c.04.3-.06.62-.29.83a.996.996 0 0 1-1.41 0l-4.01-4.01a.99.99 0 0 1-.29-.83v-5.12L4.21 4.62a1 1 0 0 1 .17-1.4Z" />
                    </svg>
                    <span>Filter</span>
                </button>
            </div>

            <section class="bookings-section" aria-labelledby="all-bookings-title">
                @if (Model.Bookings.Count == 0 && Model.HasActiveFilters)
                {
                    <div class="empty-tutors bookings-empty-results">
                        <span class="bookings-empty-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24">
                                <circle cx="10.5" cy="10.5" r="6.5" />
                                <path d="m15.4 15.4 4.1 4.1" />
                            </svg>
                        </span>
                        <h2>No sessions match those filters</h2>
                        <p>
                            Try clearing a filter or searching for another session.
                        </p>
                        <a asp-page="/Bookings/Index">Clear all filters</a>
                    </div>
                }
                else
                {
                <div class="tutor-sessions">
                    <div class="tutor-sessions-table-wrap">
                        <table class="tutor-sessions-table bookings-table">
                    <thead>
                        <tr>
                            <th scope="col">
                                <a asp-page="/Bookings/Index"
                                   asp-route-TutorFilter="@Model.TutorFilter"
                                   asp-route-ModuleFilter="@Model.ModuleFilter"
                                   asp-route-DateFilter="@Model.DateFilter?.ToString("yyyy-MM-dd")"
                                   asp-route-LocationFilter="@Model.LocationFilter"
                                   asp-route-StatusFilter="@Model.StatusFilter"
                                   asp-route-SortBy="tutor"
                                   asp-route-SortDirection="@Model.GetNextSortDirection("tutor")"
                                   class="bookings-sort-link @(Model.IsSortedBy("tutor") ? "is-active" : null)">
                                    <span>Tutor Name</span>
                                    <span class="bookings-sort-arrows" aria-hidden="true">
                                        <i class="bookings-sort-up"></i>
                                        <i class="bookings-sort-down"></i>
                                    </span>
                                </a>
                            </th>
                            <th scope="col">
                                <a asp-page="/Bookings/Index"
                                   asp-route-TutorFilter="@Model.TutorFilter"
                                   asp-route-ModuleFilter="@Model.ModuleFilter"
                                   asp-route-DateFilter="@Model.DateFilter?.ToString("yyyy-MM-dd")"
                                   asp-route-LocationFilter="@Model.LocationFilter"
                                   asp-route-StatusFilter="@Model.StatusFilter"
                                   asp-route-SortBy="module"
                                   asp-route-SortDirection="@Model.GetNextSortDirection("module")"
                                   class="bookings-sort-link @(Model.IsSortedBy("module") ? "is-active" : null)">
                                    <span>Module</span>
                                    <span class="bookings-sort-arrows" aria-hidden="true">
                                        <i class="bookings-sort-up"></i>
                                        <i class="bookings-sort-down"></i>
                                    </span>
                                </a>
                            </th>
                            <th scope="col">
                                <a asp-page="/Bookings/Index"
                                   asp-route-TutorFilter="@Model.TutorFilter"
                                   asp-route-ModuleFilter="@Model.ModuleFilter"
                                   asp-route-DateFilter="@Model.DateFilter?.ToString("yyyy-MM-dd")"
                                   asp-route-LocationFilter="@Model.LocationFilter"
                                   asp-route-StatusFilter="@Model.StatusFilter"
                                   asp-route-SortBy="date"
                                   asp-route-SortDirection="@Model.GetNextSortDirection("date")"
                                   class="bookings-sort-link @(Model.IsSortedBy("date") ? "is-active" : null)">
                                    <span>Date &amp; Time</span>
                                    <span class="bookings-sort-arrows" aria-hidden="true">
                                        <i class="bookings-sort-up"></i>
                                        <i class="bookings-sort-down"></i>
                                    </span>
                                </a>
                            </th>
                            <th scope="col">
                                <a asp-page="/Bookings/Index"
                                   asp-route-TutorFilter="@Model.TutorFilter"
                                   asp-route-ModuleFilter="@Model.ModuleFilter"
                                   asp-route-DateFilter="@Model.DateFilter?.ToString("yyyy-MM-dd")"
                                   asp-route-LocationFilter="@Model.LocationFilter"
                                   asp-route-StatusFilter="@Model.StatusFilter"
                                   asp-route-SortBy="location"
                                   asp-route-SortDirection="@Model.GetNextSortDirection("location")"
                                   class="bookings-sort-link @(Model.IsSortedBy("location") ? "is-active" : null)">
                                    <span>Location</span>
                                    <span class="bookings-sort-arrows" aria-hidden="true">
                                        <i class="bookings-sort-up"></i>
                                        <i class="bookings-sort-down"></i>
                                    </span>
                                </a>
                            </th>
                            <th scope="col">
                                <a asp-page="/Bookings/Index"
                                   asp-route-TutorFilter="@Model.TutorFilter"
                                   asp-route-ModuleFilter="@Model.ModuleFilter"
                                   asp-route-DateFilter="@Model.DateFilter?.ToString("yyyy-MM-dd")"
                                   asp-route-LocationFilter="@Model.LocationFilter"
                                   asp-route-StatusFilter="@Model.StatusFilter"
                                   asp-route-SortBy="status"
                                   asp-route-SortDirection="@Model.GetNextSortDirection("status")"
                                   class="bookings-sort-link @(Model.IsSortedBy("status") ? "is-active" : null)">
                                    <span>Status</span>
                                    <span class="bookings-sort-arrows" aria-hidden="true">
                                        <i class="bookings-sort-up"></i>
                                        <i class="bookings-sort-down"></i>
                                    </span>
                                </a>
                            </th>
                            <th scope="col">Action</th>
                        </tr>
                    </thead>
                        <tbody>
                            @if (Model.Bookings.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="tutor-sessions-empty">
                                        You have not booked any sessions yet.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var booking in Model.Bookings)
                                {
                                    DateTimeOffset localStart =
                                        booking.AvailableTime.ToLocalTime();
                                    DateTimeOffset localEnd =
                                        booking.SessionEnd.ToLocalTime();
                                    string statusClass = booking.Status
                                        .ToString()
                                        .ToLowerInvariant();

                                    <tr>
                                        <td data-label="Tutor Name">
                                            @booking.TutorName
                                        </td>
                                        <td data-label="Module"
                                            title="@booking.ModuleName">
                                            @booking.ModuleCode
                                        </td>
                                        <td data-label="Date &amp; Time">
                                            <span class="tutor-session-date">
                                                @localStart.ToString("dd MMM yyyy")
                                            </span>
                                            <span class="tutor-session-time">
                                                @localStart.ToString("HH:mm")&ndash;@localEnd.ToString("HH:mm")
                                            </span>
                                        </td>
                                        <td data-label="Location">
                                            @booking.Location
                                        </td>
                                        <td data-label="Status">
                                            <span class="tutor-session-status tutor-session-status--@statusClass">
                                                @booking.Status
                                            </span>
                                        </td>
                                        <td data-label="Action">
                                            <a asp-page="/Tutors/Details"
                                               asp-route-id="@booking.TutorId"
                                               class="tutor-session-action"
                                               aria-label="View @booking.TutorName's tutor profile"
                                               title="View tutor profile">
                                                <svg aria-hidden="true" viewBox="0 0 24 24">
                                                    <path d="M8.6 16.8 13.4 12 8.6 7.2 10 5.8l6.2 6.2-6.2 6.2z" />
                                                </svg>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
                }
            </section>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/components/navigation-drawer.js"
            asp-append-version="true"></script>
    <script src="~/js/tutors.js"
            asp-append-version="true"></script>
}
