@page
@model BC_CampusLearn.Pages.Administrator.Admin.BookingsAndSessionsModel
@using BC_CampusLearn.Pages.Administrator.Admin

@{
    ViewData["Title"] = "Bookings and Sessions";
    var visibleSessionIds = Model.Sessions.Select(session => session.BookingId).ToHashSet();
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin-dashboard.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/admin-bookings-sessions.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/components/pagination.css"
          asp-append-version="true" />
}

<section class="admin-bookings-sessions" aria-labelledby="bookings-sessions-title">
    <header class="bookings-sessions-heading">
        <h1 id="bookings-sessions-title">Bookings and Sessions</h1>
    </header>

    <section class="admin-stat-grid admin-session-stats" aria-label="Session review statistics">
        @{
            var cards = new[]
            {
                (Label: "Pending Tutor Head review", Count: Model.PendingTutorHeadCount, Stat: "all", AwaitingTutorHead: true),
                (Label: "Pending admin review", Count: Model.PendingAdminCount, Stat: "pending-admin", AwaitingTutorHead: false),
                (Label: "Approved by Super Admin", Count: Model.SuperAdminApprovedCount, Stat: "super-admin-approved", AwaitingTutorHead: false),
                (Label: "Rejected by Super Admin", Count: Model.SuperAdminRejectedCount, Stat: "super-admin-rejected", AwaitingTutorHead: false)
            };
        }
        @foreach (var card in cards)
        {
            bool isActive = card.AwaitingTutorHead ? Model.AwaitingTutorHead : Model.Stat == card.Stat;
            <a asp-page="/Administrator/Admin/BookingsAndSessions"
               asp-route-Stat="@card.Stat"
               asp-route-AwaitingTutorHead="@card.AwaitingTutorHead"
               asp-route-Period="@Model.Period"
               asp-route-From="@Model.From?.ToString("yyyy-MM-dd")"
               asp-route-To="@Model.To?.ToString("yyyy-MM-dd")"
               class="admin-stat-card admin-stat-card-link @(isActive ? "is-active" : null)"
               aria-current="@(isActive ? "true" : null)">
                <div class="admin-stat-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
                        <path d="M0 0h24v24H0z" fill="none" />
                        @switch (card.Stat)
                        {
                            case "all":
                                <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5">
                                    <path d="M18.01 7.49L19.5 6m1 7.5a8.5 8.5 0 1 1-17 0a8.5 8.5 0 0 1 17 0" />
                                    <path d="M12 19a5.5 5.5 0 1 1 0-11m2.5-6h-5M12 13.5l3.5-3.5" />
                                </g>
                                break;
                            case "pending-admin":
                                <g fill="none" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.75 11v-1c0-3.771 0-5.657-1.171-6.828S15.52 2 11.75 2h-1C6.98 2 5.093 2 3.922 3.172S2.75 6.229 2.75 10v4c0 3.771 0 5.657 1.172 6.828S6.979 22 10.75 22" />
                                    <path stroke-linecap="round" d="M7.25 7h8m-8 5h8" />
                                    <path stroke-linejoin="round" d="M13.25 20.827V22h1.174c.409 0 .614 0 .798-.076s.329-.221.618-.51l4.824-4.825c.273-.273.41-.41.482-.556c.139-.28.139-.61 0-.89c-.073-.147-.21-.283-.482-.556c-.274-.273-.41-.41-.557-.483a1 1 0 0 0-.89 0c-.147.073-.284.21-.556.483l-4.824 4.824c-.29.289-.434.434-.51.618s-.077.388-.077.798Z" />
                                </g>
                                break;
                            case "super-admin-approved":
                                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 3H6.6c-2.168 0-3.252 0-3.926.674C2 4.347 2 5.43 2 7.6v5.3c0 2.168 0 3.253.674 3.926c.673.674 1.757.674 3.926.674h2.35A3.11 3.11 0 0 1 12 20V5c-.944-1.259-2-2-4-2m4 17V5c.944-1.259 2-2 4-2h1.4c2.168 0 3.252 0 3.926.674C22 4.347 22 5.43 22 7.6V13m-6.5 6s1 .5 1.625 2c0 0 2.58-3.75 4.875-4.5" />
                                break;
                            case "super-admin-rejected":
                                <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 6L6 18m12 0L6 6" />
                                break;
                        }
                    </svg>
                </div>
                <div class="admin-stat-content"><h2>@card.Label</h2><p>@card.Count</p></div>
            </a>
        }
    </section>

    <div class="sessions-workspace">
        <aside class="session-filters" aria-labelledby="session-filters-title">
            <div class="session-filter-heading">
                <h2 id="session-filters-title">Filters</h2>
                <a asp-page="/Administrator/Admin/BookingsAndSessions">Clear All</a>
            </div>
            <p class="session-filter-period">
                @Model.PeriodLabel
            </p>

            <form method="get" asp-page="/Administrator/Admin/BookingsAndSessions">
                @if (Model.Stat != "all")
                {
                    <input asp-for="Stat" type="hidden" />
                }
                <label class="session-filter-field">
                    <span>Search sessions</span>
                    <span class="session-filter-search">
                        <input asp-for="Search"
                               type="search"
                               placeholder="Tutor, student or location"
                               data-session-search
                               autocomplete="off" />
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6" /><path d="m15 15 6 6" /></svg>
                    </span>
                </label>

                <label class="session-filter-field">
                    <span>Reviews submitted</span>
                    <select asp-for="AwaitingTutorHead">
                        <option value="false">Student, Tutor and Tutor Head</option>
                        <option value="true">Student and Tutor only</option>
                    </select>
                </label>

                @if (Model.IsSuperAdmin && !Model.AwaitingTutorHead &&
                    Model.Stat is not ("pending-admin" or "super-admin-approved" or "super-admin-rejected"))
                {
                <label class="session-filter-field">
                    <span>Final session validity</span>
                    <select asp-for="Approval">
                        <option value="all">All approval statuses</option>
                        <option value="pending">Awaiting review</option>
                        <option value="approved">Accepted</option>
                        <option value="rejected">Rejected</option>
                    </select>
                </label>
                }

                <label class="session-filter-field">
                    <span>Date</span>
                    <select asp-for="Period" data-session-period>
                        <option value="month">Current period</option>
                        <option value="week">Current week</option>
                        <option value="day">Today</option>
                        <option value="custom">Custom dates</option>
                    </select>
                </label>

                <div class="session-custom-period" data-custom-period @(Model.Period == "custom" ? null : "hidden")>
                    <label class="session-filter-field">
                        <span>From</span>
                        <input asp-for="From" type="date" />
                    </label>
                    <label class="session-filter-field">
                        <span>To</span>
                        <input asp-for="To" type="date" />
                    </label>
                </div>

                <button type="submit" class="session-filter-submit">Apply Filters</button>
            </form>
        </aside>

        <div class="sessions-main-column">
            <p class="session-result-count" role="status">
                Showing <strong data-session-result-count>@Model.FilteredSessionCount</strong> sessions
            </p>

            <section class="completed-sessions" aria-label="Completed sessions">
            <div class="completed-session-table-wrap" tabindex="0">
                <table class="completed-session-table">
                    <thead>
                        <tr>
                            <th scope="col">Tutor name</th>
                            <th scope="col">Student name</th>
                            <th scope="col">Location</th>
                            <th scope="col">Session date</th>
                            <th scope="col" class="session-decision-column">Tutor Head decision</th>
                            @if (Model.IsSuperAdmin)
                            {
                                <th scope="col">Superadmin review</th>
                                <th scope="col">Final validity</th>
                            }
                            <th scope="col" class="session-action-heading">Action</th>
                        </tr>
                    </thead>
                    <tbody id="admin-session-results" data-pagination-page-parameter="SessionPage">
                            <tr data-session-empty hidden="@(Model.FilteredSessionCount != 0)">
                                <td colspan="@(Model.IsSuperAdmin ? 8 : 6)" class="completed-session-empty">
                                    No completed sessions match the selected filters.
                                </td>
                            </tr>
                            @foreach (var session in Model.SearchableSessions)
                            {
                                <tr data-pagination-row
                                    data-pagination-excluded="@(!Model.MatchesSearch(session) ? "true" : "false")"
                                    data-tutor-name="@session.TutorDisplayName"
                                    data-tutor-number="@session.TutorPersonnelNumber"
                                    data-student-name="@session.StudentName"
                                    data-session-location="@session.Location"
                                    hidden="@(!visibleSessionIds.Contains(session.BookingId))">
                                    <th scope="row">@session.TutorDisplayName</th>
                                    <td>@session.StudentName</td>
                                    <td>@session.Location</td>
                                    <td class="session-decision-column">
                                        <time datetime="@session.SessionDate.ToString("O")">
                                            @session.SessionDate.ToOffset(TimeSpan.FromHours(2)).ToString("dd MMM yyyy, HH:mm")
                                        </time>
                                    </td>
                                    <td class="@(session.TutorHeadDecisionCssClass == "is-unavailable" ? "text-center" : null)">
                                        <span class="session-tutor-head-decision @session.TutorHeadDecisionCssClass"
                                              aria-label="Tutor Head decision: @session.TutorHeadDecisionLabel"
                                              title="@session.TutorHeadDecisionLabel">
                                            @if (session.TutorHeadDecisionCssClass == "is-approved")
                                            {
                                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                                    <path d="M0 0h24v24H0z" fill="none" />
                                                    <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2 12.5a2 2 0 0 1 2-2a3 3 0 0 1 3 3v4a3 3 0 0 1-3 3a2 2 0 0 1-2-2zm13.479-4.694l-.267.86c-.218.705-.327 1.057-.243 1.336a1 1 0 0 0 .42.547c.251.158.63.158 1.39.158h.404c2.57 0 3.855 0 4.462.76q.104.131.185.277c.467.848-.064 1.991-1.126 4.277c-.974 2.098-1.462 3.147-2.366 3.764q-.132.09-.27.17c-.952.545-2.132.545-4.492.545h-.511c-2.86 0-4.289 0-5.177-.86C7 18.779 7 17.394 7 14.624v-.974c0-1.455 0-2.183.258-2.85c.259-.666.753-1.213 1.743-2.309l4.091-4.53c.103-.114.154-.17.2-.21a1.033 1.033 0 0 1 1.442.091c.04.045.083.108.17.234c.135.196.202.294.261.392c.528.871.687 1.906.446 2.89c-.027.109-.062.222-.132.448" />
                                                </svg>
                                            }
                                            else if (session.TutorHeadDecisionCssClass == "is-rejected")
                                            {
                                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                                    <path d="M0 0h24v24H0z" fill="none" />
                                                    <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2 11.5a2 2 0 0 0 2 2a3 3 0 0 0 3-3v-4a3 3 0 0 0-3-3a2 2 0 0 0-2 2zm13.479 4.694l-.267-.86c-.218-.705-.327-1.057-.243-1.336a.98.98 0 0 1 .42-.547c.251-.158.63-.158 1.39-.158h.404c2.57 0 3.855 0 4.462-.76q.104-.131.185-.277c.467-.848-.064-1.991-1.126-4.277c-.974-2.098-1.462-3.147-2.366-3.764a4 4 0 0 0-.27-.17c-.952-.545-2.132-.545-4.492-.545h-.511c-2.86 0-4.289 0-5.177.86C7 5.222 7 6.607 7 9.377v.974c0 1.455 0 2.183.258 2.85c.259.666.753 1.213 1.743 2.309l4.091 4.53c.103.114.154.17.2.21a1.033 1.033 0 0 0 1.442-.091c.04-.045.083-.108.17-.234a9 9 0 0 0 .261-.392a3.8 3.8 0 0 0 .446-2.89a8 8 0 0 0-.132-.448" />
                                                </svg>
                                            }
                                            else if (session.TutorHeadDecisionCssClass == "is-escalated")
                                            {
                                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                                    <path d="M0 0h24v24H0z" fill="none" />
                                                    <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5">
                                                        <path d="M22 12c0 5.523-4.477 10-10 10S2 17.523 2 12S6.477 2 12 2s10 4.477 10 10" />
                                                        <path d="M12 9v7m3.5-4.5S12.922 8 12 8s-3.5 3.5-3.5 3.5" />
                                                    </g>
                                                </svg>
                                            }
                                            <span>@session.TutorHeadDecisionLabel</span>
                                        </span>
                                    </td>
                                    @if (Model.IsSuperAdmin)
                                    {
                                        <td>
                                            <span class="session-approval @session.AdminApprovalCssClass">
                                                @session.AdminApprovalLabel
                                            </span>
                                        </td>
                                        <td>
                                            <span class="session-approval @session.SuperAdminDecisionCssClass">
                                                @session.SuperAdminDecisionLabel
                                            </span>
                                        </td>
                                    }
                                    <td class="session-action-cell">
                                        <div class="session-row-actions">
                                            <span class="session-concern-slot">
                                                @if (session.HasTutorHeadConcern)
                                                {
                                                    <span class="session-flagged-concern"
                                                          tabindex="0"
                                                          aria-label="Flagged concern">
                                                        <svg viewBox="0 0 24 24" aria-hidden="true">
                                                            <path d="M0 0h24v24H0z" fill="none" />
                                                            <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5">
                                                                <circle cx="12" cy="12" r="10" />
                                                                <path d="M12 8v4m.125 3.75H12m.25 0a.25.25 0 1 1-.5 0a.25.25 0 0 1 .5 0" />
                                                            </g>
                                                        </svg>
                                                        <span class="session-concern-tooltip" role="tooltip">Flagged concern</span>
                                                    </span>
                                                }
                                            </span>
                                            <a asp-page="/Administrator/Tutors/SessionDetails"
                                               asp-route-id="@session.BookingId"
                                               class="session-view-link"
                                               aria-label="View session for @session.StudentName with @session.TutorDisplayName">
                                                View
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                    </tbody>
                </table>
            </div>
            @await Component.InvokeAsync("Pagination", new
            {
                targetId = "admin-session-results",
                mobilePageSize = BookingsAndSessionsModel.PageSize,
                defaultPageSize = BookingsAndSessionsModel.PageSize,
                ariaLabel = "Completed session pages"
            })
            <noscript>
                @await Component.InvokeAsync("Pagination", new
                {
                    currentPage = Model.SessionPage,
                    totalPages = Model.TotalPages,
                    pageRouteValueName = "SessionPage",
                    ariaLabel = "Completed session pages"
                })
            </noscript>
            </section>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/admin-session-search.js" asp-append-version="true"></script>
    <script src="~/js/components/pagination.js" asp-append-version="true"></script>
    <script>
        (() => {
            const period = document.querySelector('[data-session-period]');
            const customPeriod = document.querySelector('[data-custom-period]');
            if (!period || !customPeriod) return;

            const updateCustomPeriod = () => {
                customPeriod.hidden = period.value !== 'custom';
            };
            period.addEventListener('change', updateCustomPeriod);
            updateCustomPeriod();
        })();
    </script>
}
