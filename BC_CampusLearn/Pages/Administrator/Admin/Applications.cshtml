@page
@model BC_CampusLearn.Pages.Administrator.Admin.ApplicationsModel

@{
    ViewData["Title"] = "Applications";
}

@section Styles {
    <link rel="stylesheet" href="~/css/components/pagination.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/admin-applications.css"
          asp-append-version="true" />
}

<section class="admin-applications" aria-labelledby="applications-title">
    <div class="admin-applications-heading">
        <h1 id="applications-title">Applications</h1>
    </div>

    <form method="get" class="applications-search-form" role="search">
        <input type="hidden" name="Stage" value="@Model.Stage" />
        <input type="hidden" name="Sort" value="@Model.Sort" />
        <input type="hidden" name="SortDirection" value="@Model.SortDirection" />
        <button type="button" class="applications-settings-button"
                data-open-application-settings>
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M0 0h24v24H0z" fill="none" stroke="none" />
                <path d="m21.318 7.141l-.494-.856c-.373-.648-.56-.972-.878-1.101c-.317-.13-.676-.027-1.395.176l-1.22.344c-.459.106-.94.046-1.358-.17l-.337-.194a2 2 0 0 1-.788-.967l-.334-.998c-.22-.66-.33-.99-.591-1.178c-.261-.19-.609-.19-1.303-.19h-1.115c-.694 0-1.041 0-1.303.19c-.261.188-.37.518-.59 1.178l-.334.998a2 2 0 0 1-.789.967l-.337.195c-.418.215-.9.275-1.358.17l-1.22-.345c-.719-.203-1.078-.305-1.395-.176c-.318.129-.505.453-.878 1.1l-.493.857c-.35.608-.525.911-.491 1.234c.034.324.268.584.736 1.105l1.031 1.153c.252.319.431.875.431 1.375s-.179 1.056-.43 1.375l-1.032 1.152c-.468.521-.702.782-.736 1.105s.14.627.49 1.234l.494.857c.373.647.56.971.878 1.1s.676.028 1.395-.176l1.22-.344a2 2 0 0 1 1.359.17l.336.194c.36.23.636.57.788.968l.334.997c.22.66.33.99.591 1.18c.262.188.609.188 1.303.188h1.115c.694 0 1.042 0 1.303-.189s.371-.519.59-1.179l.335-.997c.152-.399.428-.738.788-.968l.336-.194c.42-.215.9-.276 1.36-.17l1.22.344c.718.204 1.077.306 1.394.177c.318-.13.505-.454.878-1.101l.493-.857c.35-.607.525-.91.491-1.234s-.268-.584-.736-1.105l-1.031-1.152c-.252-.32-.431-.875-.431-1.375s.179-1.056.43-1.375l1.032-1.153c.468-.52.702-.781.736-1.105s-.14-.626-.49-1.234ZM15.52 12a3.5 3.5 0 1 1-7 0a3.5 3.5 0 0 1 7 0Z" />
            </svg>
            Manage
        </button>
        <div class="applications-search-group">
            <div class="applications-search">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" />
                    <path d="m16 16l5 5" />
                </svg>
                <label class="visually-hidden" asp-for="Search">Search candidates</label>
                <input asp-for="Search" placeholder="Search candidates..." />
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <a asp-page="/Administrator/Admin/Applications"
                       asp-route-Stage="@Model.Stage"
                       asp-route-Sort="@Model.Sort"
                       asp-route-SortDirection="@Model.SortDirection"
                       class="applications-search-clear"
                       aria-label="Clear candidate search"
                       title="Clear search">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M6 6l12 12M18 6L6 18" />
                        </svg>
                    </a>
                }
            </div>

            <button type="submit" class="applications-search-button">Search</button>
        </div>

        <button type="submit" class="applications-refresh"
                aria-label="Refresh candidates" title="Refresh candidates">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20 6v5h-5M4 18v-5h5M18.5 9A7 7 0 0 0 6.2 6.2L4 8m16 8l-2.2 1.8A7 7 0 0 1 5.5 15" />
            </svg>
            Refresh
        </button>
    </form>

    <dialog class="admin-application-modal"
            data-application-settings-modal
            data-show="@Model.ShowApplicationSettingsModal.ToString().ToLowerInvariant()"
            aria-labelledby="application-settings-title">
        <button type="button"
                class="admin-modal-close"
                data-admin-modal-close
                aria-label="Close">&times;</button>
        <h2 id="application-settings-title">Application availability</h2>
        <p>Choose which applications are open. Tutor application dates apply only to students applying to become tutors.</p>
        <form method="post"
              asp-page-handler="Settings"
              id="application-settings-cycle-form"
              data-cycle-settings-form>
            <input type="hidden" name="Stage" value="@Model.Stage" />
            <input type="hidden" name="Search" value="@Model.Search" />
            <div class="admin-application-type-toggles">
                <label class="applications-toggle">
                    <span>Become a Tutor</span>
                    <input type="checkbox" name="isOpen" value="true"
                           checked="@Model.OpenApplications"
                           data-cycle-tutor-toggle />
                    <span class="applications-toggle-track" aria-hidden="true"><span></span></span>
                </label>
                <input type="hidden" name="isOpen" value="false" />

                <label class="applications-toggle">
                    <span>Senior Tutor applications</span>
                    <input type="checkbox" name="seniorTutorApplicationsOpen"
                           value="true"
                           checked="@Model.SeniorTutorApplicationsOpen"
                           data-cycle-senior-toggle />
                    <span class="applications-toggle-track" aria-hidden="true"><span></span></span>
                </label>
                <input type="hidden" name="seniorTutorApplicationsOpen" value="false" />
            </div>
            <div class="admin-application-window" data-cycle-tutor-window>
                <h3>Become a Tutor dates</h3>
                <div class="admin-application-settings-grid">
                    <label>
                        <span>Opening date</span>
                        <div class="admin-date-entry">
                            <input type="text" inputmode="numeric" maxlength="10"
                                   placeholder="dd/mm/yyyy"
                                   autocomplete="off"
                                   data-cycle-open-date-display
                                   value="@(Model.OpenApplications ? Model.ApplicationOpenDate?.ToString("dd/MM/yyyy") : null)"
                                   data-cycle-tutor-setting />
                            <button type="button" class="admin-date-picker-button"
                                    data-date-picker-target="tutor-open-date"
                                    aria-label="Choose opening date">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M7 2v3m10-3v3M3.5 9h17M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" />
                                </svg>
                            </button>
                            <input id="tutor-open-date" type="date" name="openDate"
                                   class="admin-native-date-picker" tabindex="-1"
                                   data-cycle-open-date
                                   value="@(Model.OpenApplications ? Model.ApplicationOpenDate?.ToString("yyyy-MM-dd") : null)"
                                   data-cycle-tutor-setting />
                        </div>
                    </label>
                    <label>
                        <span>Closing date</span>
                        <div class="admin-date-entry">
                            <input type="text" inputmode="numeric" maxlength="10"
                                   placeholder="dd/mm/yyyy"
                                   autocomplete="off"
                                   data-cycle-close-date-display
                                   value="@(Model.OpenApplications ? Model.ApplicationCloseDate?.ToString("dd/MM/yyyy") : null)"
                                   data-cycle-tutor-setting />
                            <button type="button" class="admin-date-picker-button"
                                    data-date-picker-target="tutor-close-date"
                                    aria-label="Choose closing date">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M7 2v3m10-3v3M3.5 9h17M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" />
                                </svg>
                            </button>
                            <input id="tutor-close-date" type="date" name="closeDate"
                                   class="admin-native-date-picker" tabindex="-1"
                                   data-cycle-close-date
                                   value="@(Model.OpenApplications ? Model.ApplicationCloseDate?.ToString("yyyy-MM-dd") : null)"
                                   data-cycle-tutor-setting />
                        </div>
                    </label>
                </div>
                <p class="admin-application-countdown"
                   data-cycle-tutor-countdown hidden></p>
            </div>
            <div class="admin-application-window" data-cycle-senior-window>
                <h3>Senior Tutor application dates</h3>
                <div class="admin-application-settings-grid">
                    <label>
                        <span>Opening date</span>
                        <div class="admin-date-entry">
                            <input type="text" inputmode="numeric" maxlength="10"
                                   placeholder="dd/mm/yyyy"
                                   autocomplete="off"
                                   data-cycle-senior-open-date-display
                                   value="@(Model.SeniorTutorApplicationsOpen ? Model.SeniorTutorApplicationOpenDate?.ToString("dd/MM/yyyy") : null)"
                                   data-cycle-senior-setting />
                            <button type="button" class="admin-date-picker-button"
                                    data-date-picker-target="senior-open-date"
                                    aria-label="Choose Senior Tutor opening date">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M7 2v3m10-3v3M3.5 9h17M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" />
                                </svg>
                            </button>
                            <input id="senior-open-date" type="date" name="seniorOpenDate"
                                   class="admin-native-date-picker" tabindex="-1"
                                   data-cycle-senior-open-date
                                   value="@(Model.SeniorTutorApplicationsOpen ? Model.SeniorTutorApplicationOpenDate?.ToString("yyyy-MM-dd") : null)"
                                   data-cycle-senior-setting />
                        </div>
                    </label>
                    <label>
                        <span>Closing date</span>
                        <div class="admin-date-entry">
                            <input type="text" inputmode="numeric" maxlength="10"
                                   placeholder="dd/mm/yyyy"
                                   autocomplete="off"
                                   data-cycle-senior-close-date-display
                                   value="@(Model.SeniorTutorApplicationsOpen ? Model.SeniorTutorApplicationCloseDate?.ToString("dd/MM/yyyy") : null)"
                                   data-cycle-senior-setting />
                            <button type="button" class="admin-date-picker-button"
                                    data-date-picker-target="senior-close-date"
                                    aria-label="Choose Senior Tutor closing date">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M7 2v3m10-3v3M3.5 9h17M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" />
                                </svg>
                            </button>
                            <input id="senior-close-date" type="date" name="seniorCloseDate"
                                   class="admin-native-date-picker" tabindex="-1"
                                   data-cycle-senior-close-date
                                   value="@(Model.SeniorTutorApplicationsOpen ? Model.SeniorTutorApplicationCloseDate?.ToString("yyyy-MM-dd") : null)"
                                   data-cycle-senior-setting />
                        </div>
                    </label>
                </div>
                <p class="admin-application-countdown"
                   data-cycle-senior-countdown hidden></p>
            </div>
            <span class="admin-modal-validation" data-cycle-validation>
                @(Model.ShowApplicationSettingsModal ? Model.PageError : null)
            </span>
            <div class="admin-modal-actions">
                <button type="button"
                        class="admin-modal-no-target"
                        data-admin-modal-close>Close</button>
                <button type="submit">Save settings</button>
            </div>
        </form>
    </dialog>

    <dialog class="admin-application-modal admin-shortlist-target-modal"
            data-shortlist-target-modal
            aria-labelledby="shortlist-target-title">
        <button type="button" class="admin-modal-close"
                data-shortlist-target-cancel aria-label="Close">&times;</button>
        <h2 id="shortlist-target-title">Set a shortlist target</h2>
        <p>This is optional. Leave it blank if there is no fixed number of students to shortlist.</p>
        <label class="admin-shortlist-target-field">
            <span>Students to shortlist <small>Optional</small></span>
            <input type="number" name="shortlistLimit" min="1"
                   value="@Model.ShortlistLimit"
                   form="application-settings-cycle-form"
                   data-shortlist-target-input />
        </label>
        <div class="admin-modal-actions">
            <button type="button" class="admin-modal-no-target"
                    data-shortlist-target-clear>No target</button>
            <button type="button" data-shortlist-target-confirm>Continue</button>
        </div>
    </dialog>

    <dialog class="admin-application-modal"
            data-shortlist-threshold-modal
            data-show="@Model.ShowShortlistThresholdModal.ToString().ToLowerInvariant()"
            aria-labelledby="shortlist-threshold-title">
        <h2 id="shortlist-threshold-title">Shortlist target reached</h2>
        <p>
            You have shortlisted @Model.ShortlistLimit candidates. Do you want to continue
            shortlisting beyond this target?
        </p>
        <div class="admin-modal-actions">
            <form method="post" asp-page-handler="Settings">
                <input type="hidden" name="Stage" value="applications" />
                <input type="hidden" name="Search" value="@Model.Search" />
                <input type="hidden" name="isOpen" value="false" />
                <input type="hidden" name="seniorTutorApplicationsOpen"
                       value="@Model.SeniorTutorApplicationsOpen.ToString().ToLowerInvariant()" />
                <input type="hidden" name="seniorOpenDate"
                       value="@Model.SeniorTutorApplicationOpenDate?.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="seniorCloseDate"
                       value="@Model.SeniorTutorApplicationCloseDate?.ToString("yyyy-MM-dd")" />
                <button type="submit" class="admin-modal-no-target">
                    Close Applications
                </button>
            </form>
            <form method="post" asp-page-handler="ContinueShortlisting">
                <input type="hidden" name="Search" value="@Model.Search" />
                <button type="submit">Continue shortlisting</button>
            </form>
        </div>
    </dialog>

    @if (Model.ShowReviewResultModal &&
        !string.IsNullOrWhiteSpace(Model.PageMessage))
    {
        <dialog class="admin-application-modal application-result-modal"
                data-review-result-modal
                data-show="true"
                aria-labelledby="application-result-title">
            <button type="button"
                    class="admin-modal-close"
                    data-admin-modal-close
                    aria-label="Close">&times;</button>
            <h2 id="application-result-title">Application rejected</h2>
            <div class="admin-modal-actions">
                <button type="button"
                        class="application-result-button"
                        data-admin-modal-close>
                    Continue reviewing applications
                </button>
            </div>
        </dialog>
    }

    @if (!Model.ShowReviewResultModal &&
        !string.IsNullOrWhiteSpace(Model.PageMessage))
    {
        @await Html.PartialAsync("_CampusAlert", new CampusAlertViewModel(Model.PageMessage))
    }
    @if (!string.IsNullOrWhiteSpace(Model.PageError))
    {
        @await Html.PartialAsync(
            "_CampusAlert",
            new CampusAlertViewModel(Model.PageError, CampusAlertVariant.Danger))
    }

    <nav class="application-stage-tabs" aria-label="Application stages">
        <a asp-page="/Administrator/Admin/Applications"
           asp-route-Stage="applications"
           asp-route-Sort="@Model.Sort"
           asp-route-SortDirection="@Model.SortDirection"
           asp-route-Search="@Model.Search"
           class="application-stage-tab @(Model.Stage == "applications" ? "is-active" : null)"
           aria-current="@(Model.Stage == "applications" ? "page" : null)">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M14.5 5h-2c-2.828 0-4.243 0-5.121.879C6.5 6.757 6.5 8.172 6.5 11v5c0 2.828 0 4.243.879 5.121C8.257 22 9.672 22 12.5 22h1.343c.818 0 1.226 0 1.594-.152s.656-.441 1.235-1.02l2.656-2.656c.579-.579.867-.867 1.02-1.235c.152-.368.152-.776.152-1.594V11c0-2.828 0-4.243-.879-5.121C18.743 5 17.328 5 14.5 5M15 21.5v-1c0-1.886 0-2.828.586-3.414S17.114 16.5 19 16.5h1M6.5 19a3 3 0 0 1-3-3V8c0-2.828 0-4.243.879-5.121C5.257 2 6.672 2 9.5 2h5a3 3 0 0 1 3 3m-7.499 8h4m-4-4h7" />
            </svg>
            <span>Applications</span>
            <strong>@Model.ApplicationCount</strong>
        </a>

        <a asp-page="/Administrator/Admin/Applications"
           asp-route-Stage="shortlist"
           asp-route-Sort="@Model.Sort"
           asp-route-SortDirection="@Model.SortDirection"
           asp-route-Search="@Model.Search"
           class="application-stage-tab @(Model.Stage == "shortlist" ? "is-active" : null)"
           aria-current="@(Model.Stage == "shortlist" ? "page" : null)">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="10" cy="7" r="4" />
                <path d="M10 14c-5 0-8 2.5-8 5a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2c0-2.5-3-5-8-5m6-3.167s1.011.338 1.5 1.667c0 0 2.382-3.333 4.5-4" />
            </svg>
            <span>Shortlist</span>
            <strong>@Model.ShortlistCount</strong>
        </a>

        <a asp-page="/Administrator/Admin/Applications"
           asp-route-Stage="interview"
           asp-route-Sort="@Model.Sort"
           asp-route-SortDirection="@Model.SortDirection"
           asp-route-Search="@Model.Search"
           class="application-stage-tab @(Model.Stage == "interview" ? "is-active" : null)"
           aria-current="@(Model.Stage == "interview" ? "page" : null)">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M21.5 12a9.5 9.5 0 0 1-9.5 9.5c-1.628 0-3.16-.41-4.5-1.131c-1.868-1.007-3.125-.071-4.234.097a.53.53 0 0 1-.456-.156a.64.64 0 0 1-.117-.703c.436-1.025.835-2.969.29-4.607a9.5 9.5 0 0 1-.483-3a9.5 9.5 0 1 1 19 0" />
                <path d="M12.126 12H12m-3.876 0H8m8.125 0H16m-3.75 0a.25.25 0 1 1-.5 0a.25.25 0 0 1 .5 0m-4 0a.25.25 0 1 1-.5 0a.25.25 0 0 1 .5 0m8 0a.25.25 0 1 1-.5 0a.25.25 0 0 1 .5 0" />
            </svg>
            <span>Interview</span>
            <strong>@Model.InterviewCount</strong>
        </a>

        <a asp-page="/Administrator/Admin/Applications"
           asp-route-Stage="placement"
           asp-route-Sort="@Model.Sort"
           asp-route-SortDirection="@Model.SortDirection"
           asp-route-Search="@Model.Search"
           class="application-stage-tab @(Model.Stage == "placement" ? "is-active" : null)"
           aria-current="@(Model.Stage == "placement" ? "page" : null)">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M8.5 6.5c0-1.404 0-2.107.337-2.611a2 2 0 0 1 .552-.552C9.893 3 10.596 3 12 3s2.107 0 2.611.337a2 2 0 0 1 .552.552c.337.504.337 1.207.337 2.611M22 14v-.5c0-3.3 0-4.95-1.025-5.975S18.3 6.5 15 6.5H9c-3.3 0-4.95 0-5.975 1.025S2 10.2 2 13.5v.5c0 3.3 0 4.95 1.025 5.975S5.7 21 9 21h6c3.3 0 4.95 0 5.975-1.025S22 17.3 22 14" />
                <path d="M2 11s2.632 4 10 4s10-4 10-4M12.125 11.75H12m.25 0a.25.25 0 1 1-.5 0a.25.25 0 0 1 .5 0" />
            </svg>
            <span>Placement</span>
            <strong>@Model.PlacementCount</strong>
        </a>
    </nav>

    @if (Model.Stage == "applications")
    {
        <div class="application-phase-actions">
            <div class="application-rejection-actions">
                <button type="button"
                        class="reject-remaining-button"
                        data-reject-selected-open
                        aria-haspopup="dialog"
                        aria-controls="reject-selected-dialog"
                        hidden
                        disabled>Reject selected applicants</button>
                <button type="button"
                        class="reject-remaining-button"
                        data-reject-remaining-open
                        aria-haspopup="dialog"
                        aria-controls="reject-remaining-dialog"
                        disabled="@(Model.RemainingApplicationCount == 0)">
                    Reject remaining applications
                </button>
            </div>
        </div>
        <dialog id="reject-selected-dialog"
                class="admin-application-modal"
                role="alertdialog"
                data-reject-selected-modal
                aria-labelledby="reject-selected-title"
                aria-describedby="reject-selected-warning">
            <button type="button" class="admin-modal-close" data-admin-modal-close aria-label="Close">&times;</button>
            <h2 id="reject-selected-title">Warning: reject selected applicants?</h2>
            <p id="reject-selected-warning" class="reject-remaining-warning">
                This permanently deletes the selected applicants' tutor profiles and all their uploaded application documents.
                This action cannot be undone.
            </p>
            <p>You are rejecting <strong data-reject-selected-count>0</strong> selected applicants. Each will receive an in-app rejection notification.</p>
            <form method="post" asp-page-handler="RejectSelected" data-reject-selected-form>
                <input type="hidden" name="confirmRejectSelected" value="true" />
                <input type="hidden" name="Search" value="@Model.Search" />
                <input type="hidden" name="Sort" value="@Model.Sort" />
                <input type="hidden" name="SortDirection" value="@Model.SortDirection" />
                <div data-selected-applicant-inputs></div>
                <div class="admin-modal-actions">
                    <button type="button" class="admin-modal-no-target" data-admin-modal-close autofocus>Cancel</button>
                    <button type="submit" class="reject-remaining-button">Reject and delete selected</button>
                </div>
            </form>
        </dialog>
        <dialog id="reject-remaining-dialog"
                class="admin-application-modal"
                role="alertdialog"
                data-reject-remaining-modal
                aria-labelledby="reject-remaining-title"
                aria-describedby="reject-remaining-warning">
            <button type="button" class="admin-modal-close" data-admin-modal-close aria-label="Close">&times;</button>
            <h2 id="reject-remaining-title">Warning: reject and delete remaining applications?</h2>
            <p id="reject-remaining-warning" class="reject-remaining-warning">
                This permanently deletes the remaining applicants' tutor profiles and all their uploaded application documents.
                This action cannot be undone.
            </p>
            <p>
                This will reject all @Model.RemainingApplicationCount remaining applications,
                including candidates on other pages or outside your current search.
                Shortlisted, interview, and placement candidates will remain unchanged.
            </p>
            <p>Each rejected candidate will receive an in-app notification that their application was unsuccessful.</p>
            <form method="post" asp-page-handler="RejectRemaining" data-reject-remaining-form>
                <input type="hidden" name="confirmRejectRemaining" value="true" />
                <input type="hidden" name="Search" value="@Model.Search" />
                <input type="hidden" name="Sort" value="@Model.Sort" />
                <input type="hidden" name="SortDirection" value="@Model.SortDirection" />
                <div class="admin-modal-actions">
                    <button type="button" class="admin-modal-no-target" data-admin-modal-close autofocus>Cancel</button>
                    <button type="submit" class="reject-remaining-button">Reject and delete applications</button>
                </div>
            </form>
        </dialog>
    }

    @if (Model.Stage == "placement")
    {
        <div class="placement-actions">
            <button type="button"
                    class="add-tutor-button"
                    data-add-tutor-open>
                <span aria-hidden="true">+</span>
                Add tutor
            </button>
        </div>
    }

    <section class="application-candidate-panel" aria-label="Application candidates">
        @if (Model.Stage == "applications")
        {
            <div class="application-selection">
                <label>
                    <input type="checkbox" data-select-visible-applicants />
                    Select this page
                </label>
                <span data-applicant-selection-count aria-live="polite">0 selected</span>
            </div>
        }
        <div class="application-table-heading">
            <span>Candidate</span>
            @foreach (var (column, label) in new[]
            {
                ("programme", "Programme"), ("year", "Year"),
                ("average", "Average"), ("modules", "Modules")
            })
            {
                bool isActive = Model.Sort == column;
                string nextDirection = isActive && Model.SortDirection == "asc" ? "desc" : "asc";
                string sortLabel = (isActive
                    ? $"{label}, sorted {(Model.SortDirection == "asc" ? "ascending" : "descending")}. "
                    : "") + $"Sort by {label} {(nextDirection == "asc" ? "ascending" : "descending")}";
                <a class="application-sort-link"
                   asp-page="/Administrator/Admin/Applications"
                   asp-route-Stage="@Model.Stage"
                   asp-route-Search="@Model.Search"
                   asp-route-Sort="@column"
                   asp-route-SortDirection="@nextDirection"
                   asp-fragment="application-candidates"
                   aria-label="@sortLabel">
                    @label
                    <span aria-hidden="true">@(isActive ? (Model.SortDirection == "asc" ? "↑" : "↓") : "↕")</span>
                </a>
            }
            <span>Submitted</span>
            <span>Status</span>
            <span>Action</span>
        </div>

        @if (Model.Candidates.Count == 0)
        {
            <div class="application-empty-state">
                <span class="application-empty-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="M3 7h6l2 2h10v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2ZM3 7V5a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v2" />
                    </svg>
                </span>
                <strong>No candidates in @Model.Stage</strong>
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <span>Try a different candidate search.</span>
                }
            </div>
        }
        else
        {
            <div id="application-candidates" class="application-candidate-list">
                @foreach (var candidate in Model.Candidates)
                {
                    <article class="application-candidate-row" data-pagination-row>
                        <div class="candidate-identity">
                            @if (Model.Stage == "applications")
                            {
                                <input type="checkbox"
                                       class="applicant-checkbox"
                                       value="@candidate.TutorId"
                                       data-applicant-select
                                       aria-label="Select @candidate.DisplayName (@candidate.PersonnelNumber)" />
                            }
                            <div>
                                <h3>@candidate.DisplayName</h3>
                                <p>@candidate.PersonnelNumber</p>
                            </div>
                        </div>
                        <dl>
                            <div>
                                <dt>Programme</dt>
                                <dd>@candidate.ProgrammeName</dd>
                            </div>
                            <div>
                                <dt>Year</dt>
                                <dd>@candidate.YearOfStudy</dd>
                            </div>
                            <div>
                                <dt>Average</dt>
                                <dd>@candidate.OverallAverage.ToString("0.#")%</dd>
                            </div>
                            <div>
                                <dt>Modules</dt>
                                <dd>@candidate.ModuleCount</dd>
                            </div>
                            <div>
                                <dt>Submitted</dt>
                                <dd>@candidate.SubmittedAt.ToString("dd MMM yyyy")</dd>
                            </div>
                        </dl>
                        <span class="candidate-status candidate-status--@candidate.Status.ToString().ToLowerInvariant()">
                            @candidate.ApplicationStage
                        </span>
                        @if (Model.Stage == "shortlist")
                        {
                            <button type="button"
                                    class="candidate-view-link"
                                    aria-label="View the shortlisted application submitted by @candidate.DisplayName"
                                    aria-haspopup="dialog"
                                    data-shortlist-view
                                    data-shortlist-modal-id="shortlist-candidate-@candidate.TutorId">
                                View
                            </button>
                        }
                        else if (Model.Stage == "interview")
                        {
                            <button type="button"
                                    class="candidate-view-link"
                                    aria-label="Open the interview workspace for @candidate.DisplayName"
                                    aria-haspopup="dialog"
                                    data-interview-process-open
                                    data-interview-process-modal-id="interview-candidate-@candidate.TutorId">
                                View
                            </button>
                        }
                        else if (Model.Stage == "placement")
                        {
                            <a asp-page="/Administrator/Tutors/Profile"
                               asp-route-id="@candidate.TutorId"
                               class="candidate-view-link"
                               aria-label="View the tutor profile for @candidate.DisplayName">
                                View
                            </a>
                        }
                        else
                        {
                            <a asp-page="/Administrator/Admin/ApplicationDetails"
                               asp-route-id="@candidate.TutorId"
                               asp-route-stage="@Model.Stage"
                               asp-route-search="@Model.Search"
                               class="candidate-view-link"
                               aria-label="View the application submitted by @candidate.DisplayName">
                                View
                            </a>
                        }
                    </article>
                }
            </div>
        }
        @await Component.InvokeAsync("Pagination", new
        {
            targetId = "application-candidates",
            mobilePageSize = 11,
            defaultPageSize = 11,
            ariaLabel = $"{Model.Stage} candidate pages"
        })
    </section>

    @if (Model.Stage == "shortlist")
    {
        @foreach (var candidate in Model.Candidates)
        {
            <dialog id="shortlist-candidate-@candidate.TutorId"
                    class="admin-application-modal shortlist-review-modal"
                    data-shortlist-review-modal
                    data-show="@((Model.OpenShortlistCandidateId == candidate.TutorId).ToString().ToLowerInvariant())"
                    aria-labelledby="shortlist-candidate-title-@candidate.TutorId">
                <button type="button"
                        class="admin-modal-close"
                        data-admin-modal-close
                        aria-label="Close">&times;</button>

                <header class="shortlist-review-header">
                    <h2 id="shortlist-candidate-title-@candidate.TutorId">@candidate.DisplayName</h2>
                    <p>Submitted @candidate.SubmittedAt.ToString("dd MMMM yyyy")</p>
                </header>

                <section class="shortlist-modal-section" aria-labelledby="applicant-details-@candidate.TutorId">
                    <h3 id="applicant-details-@candidate.TutorId">Applicant details</h3>

                    <details class="shortlist-detail-group"
                             name="shortlist-applicant-details-@candidate.TutorId">
                        <summary>Personal and academic details</summary>
                        <dl class="shortlist-detail-grid">
                            <div><dt>Full name</dt><dd>@candidate.DisplayName</dd></div>
                            <div><dt>Email address</dt><dd>@(candidate.Email ?? "Not provided")</dd></div>
                            <div><dt>Phone number</dt><dd>@(candidate.PhoneNumber ?? "Not provided")</dd></div>
                            <div><dt>Programme</dt><dd>@candidate.ProgrammeName</dd></div>
                            <div><dt>Year of study</dt><dd>@candidate.YearOfStudy</dd></div>
                            <div><dt>Overall average</dt><dd>@candidate.OverallAverage.ToString("0.##")%</dd></div>
                            <div><dt>Campus</dt><dd>@candidate.CampusOfStudy</dd></div>
                            <div><dt>Preferred tutoring mode</dt><dd>@candidate.PreferredTutoringModeLabel</dd></div>
                        </dl>
                    </details>

                    <details class="shortlist-detail-group"
                             name="shortlist-applicant-details-@candidate.TutorId">
                        <summary>Motivation and teaching profile</summary>
                        <dl class="shortlist-written-answers">
                            <div>
                                <dt>Why do you want to become a tutor?</dt>
                                <dd>@candidate.ReasonForTutoring</dd>
                            </div>
                            <div>
                                <dt>How would you describe your teaching style?</dt>
                                <dd>@candidate.TeachingStyle</dd>
                            </div>
                            <div>
                                <dt>Previous tutoring experience</dt>
                                <dd>@candidate.PreviousTutoringExperience</dd>
                            </div>
                            <div>
                                <dt>Demonstration video</dt>
                                <dd>
                                    @if (candidate.HasDemonstrationVideoLink)
                                    {
                                        <a href="@candidate.DemonstrationVideoUrl"
                                           target="_blank"
                                           rel="noopener noreferrer">Open demonstration video</a>
                                    }
                                    else
                                    {
                                        @candidate.DemonstrationVideoUrl
                                    }
                                </dd>
                            </div>
                        </dl>
                    </details>

                    <details class="shortlist-detail-group"
                             name="shortlist-applicant-details-@candidate.TutorId">
                        <summary>Modules and documents</summary>
                        <div class="shortlist-detail-content">
                            <h4>Selected modules</h4>
                            @if (candidate.Modules.Count == 0)
                            {
                                <p class="shortlist-empty-value">No modules were selected.</p>
                            }
                            else
                            {
                                <ul class="shortlist-module-list">
                                    @foreach (var module in candidate.Modules)
                                    {
                                        <li><strong>@module.Code</strong><span>@module.Name</span></li>
                                    }
                                </ul>
                            }

                            <h4>Submitted documents</h4>
                            @if (candidate.Documents.Count == 0)
                            {
                                <p class="shortlist-empty-value">No documents were submitted.</p>
                            }
                            else
                            {
                                <ul class="shortlist-document-list">
                                    @foreach (var document in candidate.Documents)
                                    {
                                        <li>
                                            <span>
                                                <strong>@ApplicationsModel.GetDocumentTypeLabel(document.DocumentType)</strong>
                                                <small>@document.OriginalFileName</small>
                                            </span>
                                            <a asp-page="/Administrator/Admin/ApplicationDetails"
                                               asp-page-handler="Document"
                                               asp-route-id="@candidate.TutorId"
                                               asp-route-documentId="@document.TutorDocumentId">
                                                Download
                                            </a>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </details>
                </section>

                <details class="shortlist-workflow-accordion">
                    <summary>
                        <h3 id="interview-preparation-@candidate.TutorId">Interview preparation and decision history</h3>
                    </summary>
                    <div class="shortlist-workflow-content">
                        <section class="shortlist-workflow-preparation"
                                 aria-labelledby="prepare-notes-@candidate.TutorId">
                            <h4 id="prepare-notes-@candidate.TutorId">Prepare for interview</h4>
                            <form method="post"
                                  id="shortlist-action-form-@candidate.TutorId"
                                  class="shortlist-interview-form"
                                  data-shortlist-action-form>
                                <input type="hidden" name="tutorId" value="@candidate.TutorId" />
                                <input type="hidden" name="Search" value="@Model.Search" />
                                <label for="interview-notes-@candidate.TutorId"
                                       class="shortlist-notes-label">
                                    <span>Interview preparation notes</span>
                                    <small>These are internal notes and will not be shared with the applicant.</small>
                                </label>
                                <textarea id="interview-notes-@candidate.TutorId"
                                          name="InterviewPreparation.Notes"
                                          rows="4"
                                          maxlength="1000"
                                          placeholder="Add notes for the interview panel."></textarea>

                                <div class="shortlist-notes-actions">
                                    <button type="submit"
                                            class="shortlist-save-button"
                                            asp-page-handler="SaveInterviewPreparation">
                                        Save notes
                                    </button>
                                </div>
                            </form>
                        </section>

                        <section class="shortlist-workflow-history"
                                 aria-labelledby="decision-history-@candidate.TutorId">
                            <h4 id="decision-history-@candidate.TutorId">Decision history</h4>
                            <div class="shortlist-workflow-history-scroll">
                                @if (candidate.DecisionHistory.Count == 0)
                                {
                                    <p class="shortlist-history-empty">No decisions have been recorded.</p>
                                }
                                else
                                {
                                    <ol class="shortlist-timeline">
                                        @foreach (var decision in candidate.DecisionHistory)
                                        {
                                            <li>
                                                <span class="shortlist-timeline-marker" aria-hidden="true"></span>
                                                <div>
                                                    <header>
                                                        <strong>@decision.Label</strong>
                                                        <time datetime="@decision.ReviewedAt.ToString("O")">
                                                            @decision.ReviewedAt.ToString("dd MMM yyyy 'at' HH:mm")
                                                        </time>
                                                    </header>
                                                    <p>@decision.Notes</p>
                                                    <small>By @decision.AdminName</small>
                                                </div>
                                            </li>
                                        }
                                    </ol>
                                }
                            </div>
                        </section>
                    </div>
                </details>

                <footer class="shortlist-modal-footer">
                    <button type="button"
                            class="shortlist-reject-button"
                            aria-haspopup="dialog"
                            data-shortlist-reject-open
                            data-reject-modal-id="shortlist-reject-@candidate.TutorId">
                        Reject
                    </button>
                    <button type="button"
                            class="shortlist-communicate-button"
                            aria-haspopup="dialog"
                            data-communicate-open
                            data-communication-modal-id="candidate-email-@candidate.TutorId">
                        Communicate
                    </button>
                    <button type="button"
                            class="shortlist-interview-button"
                            aria-haspopup="dialog"
                            data-interview-confirm-open
                            data-interview-confirm-modal-id="shortlist-interview-confirm-@candidate.TutorId">
                        Move to interview
                    </button>
                </footer>
            </dialog>

            <dialog id="candidate-email-@candidate.TutorId"
                    class="admin-application-modal candidate-email-modal"
                    data-candidate-email-modal
                    data-return-modal-id="shortlist-candidate-@candidate.TutorId"
                    data-student-name="@candidate.DisplayName"
                    aria-labelledby="candidate-email-title-@candidate.TutorId">
                <button type="button"
                        class="admin-modal-close"
                        data-communication-close
                        aria-label="Close">&times;</button>

                <header class="candidate-email-header">
                    <h2 id="candidate-email-title-@candidate.TutorId">Compose email</h2>
                    <p>Structure a clear message for @candidate.DisplayName.</p>
                </header>

                <form method="post"
                      asp-page-handler="SendCommunication"
                      class="candidate-email-form"
                      data-email-composer>
                    <input type="hidden" name="tutorId" value="@candidate.TutorId" />
                    <input type="hidden" name="Stage" value="@Model.Stage" />
                    <input type="hidden" name="Search" value="@Model.Search" />
                    <div class="candidate-email-field">
                        <label for="candidate-email-recipient-@candidate.TutorId">Recipient</label>
                        <input id="candidate-email-recipient-@candidate.TutorId"
                               type="email"
                               value="@(candidate.Email ?? "No email address available")"
                               readonly />
                    </div>

                    <div class="candidate-email-field">
                        <label for="candidate-email-template-@candidate.TutorId">Message template</label>
                        <select id="candidate-email-template-@candidate.TutorId"
                                data-email-template>
                            <option value="interview">Interview invitation</option>
                            <option value="availability">Request interview availability</option>
                            <option value="information">Request additional information</option>
                            <option value="custom">Custom message</option>
                        </select>
                    </div>

                    <div class="candidate-email-subject-row">
                        <div class="candidate-email-field">
                            <label for="candidate-email-subject-@candidate.TutorId">Subject</label>
                            <input id="candidate-email-subject-@candidate.TutorId"
                                   name="Communication.Subject"
                                   type="text"
                                   maxlength="200"
                                   value="Tutor application interview invitation"
                                   data-email-subject />
                        </div>
                        <button type="button"
                                class="candidate-email-schedule-open"
                                data-interview-schedule-open
                                data-schedule-modal-id="candidate-interview-schedule-@candidate.TutorId">
                            Set interview details
                        </button>
                    </div>

                    <div class="candidate-email-field">
                        <label for="candidate-email-body-@candidate.TutorId">Email message</label>
                        <textarea id="candidate-email-body-@candidate.TutorId"
                                  name="Communication.EmailBody"
                                  rows="12"
                                  maxlength="5000"
                                  data-email-body>Dear @candidate.DisplayName,

We are pleased to let you know that your tutor application has been shortlisted. We would like to invite you to an interview.

Interview details:
Date: [Add date]
Time: [Add time]
Duration: [Add duration]
Meeting link: [Add meeting link]

Please reply to confirm that you are available.

Kind regards,
Mzala Connect Tutor Team</textarea>
                        <div class="candidate-email-helper">
                            <span data-email-character-count>0 / 5000</span>
                        </div>
                    </div>

                    <div class="candidate-email-actions">
                        <button type="button"
                                class="candidate-email-cancel"
                                data-communication-close>
                            Back
                        </button>
                        <button type="submit"
                                class="candidate-email-send">
                            Send email
                        </button>
                    </div>
                </form>
            </dialog>

            <dialog id="candidate-interview-schedule-@candidate.TutorId"
                    class="admin-application-modal candidate-interview-schedule-modal"
                    data-interview-schedule-modal
                    data-return-modal-id="candidate-email-@candidate.TutorId"
                    data-email-modal-id="candidate-email-@candidate.TutorId"
                    aria-labelledby="candidate-interview-schedule-title-@candidate.TutorId">
                <button type="button"
                        class="admin-modal-close"
                        data-interview-schedule-close
                        aria-label="Close">&times;</button>

                <header class="candidate-interview-schedule-header">
                    <h2 id="candidate-interview-schedule-title-@candidate.TutorId">Set interview details</h2>
                    <p>Add the schedule that should appear in the interview invitation.</p>
                </header>

                <div class="candidate-interview-schedule-form">
                    <div class="candidate-interview-schedule-grid">
                        <label>
                            <span>Interview date</span>
                            <input type="date"
                                   data-interview-date
                                   value="@candidate.InterviewScheduledAt?.ToString("yyyy-MM-dd")" />
                        </label>
                        <label>
                            <span>Time</span>
                            <input type="text"
                                   inputmode="numeric"
                                   maxlength="5"
                                   pattern="(?:[01][0-9]|2[0-3]):[0-5][0-9]"
                                   placeholder="HH:mm"
                                   aria-label="Interview time in 24-hour format"
                                   data-interview-time
                                   value="@candidate.InterviewScheduledAt?.ToString("HH:mm")" />
                        </label>
                        <label>
                            <span>Duration</span>
                            <select data-interview-duration>
                                <option value="">Select duration</option>
                                @foreach (int duration in new[] { 15, 30, 45, 60, 90, 120 })
                                {
                                    <option value="@duration"
                                            selected="@(candidate.InterviewDurationMinutes == duration)">
                                        @duration minutes
                                    </option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>Meeting link</span>
                            <input type="url"
                                   maxlength="500"
                                   data-interview-location
                                   value="@candidate.InterviewLocation"
                                   placeholder="https://..." />
                        </label>
                    </div>

                    <div class="candidate-interview-schedule-actions">
                        <button type="button"
                                class="candidate-interview-schedule-cancel"
                                data-interview-schedule-close>
                            Cancel
                        </button>
                        <button type="button"
                                class="candidate-interview-schedule-save"
                                data-populate-interview-email>
                            Save
                        </button>
                    </div>
                </div>
            </dialog>

            <dialog id="shortlist-reject-@candidate.TutorId"
                    class="admin-application-modal shortlist-reject-modal shortlist-stage-reject-modal"
                    data-shortlist-reject-modal
                    data-return-modal-id="shortlist-candidate-@candidate.TutorId"
                    aria-labelledby="shortlist-reject-title-@candidate.TutorId">
                <div>
                    <h2 id="shortlist-reject-title-@candidate.TutorId">Reject this application?</h2>
                    <div class="candidate-email-field">
                        <label for="shortlist-reject-notification-@candidate.TutorId">Notification message</label>
                        <textarea id="shortlist-reject-notification-@candidate.TutorId"
                                  form="shortlist-action-form-@candidate.TutorId"
                                  name="RejectionMessage.NotificationMessage"
                                  rows="4"
                                  maxlength="1000">Thank you for your continued interest in the tutor programme. After careful review, we are unable to progress your application to the next stage.</textarea>
                    </div>
                    <div class="shortlist-reject-modal-actions">
                        <button type="button"
                                class="shortlist-reject-cancel"
                                data-shortlist-reject-close>
                            Cancel
                        </button>
                        <button type="submit"
                                form="shortlist-action-form-@candidate.TutorId"
                                asp-page-handler="RejectShortlisted"
                                class="shortlist-reject-confirm">
                            Yes, reject application
                        </button>
                    </div>
                </div>
            </dialog>

            <dialog id="shortlist-interview-confirm-@candidate.TutorId"
                    class="admin-application-modal shortlist-interview-confirm-modal"
                    data-interview-confirm-modal
                    data-return-modal-id="shortlist-candidate-@candidate.TutorId"
                    aria-labelledby="shortlist-interview-confirm-title-@candidate.TutorId">
                <div>
                    <h2 id="shortlist-interview-confirm-title-@candidate.TutorId">Move applicant to interview?</h2>
                    <p>
                        @candidate.DisplayName will be moved from the shortlist and moved to the
                        Interview stage. The student will be notified of this decision.
                    </p>
                    <div class="shortlist-interview-confirm-actions">
                        <button type="button"
                                class="shortlist-interview-confirm-cancel"
                                data-interview-confirm-close>
                            Cancel
                        </button>
                        <button type="submit"
                                form="shortlist-action-form-@candidate.TutorId"
                                asp-page-handler="MoveToInterview"
                                class="shortlist-interview-confirm-submit">
                            Yes, move to interview
                        </button>
                    </div>
                </div>
            </dialog>
        }
    }

    @if (Model.Stage == "interview")
    {
        @foreach (var candidate in Model.Candidates)
        {
            <dialog id="interview-candidate-@candidate.TutorId"
                    class="admin-application-modal shortlist-review-modal interview-process-modal"
                    data-interview-process-modal
                    aria-labelledby="interview-candidate-title-@candidate.TutorId">
                <button type="button"
                        class="admin-modal-close"
                        data-admin-modal-close
                        aria-label="Close">&times;</button>

                <header class="shortlist-review-header interview-process-header">
                    <h2 id="interview-candidate-title-@candidate.TutorId">@candidate.DisplayName</h2>
                    <p>Interview stage · Submitted @candidate.SubmittedAt.ToString("dd MMMM yyyy")</p>
                </header>

                <div class="interview-process-body">
                    <section class="shortlist-modal-section"
                             aria-labelledby="interview-applicant-details-@candidate.TutorId">
                    <h3 id="interview-applicant-details-@candidate.TutorId">Applicant details</h3>

                    <details class="shortlist-detail-group"
                             name="interview-applicant-details-@candidate.TutorId">
                        <summary>Personal and academic details</summary>
                        <dl class="shortlist-detail-grid">
                            <div><dt>Full name</dt><dd>@candidate.DisplayName</dd></div>
                            <div><dt>Email address</dt><dd>@(candidate.Email ?? "Not provided")</dd></div>
                            <div><dt>Phone number</dt><dd>@(candidate.PhoneNumber ?? "Not provided")</dd></div>
                            <div><dt>Programme</dt><dd>@candidate.ProgrammeName</dd></div>
                            <div><dt>Year of study</dt><dd>@candidate.YearOfStudy</dd></div>
                            <div><dt>Overall average</dt><dd>@candidate.OverallAverage.ToString("0.##")%</dd></div>
                            <div><dt>Campus</dt><dd>@candidate.CampusOfStudy</dd></div>
                            <div><dt>Preferred tutoring mode</dt><dd>@candidate.PreferredTutoringModeLabel</dd></div>
                        </dl>
                    </details>

                    <details class="shortlist-detail-group"
                             name="interview-applicant-details-@candidate.TutorId">
                        <summary>Motivation and teaching profile</summary>
                        <dl class="shortlist-written-answers">
                            <div><dt>Why do you want to become a tutor?</dt><dd>@candidate.ReasonForTutoring</dd></div>
                            <div><dt>How would you describe your teaching style?</dt><dd>@candidate.TeachingStyle</dd></div>
                            <div><dt>Previous tutoring experience</dt><dd>@candidate.PreviousTutoringExperience</dd></div>
                            <div>
                                <dt>Demonstration video</dt>
                                <dd>
                                    @if (candidate.HasDemonstrationVideoLink)
                                    {
                                        <a href="@candidate.DemonstrationVideoUrl"
                                           target="_blank"
                                           rel="noopener noreferrer">Open demonstration video</a>
                                    }
                                    else
                                    {
                                        @candidate.DemonstrationVideoUrl
                                    }
                                </dd>
                            </div>
                        </dl>
                    </details>

                    <details class="shortlist-detail-group"
                             name="interview-applicant-details-@candidate.TutorId">
                        <summary>Selected modules</summary>
                        <div class="shortlist-detail-content">
                            @if (candidate.Modules.Count == 0)
                            {
                                <p class="shortlist-empty-value">No modules were selected.</p>
                            }
                            else
                            {
                                <ul class="shortlist-module-list">
                                    @foreach (var module in candidate.Modules)
                                    {
                                        <li><strong>@module.Code</strong><span>@module.Name</span></li>
                                    }
                                </ul>
                            }
                        </div>
                    </details>
                    </section>

                    <section class="interview-room-launch-card">
                        <div class="interview-room-launch-copy">
                            <span class="interview-room-launch-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <path d="M8 7V5.8A2.8 2.8 0 0 1 10.8 3h2.4A2.8 2.8 0 0 1 16 5.8V7" />
                                    <rect x="4" y="7" width="16" height="13" rx="2.5" />
                                    <path d="M8 12h8M8 16h5" />
                                </svg>
                            </span>
                            <div>
                                <h3>Open Interview Room</h3>
                                <p>Record private notes while interviewing @candidate.DisplayName.</p>
                                @if (candidate.InterviewScheduledAt.HasValue)
                                {
                                    <small>
                                        @candidate.InterviewScheduledAt.Value.ToString("dd MMM yyyy · HH:mm")
                                        @if (candidate.InterviewDurationMinutes.HasValue)
                                        {
                                            <text> · @candidate.InterviewDurationMinutes minutes</text>
                                        }
                                    </small>
                                }
                            </div>
                        </div>
                        <div class="interview-room-launch-actions">
                            @if (candidate.HasInterviewMeetingLink)
                            {
                                <a href="@candidate.InterviewLocation"
                                   class="interview-teams-button"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    Join Teams meeting
                                </a>
                            }
                            else
                            {
                                <button type="button"
                                        class="interview-teams-button"
                                        disabled>
                                    Teams link unavailable
                                </button>
                            }
                            <button type="button"
                                    class="interview-room-card-open"
                                    data-interview-room-open
                                    data-interview-room-modal-id="interview-room-@candidate.TutorId">
                                Open Interview Room
                            </button>
                        </div>
                    </section>
                </div>

                <footer class="interview-process-footer">
                    <button type="button"
                            class="interview-reject-button"
                            aria-haspopup="dialog"
                            data-shortlist-reject-open
                            data-reject-modal-id="interview-reject-@candidate.TutorId">
                        Reject
                    </button>
                    <button type="button"
                            class="interview-communicate-button"
                            aria-haspopup="dialog"
                            data-communicate-open
                            data-communication-modal-id="interview-email-@candidate.TutorId">
                        Communicate
                    </button>
                    <button type="button"
                            class="interview-placement-button"
                            aria-haspopup="dialog"
                            data-interview-confirm-open
                            data-interview-confirm-modal-id="interview-placement-confirm-@candidate.TutorId">
                        Placement
                    </button>
                </footer>
            </dialog>

            <dialog id="interview-reject-@candidate.TutorId"
                    class="admin-application-modal shortlist-reject-modal interview-reject-modal"
                    data-shortlist-reject-modal
                    data-return-modal-id="interview-candidate-@candidate.TutorId"
                    aria-labelledby="interview-reject-title-@candidate.TutorId">
                <form method="post" asp-page-handler="RejectInterviewed">
                    <input type="hidden" name="tutorId" value="@candidate.TutorId" />
                    <input type="hidden" name="Search" value="@Model.Search" />
                    <h2 id="interview-reject-title-@candidate.TutorId">Reject this candidate?</h2>
                    <p>
                        @candidate.DisplayName will be removed from the interview stage and notified
                        through Mzala Connect that their tutor application was not approved.
                    </p>
                    <div class="candidate-email-field">
                        <label for="interview-reject-notification-@candidate.TutorId">Notification message</label>
                        <textarea id="interview-reject-notification-@candidate.TutorId"
                                  name="RejectionMessage.NotificationMessage"
                                  rows="4"
                                  maxlength="1000">Thank you for the time and effort you put into your tutor interview. Although we will not be progressing your application further on this occasion, we truly appreciate your interest in becoming a Mzala Connect tutor. We encourage you to keep developing your skills and to apply again in the future. We wish you every success on your journey!</textarea>
                    </div>
                    <div class="shortlist-reject-modal-actions">
                        <button type="button"
                                class="shortlist-reject-cancel"
                                data-shortlist-reject-close>
                            Cancel
                        </button>
                        <button type="submit" class="shortlist-reject-confirm">
                            Yes, reject candidate
                        </button>
                    </div>
                </form>
            </dialog>

            <dialog id="interview-placement-confirm-@candidate.TutorId"
                    class="admin-application-modal shortlist-interview-confirm-modal"
                    data-interview-confirm-modal
                    data-return-modal-id="interview-candidate-@candidate.TutorId"
                    aria-labelledby="interview-placement-confirm-title-@candidate.TutorId">
                <form method="post" asp-page-handler="MoveToPlacement">
                    <input type="hidden" name="tutorId" value="@candidate.TutorId" />
                    <input type="hidden" name="Search" value="@Model.Search" />
                    <h2 id="interview-placement-confirm-title-@candidate.TutorId">
                        Approve candidate as a tutor?
                    </h2>
                    <p>
                        @candidate.DisplayName will move to Placement, their tutor profile will be
                        activated, and they will receive an approval notification.
                    </p>
                    <div class="shortlist-interview-confirm-actions">
                        <button type="button"
                                class="shortlist-interview-confirm-cancel"
                                data-interview-confirm-close>
                            Cancel
                        </button>
                        <button type="submit" class="shortlist-interview-confirm-submit">
                            Yes, approve tutor
                        </button>
                    </div>
                </form>
            </dialog>

            <dialog id="interview-email-@candidate.TutorId"
                    class="admin-application-modal candidate-email-modal"
                    data-candidate-email-modal
                    data-return-modal-id="interview-candidate-@candidate.TutorId"
                    data-student-name="@candidate.DisplayName"
                    aria-labelledby="interview-email-title-@candidate.TutorId">
                <button type="button"
                        class="admin-modal-close"
                        data-communication-close
                        aria-label="Close">&times;</button>

                <header class="candidate-email-header">
                    <h2 id="interview-email-title-@candidate.TutorId">Compose email</h2>
                    <p>Structure a clear message for @candidate.DisplayName.</p>
                </header>

                <form method="post"
                      asp-page-handler="SendCommunication"
                      class="candidate-email-form"
                      data-email-composer>
                    <input type="hidden" name="tutorId" value="@candidate.TutorId" />
                    <input type="hidden" name="Stage" value="@Model.Stage" />
                    <input type="hidden" name="Search" value="@Model.Search" />
                    <div class="candidate-email-field">
                        <label for="interview-email-recipient-@candidate.TutorId">Recipient</label>
                        <input id="interview-email-recipient-@candidate.TutorId"
                               type="email"
                               value="@(candidate.Email ?? "No email address available")"
                               readonly />
                    </div>

                    <div class="candidate-email-field">
                        <label for="interview-email-template-@candidate.TutorId">Message template</label>
                        <select id="interview-email-template-@candidate.TutorId"
                                data-email-template>
                            <option value="followup">Interview follow-up</option>
                            <option value="information">Request additional information</option>
                            <option value="custom">Custom message</option>
                        </select>
                    </div>

                    <div class="candidate-email-field">
                        <label for="interview-email-subject-@candidate.TutorId">Subject</label>
                        <input id="interview-email-subject-@candidate.TutorId"
                               name="Communication.Subject"
                               type="text"
                               maxlength="200"
                               value="Thank you for attending your tutor interview"
                               data-email-subject />
                    </div>

                    <div class="candidate-email-field">
                        <label for="interview-email-body-@candidate.TutorId">Email message</label>
                        <textarea id="interview-email-body-@candidate.TutorId"
                                  name="Communication.EmailBody"
                                  rows="12"
                                  maxlength="5000"
                                  data-email-body>Dear @candidate.DisplayName,

Thank you for taking the time to attend your tutor interview. We appreciate the opportunity to learn more about your experience and interest in tutoring.

We will contact you once the interview review has been completed.

Kind regards,
Mzala Connect Tutor Team</textarea>
                        <div class="candidate-email-helper">
                            <span data-email-character-count>0 / 5000</span>
                        </div>
                    </div>

                    <div class="candidate-email-actions">
                        <button type="button"
                                class="candidate-email-cancel"
                                data-communication-close>
                            Back
                        </button>
                        <button type="submit"
                                class="candidate-email-send">
                            Send email
                        </button>
                    </div>
                </form>
            </dialog>

            <dialog id="interview-room-@candidate.TutorId"
                    class="admin-application-modal interview-room-modal"
                    data-interview-room-modal
                    data-parent-modal-id="interview-candidate-@candidate.TutorId"
                    data-show="@((Model.OpenInterviewRoomCandidateId == candidate.TutorId).ToString().ToLowerInvariant())"
                    aria-labelledby="interview-room-title-@candidate.TutorId">
                <button type="button"
                        class="admin-modal-close"
                        data-admin-modal-close
                        aria-label="Close">&times;</button>

                <header class="interview-room-header">
                    <h2 id="interview-room-title-@candidate.TutorId">Interview Room</h2>
                    <p>@candidate.DisplayName · @candidate.ProgrammeName</p>
                </header>

                <form method="post"
                      asp-page-handler="SaveInterviewNotes"
                      class="interview-room-form">
                    <input type="hidden" name="tutorId" value="@candidate.TutorId" />
                    <input type="hidden" name="Search" value="@Model.Search" />

                    @if (Model.OpenInterviewRoomCandidateId == candidate.TutorId &&
                        !string.IsNullOrWhiteSpace(Model.InterviewRoomMessage))
                    {
                        @await Html.PartialAsync(
                            "_CampusAlert",
                            new CampusAlertViewModel(Model.InterviewRoomMessage))
                    }

                    <label for="interview-notes-@candidate.TutorId">
                        <span>Interview notes</span>
                        <small>Internal notes recorded during the interview.</small>
                    </label>
                    <textarea id="interview-notes-@candidate.TutorId"
                              name="InterviewNotes"
                              maxlength="4000"
                              rows="14"
                              data-interview-notes
                              data-character-count-id="interview-notes-count-@candidate.TutorId"
                              placeholder="Record the candidate's responses, strengths, concerns and follow-up points...">@candidate.InterviewNotes</textarea>
                    <div class="interview-room-note-meta">
                        <span>Only administrators can view these notes.</span>
                        <span id="interview-notes-count-@candidate.TutorId">@((candidate.InterviewNotes?.Length ?? 0).ToString()) / 4000</span>
                    </div>

                    <footer class="interview-room-footer">
                        <button type="button"
                                class="interview-room-back"
                                data-interview-room-back>
                            Back to candidate
                        </button>
                        <button type="submit" class="interview-room-save">
                            Save notes
                        </button>
                    </footer>
                </form>
            </dialog>
        }
    }

    @if (Model.Stage == "placement")
    {
        <partial name="/Pages/Administrator/_AddTutorModal.cshtml" model="Model" />
    }
</section>

@section Scripts {
    <script src="~/js/components/pagination.js" asp-append-version="true"></script>
    <script src="~/js/admin-application-selection.js" asp-append-version="true"></script>
    <script src="~/js/admin-applications.js" asp-append-version="true"></script>
}
