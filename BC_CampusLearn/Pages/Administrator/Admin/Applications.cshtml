@page
@model BC_CampusLearn.Pages.Administrator.Admin.ApplicationsModel

@{
    ViewData["Title"] = "Applications";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin-applications.css"
          asp-append-version="true" />
}

<section class="admin-applications" aria-labelledby="applications-title">
    <div class="admin-applications-heading">
        <h1 id="applications-title">Applications</h1>
    </div>

    <div class="applications-toolbar">
        <form method="post"
              asp-page-handler="Settings"
              class="applications-toggle-form"
              data-application-settings-form>
            <input type="hidden" name="Stage" value="@Model.Stage" />
            <input type="hidden" name="Search" value="@Model.Search" />
            <label class="applications-toggle">
                <span>Open applications</span>
                <input type="checkbox"
                       name="isOpen"
                       value="true"
                       checked="@Model.OpenApplications"
                       data-applications-toggle />
                <span class="applications-toggle-track" aria-hidden="true">
                    <span></span>
                </span>
            </label>
            <input type="hidden" name="isOpen" value="false" />
        </form>

        <form method="get" class="applications-search-form" role="search">
            <input type="hidden" name="Stage" value="@Model.Stage" />
            <div class="applications-search-group">
            <div class="applications-search">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" />
                    <path d="m16 16l5 5" />
                </svg>
                <label class="visually-hidden" asp-for="Search">Search candidates</label>
                <input asp-for="Search" placeholder="Search candidates..." />
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <a asp-page="/Administrator/Admin/Applications"
                       asp-route-Stage="@Model.Stage"
                       class="applications-search-clear"
                       aria-label="Clear candidate search"
                       title="Clear search">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M6 6l12 12M18 6L6 18" />
                        </svg>
                    </a>
                }
            </div>

                <button type="submit" class="applications-search-button">Search</button>
            </div>

            <button type="submit" class="applications-refresh">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M20 6v5h-5M4 18v-5h5M18.5 9A7 7 0 0 0 6.2 6.2L4 8m16 8l-2.2 1.8A7 7 0 0 1 5.5 15" />
                </svg>
                Refresh
            </button>
        </form>
    </div>

    <dialog class="admin-application-modal"
            data-application-settings-modal
            data-show="@Model.ShowApplicationSettingsModal.ToString().ToLowerInvariant()"
            aria-labelledby="application-settings-title">
        <button type="button"
                class="admin-modal-close"
                data-admin-modal-close
                aria-label="Close">&times;</button>
        <h2 id="application-settings-title">Open tutor applications</h2>
        <p>Set the application window and the number of candidates you want to shortlist.</p>
        <form method="post"
              asp-page-handler="Settings"
              data-cycle-settings-form>
            <input type="hidden" name="Stage" value="@Model.Stage" />
            <input type="hidden" name="Search" value="@Model.Search" />
            <input type="hidden" name="isOpen" value="true" />
            <div class="admin-application-settings-grid">
                <label>
                    <span>Students to shortlist</span>
                    <input type="number"
                           name="shortlistLimit"
                           min="1"
                           value="@Model.ShortlistLimit"
                           required />
                </label>
                <label>
                    <span>Opening date</span>
                    <input type="date"
                           name="openDate"
                           data-cycle-open-date
                           value="@(Model.ApplicationOpenDate?.ToString("yyyy-MM-dd") ?? DateTime.UtcNow.ToString("yyyy-MM-dd"))"
                           required />
                </label>
                <label>
                    <span>Closing date</span>
                    <input type="date"
                           name="closeDate"
                           data-cycle-close-date
                           min="@DateTime.UtcNow.ToString("yyyy-MM-dd")"
                           value="@(Model.ApplicationCloseDate?.ToString("yyyy-MM-dd") ?? DateTime.UtcNow.AddMonths(1).ToString("yyyy-MM-dd"))"
                           required />
                </label>
            </div>
            <span class="admin-modal-validation" data-cycle-validation>
                @(Model.ShowApplicationSettingsModal ? Model.PageError : null)
            </span>
            <div class="admin-modal-actions">
                <button type="button"
                        class="admin-modal-no-target"
                        data-admin-modal-close>Cancel</button>
                <button type="submit">Open applications</button>
            </div>
        </form>
    </dialog>

    <dialog class="admin-application-modal"
            data-shortlist-threshold-modal
            data-show="@Model.ShowShortlistThresholdModal.ToString().ToLowerInvariant()"
            aria-labelledby="shortlist-threshold-title">
        <h2 id="shortlist-threshold-title">Shortlist target reached</h2>
        <p>
            You have shortlisted @Model.ShortlistLimit candidates. Do you want to continue
            shortlisting beyond this target?
        </p>
        <div class="admin-modal-actions">
            <button type="button"
                    class="admin-modal-no-target"
                    data-admin-modal-close>Stop for now</button>
            <form method="post" asp-page-handler="ContinueShortlisting">
                <input type="hidden" name="Search" value="@Model.Search" />
                <button type="submit">Continue shortlisting</button>
            </form>
        </div>
    </dialog>

    @if (Model.ShowReviewResultModal &&
        !string.IsNullOrWhiteSpace(Model.PageMessage))
    {
        <dialog class="admin-application-modal application-result-modal"
                data-review-result-modal
                data-show="true"
                aria-labelledby="application-result-title">
            <button type="button"
                    class="admin-modal-close"
                    data-admin-modal-close
                    aria-label="Close">&times;</button>
            <h2 id="application-result-title">Application rejected</h2>
            <div class="admin-modal-actions">
                <button type="button"
                        class="application-result-button"
                        data-admin-modal-close>
                    Continue reviewing applications
                </button>
            </div>
        </dialog>
    }

    @if (!Model.ShowReviewResultModal &&
        !string.IsNullOrWhiteSpace(Model.PageMessage))
    {
        <div class="applications-notice" role="status">@Model.PageMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.PageError))
    {
        <div class="applications-notice applications-notice--error" role="alert">@Model.PageError</div>
    }

    <nav class="application-stage-tabs" aria-label="Application stages">
        <a asp-page="/Administrator/Admin/Applications"
           asp-route-Stage="applications"
           asp-route-Search="@Model.Search"
           class="application-stage-tab @(Model.Stage == "applications" ? "is-active" : null)"
           aria-current="@(Model.Stage == "applications" ? "page" : null)">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M14.5 5h-2c-2.828 0-4.243 0-5.121.879C6.5 6.757 6.5 8.172 6.5 11v5c0 2.828 0 4.243.879 5.121C8.257 22 9.672 22 12.5 22h1.343c.818 0 1.226 0 1.594-.152s.656-.441 1.235-1.02l2.656-2.656c.579-.579.867-.867 1.02-1.235c.152-.368.152-.776.152-1.594V11c0-2.828 0-4.243-.879-5.121C18.743 5 17.328 5 14.5 5M15 21.5v-1c0-1.886 0-2.828.586-3.414S17.114 16.5 19 16.5h1M6.5 19a3 3 0 0 1-3-3V8c0-2.828 0-4.243.879-5.121C5.257 2 6.672 2 9.5 2h5a3 3 0 0 1 3 3m-7.499 8h4m-4-4h7" />
            </svg>
            <span>Applications</span>
            <strong>@Model.ApplicationCount</strong>
        </a>

        <a asp-page="/Administrator/Admin/Applications"
           asp-route-Stage="shortlist"
           asp-route-Search="@Model.Search"
           class="application-stage-tab @(Model.Stage == "shortlist" ? "is-active" : null)"
           aria-current="@(Model.Stage == "shortlist" ? "page" : null)">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="10" cy="7" r="4" />
                <path d="M10 14c-5 0-8 2.5-8 5a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2c0-2.5-3-5-8-5m6-3.167s1.011.338 1.5 1.667c0 0 2.382-3.333 4.5-4" />
            </svg>
            <span>Shortlist</span>
            <strong>@Model.ShortlistCount</strong>
        </a>

        <a asp-page="/Administrator/Admin/Applications"
           asp-route-Stage="interview"
           asp-route-Search="@Model.Search"
           class="application-stage-tab @(Model.Stage == "interview" ? "is-active" : null)"
           aria-current="@(Model.Stage == "interview" ? "page" : null)">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M21.5 12a9.5 9.5 0 0 1-9.5 9.5c-1.628 0-3.16-.41-4.5-1.131c-1.868-1.007-3.125-.071-4.234.097a.53.53 0 0 1-.456-.156a.64.64 0 0 1-.117-.703c.436-1.025.835-2.969.29-4.607a9.5 9.5 0 0 1-.483-3a9.5 9.5 0 1 1 19 0" />
                <path d="M12.126 12H12m-3.876 0H8m8.125 0H16m-3.75 0a.25.25 0 1 1-.5 0a.25.25 0 0 1 .5 0m-4 0a.25.25 0 1 1-.5 0a.25.25 0 0 1 .5 0m8 0a.25.25 0 1 1-.5 0a.25.25 0 0 1 .5 0" />
            </svg>
            <span>Interview</span>
            <strong>@Model.InterviewCount</strong>
        </a>

        <a asp-page="/Administrator/Admin/Applications"
           asp-route-Stage="placement"
           asp-route-Search="@Model.Search"
           class="application-stage-tab @(Model.Stage == "placement" ? "is-active" : null)"
           aria-current="@(Model.Stage == "placement" ? "page" : null)">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M8.5 6.5c0-1.404 0-2.107.337-2.611a2 2 0 0 1 .552-.552C9.893 3 10.596 3 12 3s2.107 0 2.611.337a2 2 0 0 1 .552.552c.337.504.337 1.207.337 2.611M22 14v-.5c0-3.3 0-4.95-1.025-5.975S18.3 6.5 15 6.5H9c-3.3 0-4.95 0-5.975 1.025S2 10.2 2 13.5v.5c0 3.3 0 4.95 1.025 5.975S5.7 21 9 21h6c3.3 0 4.95 0 5.975-1.025S22 17.3 22 14" />
                <path d="M2 11s2.632 4 10 4s10-4 10-4M12.125 11.75H12m.25 0a.25.25 0 1 1-.5 0a.25.25 0 0 1 .5 0" />
            </svg>
            <span>Placement</span>
            <strong>@Model.PlacementCount</strong>
        </a>
    </nav>

    @if (Model.Stage == "placement")
    {
        <div class="placement-actions">
            <button type="button"
                    class="add-tutor-button"
                    data-add-tutor-open>
                <span aria-hidden="true">+</span>
                Add tutor
            </button>
        </div>
    }

    <section class="application-candidate-panel" aria-label="Application candidates">
        <div class="application-table-heading" aria-hidden="true">
            <span>Candidate</span>
            <span>Programme</span>
            <span>Year</span>
            <span>Average</span>
            <span>Modules</span>
            <span>Submitted</span>
            <span>Status</span>
            <span>Action</span>
        </div>

        @if (Model.Candidates.Count == 0)
        {
            <div class="application-empty-state">
                <span class="application-empty-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                        <path d="M3 7h6l2 2h10v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2ZM3 7V5a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v2" />
                    </svg>
                </span>
                <strong>No candidates in @Model.Stage</strong>
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <span>Try a different candidate search.</span>
                }
            </div>
        }
        else
        {
            <div class="application-candidate-list">
                @foreach (var candidate in Model.Candidates)
                {
                    <article class="application-candidate-row">
                        <div class="candidate-identity">
                            <div>
                                <h3>@candidate.DisplayName</h3>
                                <p>@candidate.PersonnelNumber</p>
                            </div>
                        </div>
                        <dl>
                            <div>
                                <dt>Programme</dt>
                                <dd>@candidate.ProgrammeName</dd>
                            </div>
                            <div>
                                <dt>Year</dt>
                                <dd>@candidate.YearOfStudy</dd>
                            </div>
                            <div>
                                <dt>Average</dt>
                                <dd>@candidate.OverallAverage.ToString("0.#")%</dd>
                            </div>
                            <div>
                                <dt>Modules</dt>
                                <dd>@candidate.ModuleCount</dd>
                            </div>
                            <div>
                                <dt>Submitted</dt>
                                <dd>@candidate.SubmittedAt.ToString("dd MMM yyyy")</dd>
                            </div>
                        </dl>
                        <span class="candidate-status candidate-status--@candidate.Status.ToString().ToLowerInvariant()">
                            @candidate.ApplicationStage
                        </span>
                        @if (Model.Stage == "shortlist")
                        {
                            <button type="button"
                                    class="candidate-view-link"
                                    aria-label="View the shortlisted application submitted by @candidate.DisplayName"
                                    aria-haspopup="dialog"
                                    data-shortlist-view
                                    data-shortlist-modal-id="shortlist-candidate-@candidate.TutorId">
                                View
                            </button>
                        }
                        else
                        {
                            <a asp-page="/Administrator/Admin/ApplicationDetails"
                               asp-route-id="@candidate.TutorId"
                               asp-route-stage="@Model.Stage"
                               asp-route-search="@Model.Search"
                               class="candidate-view-link"
                               aria-label="View the application submitted by @candidate.DisplayName">
                                View
                            </a>
                        }
                    </article>
                }
            </div>
        }
    </section>

    @if (Model.Stage == "shortlist")
    {
        @foreach (var candidate in Model.Candidates)
        {
            <dialog id="shortlist-candidate-@candidate.TutorId"
                    class="admin-application-modal shortlist-review-modal"
                    data-shortlist-review-modal
                    data-show="@((Model.OpenShortlistCandidateId == candidate.TutorId).ToString().ToLowerInvariant())"
                    aria-labelledby="shortlist-candidate-title-@candidate.TutorId">
                <button type="button"
                        class="admin-modal-close"
                        data-admin-modal-close
                        aria-label="Close">&times;</button>

                <header class="shortlist-review-header">
                    <span>Shortlisted applicant</span>
                    <h2 id="shortlist-candidate-title-@candidate.TutorId">@candidate.DisplayName</h2>
                    <p>Submitted @candidate.SubmittedAt.ToString("dd MMMM yyyy")</p>
                </header>

                <section class="shortlist-modal-section" aria-labelledby="applicant-details-@candidate.TutorId">
                    <h3 id="applicant-details-@candidate.TutorId">Applicant details</h3>

                    <details class="shortlist-detail-group">
                        <summary>Personal and academic details</summary>
                        <dl class="shortlist-detail-grid">
                            <div><dt>Full name</dt><dd>@candidate.DisplayName</dd></div>
                            <div><dt>Student number</dt><dd>@candidate.PersonnelNumber</dd></div>
                            <div><dt>Email address</dt><dd>@(candidate.Email ?? "Not provided")</dd></div>
                            <div><dt>Phone number</dt><dd>@(candidate.PhoneNumber ?? "Not provided")</dd></div>
                            <div><dt>Programme</dt><dd>@candidate.ProgrammeName</dd></div>
                            <div><dt>Year of study</dt><dd>@candidate.YearOfStudy</dd></div>
                            <div><dt>Overall average</dt><dd>@candidate.OverallAverage.ToString("0.##")%</dd></div>
                            <div><dt>Campus</dt><dd>@candidate.CampusOfStudy</dd></div>
                            <div><dt>Preferred tutoring mode</dt><dd>@candidate.PreferredTutoringModeLabel</dd></div>
                        </dl>
                    </details>

                    <details class="shortlist-detail-group">
                        <summary>Motivation and teaching profile</summary>
                        <dl class="shortlist-written-answers">
                            <div>
                                <dt>Why do you want to become a tutor?</dt>
                                <dd>@candidate.ReasonForTutoring</dd>
                            </div>
                            <div>
                                <dt>How would you describe your teaching style?</dt>
                                <dd>@candidate.TeachingStyle</dd>
                            </div>
                            <div>
                                <dt>Previous tutoring experience</dt>
                                <dd>@candidate.PreviousTutoringExperience</dd>
                            </div>
                            <div>
                                <dt>Demonstration video</dt>
                                <dd>
                                    @if (candidate.HasDemonstrationVideoLink)
                                    {
                                        <a href="@candidate.DemonstrationVideoUrl"
                                           target="_blank"
                                           rel="noopener noreferrer">Open demonstration video</a>
                                    }
                                    else
                                    {
                                        @candidate.DemonstrationVideoUrl
                                    }
                                </dd>
                            </div>
                        </dl>
                    </details>

                    <details class="shortlist-detail-group">
                        <summary>Modules and documents</summary>
                        <div class="shortlist-detail-content">
                            <h4>Selected modules</h4>
                            @if (candidate.Modules.Count == 0)
                            {
                                <p class="shortlist-empty-value">No modules were selected.</p>
                            }
                            else
                            {
                                <ul class="shortlist-module-list">
                                    @foreach (var module in candidate.Modules)
                                    {
                                        <li><strong>@module.Code</strong><span>@module.Name</span></li>
                                    }
                                </ul>
                            }

                            <h4>Submitted documents</h4>
                            @if (candidate.Documents.Count == 0)
                            {
                                <p class="shortlist-empty-value">No documents were submitted.</p>
                            }
                            else
                            {
                                <ul class="shortlist-document-list">
                                    @foreach (var document in candidate.Documents)
                                    {
                                        <li>
                                            <span>
                                                <strong>@ApplicationsModel.GetDocumentTypeLabel(document.DocumentType)</strong>
                                                <small>@document.OriginalFileName</small>
                                            </span>
                                            <a asp-page="/Administrator/Admin/ApplicationDetails"
                                               asp-page-handler="Document"
                                               asp-route-id="@candidate.TutorId"
                                               asp-route-documentId="@document.TutorDocumentId">
                                                Download
                                            </a>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </details>
                </section>

                <section class="shortlist-modal-section shortlist-decision-history"
                         aria-labelledby="decision-history-@candidate.TutorId">
                    <h3 id="decision-history-@candidate.TutorId">Decision history</h3>
                    @if (candidate.DecisionHistory.Count == 0)
                    {
                        <p class="shortlist-history-empty">No decisions have been recorded.</p>
                    }
                    else
                    {
                        <ol class="shortlist-timeline">
                            @foreach (var decision in candidate.DecisionHistory)
                            {
                                <li>
                                    <span class="shortlist-timeline-marker" aria-hidden="true"></span>
                                    <div>
                                        <header>
                                            <strong>@decision.Label</strong>
                                            <time datetime="@decision.ReviewedAt.ToString("O")">
                                                @decision.ReviewedAt.ToString("dd MMM yyyy 'at' HH:mm")
                                            </time>
                                        </header>
                                        <p>@decision.Notes</p>
                                        <small>By @decision.AdminName</small>
                                    </div>
                                </li>
                            }
                        </ol>
                    }
                </section>

                <section class="shortlist-modal-section"
                         aria-labelledby="interview-preparation-@candidate.TutorId">
                    <h3 id="interview-preparation-@candidate.TutorId">Prepare for interview</h3>
                    <form method="post"
                          class="shortlist-interview-form"
                          data-shortlist-action-form>
                        <input type="hidden" name="tutorId" value="@candidate.TutorId" />
                        <input type="hidden" name="Search" value="@Model.Search" />
                        <label for="interview-notes-@candidate.TutorId">
                            Interview preparation notes
                        </label>
                        <textarea id="interview-notes-@candidate.TutorId"
                                  name="InterviewPreparation.Notes"
                                  rows="4"
                                  maxlength="1000"
                                  placeholder="Add optional notes for the interview panel.">@candidate.InterviewPreparationNotes</textarea>

                        <div class="shortlist-schedule-grid">
                            <label>
                                <span>Interview date</span>
                                <input type="date"
                                       name="InterviewPreparation.ScheduledDate"
                                       value="@candidate.InterviewScheduledAt?.ToString("yyyy-MM-dd")" />
                            </label>
                            <label>
                                <span>Time</span>
                                <input type="time"
                                       name="InterviewPreparation.ScheduledTime"
                                       value="@candidate.InterviewScheduledAt?.ToString("HH:mm")" />
                            </label>
                            <label>
                                <span>Duration</span>
                                <select name="InterviewPreparation.DurationMinutes">
                                    <option value="">Select duration</option>
                                    @foreach (int duration in new[] { 15, 30, 45, 60, 90, 120 })
                                    {
                                        <option value="@duration"
                                                selected="@(candidate.InterviewDurationMinutes == duration)">
                                            @duration minutes
                                        </option>
                                    }
                                </select>
                            </label>
                            <label>
                                <span>Assigned interviewer</span>
                                <input type="text"
                                       name="InterviewPreparation.AssignedInterviewer"
                                       maxlength="200"
                                       value="@candidate.AssignedInterviewer"
                                       placeholder="Name or interview panel" />
                            </label>
                            <label class="shortlist-schedule-wide">
                                <span>Location or meeting link</span>
                                <input type="text"
                                       name="InterviewPreparation.LocationOrMeetingLink"
                                       maxlength="500"
                                       value="@candidate.InterviewLocation"
                                       placeholder="Room, campus, or online meeting link" />
                            </label>
                        </div>

                        <div class="shortlist-modal-actions">
                            <button type="submit"
                                    class="shortlist-reject-button"
                                    asp-page-handler="RejectShortlisted"
                                    data-reject-shortlisted>
                                Reject
                            </button>
                            <button type="button"
                                    class="shortlist-communicate-button"
                                    aria-disabled="true"
                                    title="Communication tools are coming soon">
                                Communicate
                            </button>
                            <button type="submit"
                                    class="shortlist-save-button"
                                    asp-page-handler="SaveInterviewPreparation">
                                Save notes
                            </button>
                            <button type="submit"
                                    class="shortlist-interview-button"
                                    asp-page-handler="MoveToInterview">
                                Move to interview
                            </button>
                        </div>
                    </form>
                </section>
            </dialog>
        }
    }

    @if (Model.Stage == "placement")
    {
        <dialog class="admin-application-modal admin-add-tutor-modal"
                data-add-tutor-modal
                aria-labelledby="add-tutor-title">
            <button type="button"
                    class="admin-modal-close"
                    data-admin-modal-close
                    aria-label="Close">&times;</button>
            <h2 id="add-tutor-title">Add tutor</h2>
            <p>Select a student and enter the details needed to create their tutor profile.</p>
            <form method="post" asp-page-handler="AddTutor">
                <div class="admin-add-tutor-grid">
                    <div class="admin-add-tutor-field admin-add-tutor-field--full">
                        <label for="manual-student-search">Student</label>
                        <span class="admin-student-picker" data-student-picker>
                            <input id="manual-student-search"
                                   type="search"
                                   placeholder="Search by name or student number"
                                   autocomplete="off"
                                   aria-label="Search eligible students"
                                   aria-controls="eligible-student-results"
                                   aria-expanded="false"
                                   data-student-search />
                            <input asp-for="ManualTutor.BcUserId"
                                   type="hidden"
                                   data-student-id />
                            <span id="eligible-student-results"
                                  class="admin-student-results"
                                  role="listbox"
                                  data-student-results
                                  hidden>
                                @foreach (SelectListItem student in Model.StudentOptions)
                                {
                                    <button type="button"
                                            role="option"
                                            data-student-option
                                            data-student-id="@student.Value"
                                            data-search-text="@student.Text.ToLowerInvariant()">
                                        @student.Text
                                    </button>
                                }
                                <span class="admin-student-empty"
                                      data-student-empty
                                      hidden>
                                    No matching students found.
                                </span>
                            </span>
                        </span>
                    </div>
                    <label class="admin-add-tutor-field admin-add-tutor-field--full">
                        <span>Programme</span>
                        <select asp-for="ManualTutor.ProgrammeId"
                                asp-items="Model.ProgrammeOptions"
                                required>
                            <option value="">Select a programme</option>
                        </select>
                    </label>
                    <label class="admin-add-tutor-field">
                        <span>Year of study</span>
                        <input asp-for="ManualTutor.YearOfStudy"
                               type="number" min="1" max="4" required />
                    </label>
                    <label class="admin-add-tutor-field">
                        <span>Overall average</span>
                        <input asp-for="ManualTutor.OverallAverage"
                               type="number" min="0" max="100" step="0.01" required />
                    </label>
                    <label class="admin-add-tutor-field">
                        <span>Campus</span>
                        <input asp-for="ManualTutor.CampusOfStudy" required />
                    </label>
                    <label class="admin-add-tutor-field">
                        <span>Phone number</span>
                        <input asp-for="ManualTutor.PhoneNumber" type="tel" />
                    </label>
                    <label class="admin-add-tutor-field admin-add-tutor-field--full">
                        <span>Preferred tutoring mode</span>
                        <select asp-for="ManualTutor.PreferredTutoringMode"
                                asp-items="Html.GetEnumSelectList<PreferredTutoringMode>()"></select>
                    </label>
                </div>
                <div class="admin-modal-actions">
                    <button type="submit">Add tutor</button>
                </div>
            </form>
        </dialog>
    }
</section>

@section Scripts {
    <script src="~/js/admin-applications.js" asp-append-version="true"></script>
}
