@page
@model BC_CampusLearn.Pages.Administrator.Admin.DashboardModel

@{
    ViewData["Title"] = "Admin dashboard";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin-dashboard.css"
          asp-append-version="true" />
}

<section class="admin-dashboard" aria-labelledby="admin-dashboard-title">
    <header class="admin-dashboard-header">
        <h1 id="admin-dashboard-title">Welcome to Admin Dashboard</h1>
    </header>

    <div class="admin-stat-grid" aria-label="Administration statistics">
        <article class="admin-stat-card">
            <div class="admin-stat-icon admin-stat-icon--tutors" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M0 0h24v24H0z" fill="none" stroke="none" />
                    <path d="M8.5 3.708A2.5 2.5 0 0 0 6 8m-2.625 8.5C2.615 16.5 2 15.859 2 15.068c0-1.61 1.667-3.219 4.5-3.528m9-7.832A2.5 2.5 0 0 1 18 8m2.625 8.5c.76 0 1.375-.642 1.375-1.433c0-1.609-1.666-3.218-4.5-3.527M12 11.5a3 3 0 1 0 0-6a3 3 0 0 0 0 6Zm0 3c-3.75 0-6 2.143-6 4.286c0 .947.672 1.714 1.5 1.714h9c.828 0 1.5-.767 1.5-1.714c0-2.143-2.25-4.286-6-4.286Z" />
                </svg>
            </div>
            <div class="admin-stat-content">
                <h2>Active tutors</h2>
                <p>@Model.ActiveTutorCount</p>
            </div>
        </article>

        <article class="admin-stat-card">
            <div class="admin-stat-icon admin-stat-icon--resources" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M0 0h24v24H0z" fill="none" stroke="none" />
                    <path d="M8.5 4h10a1 1 0 0 1 1 1v15a1 1 0 0 1-1 1h-11a3 3 0 0 1-3-3V8a4 4 0 0 1 4-4Z" />
                    <path d="M4.5 17.5c.7-1.5 1.9-2.25 3.5-2.25h11.5M9 8h7m-7 4h5" />
                </svg>
            </div>
            <div class="admin-stat-content">
                <h2>Tutor resources</h2>
                <p>@Model.TutorResourceCount</p>
            </div>
        </article>

        <article class="admin-stat-card">
            <div class="admin-stat-icon admin-stat-icon--requests" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M0 0h24v24H0z" fill="none" stroke="none" />
                    <circle cx="12" cy="7" r="4" />
                    <path d="M12 14c-5 0-8 2.5-8 5a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2c0-2.5-3-5-8-5Z" />
                    <path d="M20 6v4m0 3v.01" />
                </svg>
            </div>
            <div class="admin-stat-content">
                <h2>Pending admin requests</h2>
                <p>@Model.PendingAdminRequestCount</p>
            </div>
        </article>

        <article class="admin-stat-card">
            <div class="admin-stat-icon admin-stat-icon--sessions" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M0 0h24v24H0z" fill="none" stroke="none" />
                    <path d="M3 21v-8h4v8m3 0V3h4v18m3 0V8h4v13M2 21h20" />
                </svg>
            </div>
            <div class="admin-stat-content">
                <h2>Total completed sessions</h2>
                <p>@Model.CompletedSessionCount</p>
            </div>
        </article>
    </div>
</section>
