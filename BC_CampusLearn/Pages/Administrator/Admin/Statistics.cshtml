@page
@model BC_CampusLearn.Pages.Administrator.Admin.StatisticsModel
@using BC_CampusLearn.Models.Entities
@{
    ViewData["Title"] = "Statistics";
    string StatusLabel(BookingStatus status) => status == BookingStatus.InProgress
        ? "In progress" : status.ToString();
    string campusChartLabel = "Tutors by campus: " + string.Join(", ",
        Model.TutorsByCampus.Select(campus => $"{campus.Campus}, {campus.TutorCount}"));
    int campusAxisIntervals = Model.MaxCampusTutorCount == 0
        ? 1
        : Math.Min(4, Model.MaxCampusTutorCount);
    int campusAxisStep = Model.MaxCampusTutorCount == 0
        ? 1
        : (int)Math.Ceiling(Model.MaxCampusTutorCount / (double)campusAxisIntervals);
    int campusAxisMaximum = campusAxisIntervals * campusAxisStep;
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-statistics.css" asp-append-version="true" />
}

<section class="admin-dashboard admin-statistics" aria-labelledby="admin-statistics-title">
    <header class="admin-statistics-header">
        <div>
            <h1 id="admin-statistics-title">Statistics</h1>
        </div>
    </header>

    <div class="admin-statistics-kpis" aria-label="Key platform figures">
        <article class="admin-statistics-kpi">
            <span class="admin-statistics-kpi-icon is-plum" aria-hidden="true"><svg viewBox="0 0 24 24">
                    <path d="M0 0h24v24H0z" fill="none" stroke="none" />
                    <path d="M8.5 3.708A2.5 2.5 0 0 0 6 8m-2.625 8.5C2.615 16.5 2 15.859 2 15.068c0-1.61 1.667-3.219 4.5-3.528m9-7.832A2.5 2.5 0 0 1 18 8m2.625 8.5c.76 0 1.375-.642 1.375-1.433c0-1.609-1.666-3.218-4.5-3.527M12 11.5a3 3 0 1 0 0-6a3 3 0 0 0 0 6Zm0 3c-3.75 0-6 2.143-6 4.286c0 .947.672 1.714 1.5 1.714h9c.828 0 1.5-.767 1.5-1.714c0-2.143-2.25-4.286-6-4.286Z" />
                </svg></span>
            <div><h2>Active tutors</h2><strong>@Model.ActiveTutorCount</strong></div>
        </article>
        <article class="admin-statistics-kpi">
            <span class="admin-statistics-kpi-icon is-blue" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M0 0h24v24H0z" fill="none" stroke="none" />
                <path d="M9.542 4.652L6.983 5.924C3.661 7.576 2 8.402 2 9.75s1.661 2.174 4.983 3.826l2.559 1.272c1.209.601 1.814.902 2.458.902s1.249-.3 2.458-.902l2.559-1.272C20.339 11.924 22 11.098 22 9.75s-1.661-2.174-4.983-3.826l-2.559-1.272C13.25 4.051 12.644 3.75 12 3.75s-1.249.3-2.458.902ZM6 13.25v3.807c0 .092 0 .137.002.18c.029.706.42 1.347 1.03 1.689a22 22 0 0 0 .813.407a9.88 9.88 0 0 0 8.31 0c.16-.074.325-.157.656-.325c.08-.041.12-.061.158-.082c.61-.342 1-.983 1.03-1.69l.001-.179V13.25m4-3.5v6.5" />
            </svg></span>
            <div><h2>Modules covered</h2><strong>@Model.CoveredModuleCount <span>/ @Model.TotalModuleCount</span></strong></div>
        </article>
        <article class="admin-statistics-kpi">
            <span class="admin-statistics-kpi-icon is-green" aria-hidden="true"><i class="bi bi-check-circle"></i></span>
            <div><h2>Completed sessions</h2><strong>@Model.CompletedSessionCount</strong></div>
        </article>
        <article class="admin-statistics-kpi">
            <span class="admin-statistics-kpi-icon is-orange" aria-hidden="true"><i class="bi bi-mortarboard"></i></span>
            <div><h2>Total students</h2><strong>@Model.TotalStudentCount</strong></div>
        </article>
    </div>

    <div class="admin-statistics-panels">
        <section class="admin-statistics-panel" aria-labelledby="assignment-title">
            <div class="admin-statistics-panel-heading">
                <h2 id="assignment-title">Tutors assigned by module</h2>
                @if (Model.AssignedModules.Count > 0)
                {
                    <button type="button" class="admin-statistics-see-all" data-bs-toggle="modal"
                            data-bs-target="#all-assigned-modules-modal">See all</button>
                }
            </div>
            @if (Model.AssignedModules.Count == 0)
            {
                <p class="admin-statistics-empty">No modules currently have an active tutor.</p>
            }
            else
            {
                <ul class="admin-statistics-assignments">
                    @foreach (var module in Model.TopAssignedModules)
                    {
                        <li>
                            <div>
                                <strong>@module.Name</strong>
                                <small>@module.Code</small>
                            </div>
                            <span>@module.ActiveTutors @(module.ActiveTutors == 1 ? "tutor" : "tutors")</span>
                        </li>
                    }
                </ul>
            }
        </section>
        <section class="admin-statistics-panel" aria-labelledby="booked-modules-title">
            <div class="admin-statistics-panel-heading">
                <div>
                    <h2 id="booked-modules-title">Most booked modules</h2>
                    <p>@Model.TotalBookedSessions completed @(Model.TotalBookedSessions == 1 ? "booking" : "bookings")</p>
                </div>
                @if (Model.TopBookedModules.Count > 0)
                {
                    <button type="button" class="admin-statistics-see-all" data-bs-toggle="modal"
                            data-bs-target="#all-booked-modules-modal">See all</button>
                }
            </div>
            @if (Model.TopBookedModules.Count == 0)
            {
                <p class="admin-statistics-empty">No completed module bookings yet.</p>
            }
            else
            {
                int largestTopModuleCount = Model.TopBookedModules.Max(module => module.Count);
                <ol class="admin-statistics-ranked-modules" aria-label="Most booked modules ranked by bookings">
                    @for (int index = 0; index < Model.TopBookedModules.Count; index++)
                    {
                        var module = Model.TopBookedModules[index];
                        double relativeWidth = module.Count * 100d / largestTopModuleCount;
                        <li>
                            <span class="admin-statistics-ranked-module-name">@module.Name</span>
                            <div class="admin-statistics-ranked-track" aria-hidden="true">
                                <span style="width: @relativeWidth.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)%; background-color: @module.Color"></span>
                            </div>
                            <span class="admin-statistics-ranked-value">
                                <strong>@module.Count</strong>
                                <small>@module.Percentage.ToString("0.#")%</small>
                            </span>
                        </li>
                    }
                </ol>
            }
        </section>
    </div>

    <div class="admin-statistics-progress-row">
        <section class="admin-statistics-panel admin-statistics-review-panel" aria-labelledby="review-progress-title">
            <div class="admin-statistics-panel-heading">
                <h2 id="review-progress-title">Review progress</h2>
                <button type="button" class="admin-statistics-filter-button"
                        data-bs-target="#review-progress-filter-modal" data-bs-toggle="modal">
                    <i class="bi bi-funnel" aria-hidden="true"></i>
                    Filter
                </button>
            </div>
            <section class="admin-statistics-review-group" aria-labelledby="review-overview-title">
                <h3 id="review-overview-title">Overview</h3>
                <div class="admin-statistics-review-overview">
                    <div>
                        <strong>@Model.UniqueBookingStudentCount</strong>
                        <p>unique students with completed sessions</p>
                    </div>
                    <div>
                        <strong>
                            <span>@(Model.AverageTutorRating?.ToString("0.0") ?? "—")<small>@(Model.AverageTutorRating.HasValue ? " / 5" : "")</small></span>
                            @if (Model.AverageTutorRating.HasValue) { <i class="bi bi-star-fill" aria-hidden="true"></i> }
                        </strong>
                        <p>average tutoring rating</p>
                    </div>
                    <div>
                        <strong>
                            <span>@(Model.AveragePlatformRating?.ToString("0.0") ?? "—")<small>@(Model.AveragePlatformRating.HasValue ? " / 5" : "")</small></span>
                            @if (Model.AveragePlatformRating.HasValue) { <i class="bi bi-star-fill" aria-hidden="true"></i> }
                        </strong>
                        <p>average platform rating</p>
                    </div>
                </div>
            </section>
            <section class="admin-statistics-review-group" aria-labelledby="review-queue-title">
                <h3 id="review-queue-title">Approval queue</h3>
                <div class="admin-statistics-review-queue">
                    <div>
                        <span><strong>@Model.AwaitingAdminReviewCount</strong> Awaiting admin review</span>
                        <small>Student, tutor, and Tutor Head reviews are all submitted.</small>
                    </div>
                    <div>
                        <span><strong>@Model.PendingTutorReviewCount</strong> Awaiting tutor review</span>
                        <small>Completed sessions without a tutor review.</small>
                    </div>
                    <div>
                        <span><strong>@Model.PendingTutorHeadReviewCount</strong> Awaiting Tutor Head review</span>
                        <small>Student and tutor reviews are complete and ready for approval.</small>
                    </div>
                </div>
            </section>
        </section>

        <section class="admin-statistics-panel admin-statistics-outcomes-panel" aria-labelledby="outcomes-title">
            <div class="admin-statistics-panel-heading">
                <h2 id="outcomes-title">Session outcomes</h2>
            </div>
            @if (Model.OutcomeSessionCount == 0)
            {
                <p class="admin-statistics-empty">No sessions have been recorded yet.</p>
            }
            else
            {
                <div class="admin-statistics-outcomes">
                    @foreach (var status in Model.SessionStatuses)
                    {
                        <div class="admin-statistics-outcome">
                            <div><span>@StatusLabel(status.Status)</span><strong>@status.Count</strong></div>
                            <div class="admin-statistics-outcome-track"><span style="width: @(status.Count * 100d / Model.OutcomeSessionCount)%; background-color: @status.Color"></span></div>
                        </div>
                    }
                </div>
            }
        </section>
    </div>

</section>
<div class="modal fade" id="all-assigned-modules-modal" tabindex="-1"
     aria-labelledby="all-assigned-modules-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
        <div class="modal-content admin-statistics-modal">
            <div class="modal-header">
                <h2 class="modal-title" id="all-assigned-modules-title">All tutor assignments by module</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="admin-statistics-assignment-overview">
                    <section class="admin-statistics-module-list" aria-labelledby="module-assignments-title">
                        <div class="admin-statistics-modal-section-heading">
                            <h3 id="module-assignments-title">Tutors assigned by module</h3>
                        </div>
                        <div class="admin-statistics-module-search">
                            <label for="module-assignment-search">Search for a module</label>
                            <div>
                                <i class="bi bi-search" aria-hidden="true"></i>
                                <input id="module-assignment-search" type="search"
                                       placeholder="Search modules"
                                       autocomplete="off" data-module-assignment-search />
                            </div>
                        </div>
                        <div class="table-responsive admin-statistics-module-table-scroll">
                            <table class="admin-statistics-module-table">
                                <thead>
                                    <tr>
                                        <th scope="col">Module name</th>
                                        <th scope="col">Total tutors</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var module in Model.AssignedModules)
                                    {
                                        <tr data-module-assignment-row
                                            data-search-text="@($"{module.Name} {module.Code}".ToLowerInvariant())">
                                            <td>@module.Name</td>
                                            <td>@module.ActiveTutors</td>
                                        </tr>
                                    }
                                    <tr class="admin-statistics-module-search-empty" data-module-assignment-empty hidden>
                                        <td colspan="2">No modules match your search.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </section>
                    <section class="admin-statistics-campus-section" aria-labelledby="campus-tutors-title">
                        <div class="admin-statistics-modal-section-heading">
                            <h3 id="campus-tutors-title">Total tutors per campus</h3>
                        </div>
                        @if (Model.TutorsByCampus.Count == 0)
                        {
                            <p class="admin-statistics-empty">No active tutors to display.</p>
                        }
                        else
                        {
                            <div class="admin-statistics-campus-chart-layout">
                                <span class="admin-statistics-campus-y-axis">Tutors per campus</span>
                                <div class="admin-statistics-campus-chart-scroll">
                                    <div class="admin-statistics-campus-chart" role="img" aria-label="@campusChartLabel">
                                        <div class="admin-statistics-campus-plot">
                                            <div class="admin-statistics-campus-grid" aria-hidden="true">
                                                @for (int index = campusAxisIntervals; index >= 0; index--)
                                                {
                                                    <div>
                                                        <span>@(index * campusAxisStep)</span>
                                                        <i></i>
                                                    </div>
                                                }
                                            </div>
                                            <div class="admin-statistics-campus-bars" aria-hidden="true"
                                                 style="grid-template-columns: repeat(@Model.TutorsByCampus.Count, minmax(4rem, 1fr));">
                                                @foreach (var campus in Model.TutorsByCampus)
                                                {
                                                    double barHeight = campus.TutorCount * 100d / campusAxisMaximum;
                                                    <div class="admin-statistics-campus-bar">
                                                        <div style="height: @barHeight.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)%">
                                                            <strong>@campus.TutorCount</strong>
                                                            <span style="background-color: @campus.Color"></span>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <div class="admin-statistics-campus-labels"
                                             style="grid-template-columns: repeat(@Model.TutorsByCampus.Count, minmax(4rem, 1fr));">
                                            @foreach (var campus in Model.TutorsByCampus)
                                            {
                                                <span>@campus.Campus</span>
                                            }
                                        </div>
                                        <span class="admin-statistics-campus-x-axis">Campus</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </section>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="all-booked-modules-modal" tabindex="-1"
     aria-labelledby="all-booked-modules-title" aria-hidden="true"
     data-auto-open="@Model.ShowBookedModules.ToString().ToLowerInvariant()">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
        <div class="modal-content admin-statistics-modal">
            <div class="modal-header">
                <div class="admin-statistics-modal-title-stack">
                    <h2 class="modal-title" id="all-booked-modules-title">All booked modules</h2>
                    <button type="button" class="admin-statistics-filter-button"
                            data-bs-target="#booked-modules-filter-modal" data-bs-toggle="modal">
                        <i class="bi bi-funnel" aria-hidden="true"></i>
                        Filter
                    </button>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (Model.BookedModules.Count == 0)
                {
                    <p class="admin-statistics-empty">No completed module bookings yet.</p>
                }
                else
                {
                    int largestModuleCount = Model.BookedModules.Max(module => module.Count);
                    <div class="admin-statistics-booked-overview">
                        <section class="admin-statistics-top-tutors" aria-labelledby="top-completed-tutors-title">
                            <div class="admin-statistics-modal-section-heading">
                                <div>
                                    <h3 id="top-completed-tutors-title">Top tutors by completed bookings</h3>
                                </div>
                            </div>
                            @if (Model.TopCompletedTutors.Count == 0)
                            {
                                <p class="admin-statistics-empty">No completed tutor bookings to display.</p>
                            }
                            else
                            {
                                <div class="admin-statistics-tutor-pie-layout">
                                    <div class="admin-statistics-tutor-pie"
                                         style="background: @Model.TopCompletedTutorPieGradient"
                                         role="img" aria-label="Top five tutors by completed bookings"></div>
                                    <ul class="admin-statistics-tutor-pie-legend">
                                        @foreach (var tutor in Model.TopCompletedTutors)
                                        {
                                            <li>
                                                <span style="background-color: @tutor.Color" aria-hidden="true"></span>
                                                <span>@tutor.Name</span>
                                                <strong>@tutor.Count</strong>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </section>
                        <section class="admin-statistics-booked-browser" aria-labelledby="booked-module-list-title">
                            <div class="admin-statistics-modal-section-heading admin-statistics-booked-browser-heading">
                                <div>
                                    <h3 id="booked-module-list-title">Most booked modules</h3>
                                    <p>@Model.FilteredBookedSessionCount completed @(Model.FilteredBookedSessionCount == 1 ? "booking" : "bookings") · @Model.BookingPeriodLabel</p>
                                </div>
                                <div class="admin-statistics-module-search admin-statistics-booked-module-search">
                                    <label for="booked-module-search">Search for a module</label>
                                    <div>
                                        <i class="bi bi-search" aria-hidden="true"></i>
                                        <input id="booked-module-search" type="search"
                                               placeholder="Search modules"
                                               autocomplete="off" data-booked-module-search />
                                    </div>
                                </div>
                            </div>
                            <hr class="admin-statistics-booked-divider" />
                            <div class="admin-statistics-booked-module-results">
                                <ol class="admin-statistics-ranked-modules admin-statistics-ranked-modules--all"
                                    aria-label="All modules ranked by bookings">
                                    @for (int index = 0; index < Model.BookedModules.Count; index++)
                                    {
                                        var module = Model.BookedModules[index];
                                        double relativeWidth = module.Count * 100d / largestModuleCount;
                                        <li data-booked-module-row
                                            data-search-text="@($"{module.Name} {module.Code}".ToLowerInvariant())">
                                            <span class="admin-statistics-ranked-module-name">
                                                @module.Name <small>@module.Code</small>
                                            </span>
                                            <div class="admin-statistics-ranked-track" aria-hidden="true">
                                                <span style="width: @relativeWidth.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)%; background-color: @module.Color"></span>
                                            </div>
                                            <span class="admin-statistics-ranked-value">
                                                <strong>@module.Count</strong>
                                                <small>@module.Percentage.ToString("0.#")%</small>
                                            </span>
                                        </li>
                                    }
                                </ol>
                                <p class="admin-statistics-empty" data-booked-module-empty hidden>
                                    No modules match your search.
                                </p>
                            </div>
                        </section>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="booked-modules-filter-modal" tabindex="-1"
     aria-labelledby="booked-modules-filter-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content admin-statistics-modal">
            <form method="get">
                <input type="hidden" name="ShowBookedModules" value="true" />
                <input type="hidden" name="ReviewPeriod" value="@Model.ReviewPeriod" />
                <input type="hidden" name="ReviewStartDate" value="@Model.ReviewStartDate?.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="ReviewEndDate" value="@Model.ReviewEndDate?.ToString("yyyy-MM-dd")" />
                <div class="modal-header">
                    <h2 class="modal-title" id="booked-modules-filter-title">Filter completed bookings</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body admin-statistics-filter-form">
                    <div>
                        <label asp-for="BookingPeriod">Period</label>
                        <select asp-for="BookingPeriod" data-booking-period-select>
                            <option value="all">All</option>
                            <option value="monthly">Monthly</option>
                            <option value="weekly">Weekly</option>
                            <option value="daily">Daily</option>
                            <option value="custom">Customize</option>
                        </select>
                    </div>
                    <div class="admin-statistics-custom-dates" data-booking-custom-dates
                         hidden="@(Model.BookingPeriod != "custom" ? "hidden" : null)">
                        <div>
                            <label asp-for="BookingStartDate">Start date</label>
                            <input asp-for="BookingStartDate" type="date" />
                        </div>
                        <div>
                            <label asp-for="BookingEndDate">End date</label>
                            <input asp-for="BookingEndDate" type="date" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light"
                            data-bs-target="#all-booked-modules-modal" data-bs-toggle="modal">Cancel</button>
                    <button type="submit" class="btn admin-statistics-apply-filter">Apply filter</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="review-progress-filter-modal" tabindex="-1"
     aria-labelledby="review-progress-filter-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content admin-statistics-modal">
            <form method="get">
                <input type="hidden" name="BookingPeriod" value="@Model.BookingPeriod" />
                <input type="hidden" name="BookingStartDate" value="@Model.BookingStartDate?.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="BookingEndDate" value="@Model.BookingEndDate?.ToString("yyyy-MM-dd")" />
                <div class="modal-header">
                    <h2 class="modal-title" id="review-progress-filter-title">Filter review progress</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body admin-statistics-filter-form">
                    <div>
                        <label asp-for="ReviewPeriod">Period</label>
                        <select asp-for="ReviewPeriod" data-review-period-select>
                            <option value="all">All</option>
                            <option value="monthly">Monthly</option>
                            <option value="weekly">Weekly</option>
                            <option value="daily">Daily</option>
                            <option value="custom">Customize</option>
                        </select>
                    </div>
                    <div class="admin-statistics-custom-dates" data-review-custom-dates
                         hidden="@(Model.ReviewPeriod != "custom" ? "hidden" : null)">
                        <div>
                            <label asp-for="ReviewStartDate">Start date</label>
                            <input asp-for="ReviewStartDate" type="date" />
                        </div>
                        <div>
                            <label asp-for="ReviewEndDate">End date</label>
                            <input asp-for="ReviewEndDate" type="date" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn admin-statistics-apply-filter">Apply filter</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-statistics.js" asp-append-version="true"></script>
}
