@page "{id:int}"
@model BC_CampusLearn.Pages.Administrator.Tutors.SeniorTutorApplicationDetailsModel
@using BC_CampusLearn.Models.Entities
@using System.Text.Json
@{
    ViewData["Title"] = "Senior Tutor Application";
    var application = Model.Application;
    var tutor = application.Tutor;
    var applicantName = string.IsNullOrWhiteSpace(tutor.BcUser.DisplayName)
        ? tutor.BcUser.PersonnelNumber ?? "Tutor"
        : tutor.BcUser.DisplayName;
    var statusClass = application.Status.ToString().ToLowerInvariant();
    var nameParts = applicantName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var applicantInitials = nameParts.Length switch
    {
        > 1 => $"{nameParts[0][0]}{nameParts[^1][0]}".ToUpperInvariant(),
        1 => nameParts[0][..1].ToUpperInvariant(),
        _ => "T"
    };
    string outcomeLabels = JsonSerializer.Serialize(
        Model.SessionStatuses.Select(item => item.Status.ToString()));
    string outcomeValues = JsonSerializer.Serialize(
        Model.SessionStatuses.Select(item => item.Count));
    string ratingLabels = JsonSerializer.Serialize(
        Model.RatingDistribution.Select(item =>
            item.Rating == 1 ? "1 star" : $"{item.Rating} stars"));
    string ratingValues = JsonSerializer.Serialize(
        Model.RatingDistribution.Select(item => item.Count));
    string moduleLabels = JsonSerializer.Serialize(
        Model.TopModules.Select(item => item.Code));
    string moduleValues = JsonSerializer.Serialize(
        Model.TopModules.Select(item => item.SessionCount));
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-tutors.css" asp-append-version="true" />
}

<section class="admin-dashboard admin-senior-review-page"
         aria-labelledby="senior-application-title">
    <header class="admin-senior-review-header">
        <div>
            <h1 id="senior-application-title">@applicantName</h1>
            <p>Submitted @application.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.ReviewError))
    {
        @await Html.PartialAsync("_CampusAlert", new CampusAlertViewModel(
            Model.ReviewError,
            CampusAlertVariant.Danger))
    }

    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

    <div class="admin-senior-review-layout">
        <main class="admin-senior-review-main">
            <section class="admin-senior-panel" aria-labelledby="application-answers-title">
                <div class="admin-senior-section-heading admin-senior-answers-heading">
                    <div>
                        <h2 id="application-answers-title">Application answers</h2>
                        <p>The information submitted by the tutor.</p>
                    </div>
                    <span class="admin-tutor-status admin-senior-status--@statusClass">
                        @application.Status
                    </span>
                </div>
                <dl class="admin-senior-answer-summary">
                    <div>
                        <dt>Application type</dt>
                        <dd>@(application.IsHeadOfTutorApplication ? "Senior Tutor and Head of Tutor" : "Senior Tutor")</dd>
                    </div>
                    <div>
                        <dt>Academic average</dt>
                        <dd>@application.AcademicAverage.ToString("0.##")%</dd>
                    </div>
                    <div>
                        <dt>Additional modules for 2027</dt>
                        <dd>
                            @if (application.RequestedModules.Count == 0)
                            {
                                <span>None requested</span>
                            }
                            else
                            {
                                @string.Join(", ", application.RequestedModules
                                    .OrderBy(item => item.ProgrammeModule.ModuleCode)
                                    .Select(item => $"{item.ProgrammeModule.ModuleCode} — {item.ProgrammeModule.ModuleName}"))
                            }
                        </dd>
                    </div>
                    @if (application.IsHeadOfTutorApplication)
                    {
                        <div>
                            <dt>Best description</dt>
                            <dd>@application.BestDescription</dd>
                        </div>
                    }
                </dl>
                @if (application.IsHeadOfTutorApplication)
                {
                    <div class="admin-senior-written-answer">
                        <h3>Why do you think you are a suitable candidate for the Head of Tutor role?</h3>
                        <p>@application.SuitabilityReason</p>
                    </div>
                }
            </section>

            <section class="admin-senior-panel admin-senior-analytics"
                     aria-labelledby="performance-title">
                <div class="admin-senior-section-heading">
                    <div>
                        <h2 id="performance-title">Tutor performance</h2>
                    </div>
                </div>

                <div class="admin-senior-chart-grid">
                    <article class="admin-senior-chart-card admin-senior-chart-card--wide">
                        <div>
                            <h3>Activity overview</h3>
                            <p>Completed sessions, tutoring hours, and unique tutees.</p>
                        </div>
                        <div class="admin-senior-activity-metrics">
                            <div class="admin-senior-activity-metric">
                                <strong>@Model.CompletedSessions</strong>
                                <span>Completed sessions</span>
                            </div>
                            <div class="admin-senior-activity-metric">
                                <strong>@Model.TotalTutoringHours.ToString("0.#") <small>hrs</small></strong>
                                <span>Tutoring hours</span>
                            </div>
                            <div class="admin-senior-activity-metric">
                                <strong>@Model.UniqueTutees</strong>
                                <span>Tutees</span>
                            </div>
                        </div>
                    </article>

                    <article class="admin-senior-chart-card">
                        <div>
                            <h3>Session outcomes</h3>
                            <p>@Model.CompletionRate.ToString("0.#")% completion rate</p>
                        </div>
                        @if (Model.SessionStatuses.Sum(item => item.Count) == 0)
                        {
                            <p class="admin-senior-empty">No concluded sessions are available.</p>
                        }
                        else
                        {
                            <div class="admin-senior-chart-wrap">
                                <canvas data-senior-outcomes-chart data-labels="@outcomeLabels"
                                        data-values="@outcomeValues" role="img"
                                        aria-label="Completed, cancelled, and declined session outcomes"></canvas>
                            </div>
                        }
                    </article>

                    <article class="admin-senior-chart-card">
                        <div>
                            <h3>Student ratings</h3>
                            <div class="admin-senior-average-rating"
                                 aria-label="@(Model.AverageRating.HasValue ? $"Average rating {Model.AverageRating.Value:0.0} out of 5 from {Model.RatingCount} ratings" : "No student ratings yet")">
                                <span class="admin-senior-rating-stars" aria-hidden="true">
                                    @for (var star = 1; star <= 5; star++)
                                    {
                                        var starFill = Math.Clamp(
                                            ((Model.AverageRating ?? 0) - (star - 1)) * 100,
                                            0,
                                            100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
                                        <span style="--star-fill: @starFill%">★</span>
                                    }
                                </span>
                                <small>
                                    @(Model.AverageRating.HasValue
                                        ? $"{Model.AverageRating.Value:0.0} · {Model.RatingCount} {(Model.RatingCount == 1 ? "rating" : "ratings")}"
                                        : "No ratings yet")
                                </small>
                            </div>
                        </div>
                        @if (Model.RatingCount == 0)
                        {
                            <p class="admin-senior-empty">No rating data is available.</p>
                        }
                        else
                        {
                            <div class="admin-senior-chart-wrap">
                                <canvas data-senior-ratings-chart data-labels="@ratingLabels"
                                        data-values="@ratingValues" role="img"
                                        aria-label="Student rating distribution chart"></canvas>
                            </div>
                        }
                    </article>

                    <article class="admin-senior-chart-card admin-senior-chart-card--wide">
                        <div>
                            <h3>Top tutored modules</h3>
                            <p>Completed sessions across the tutor's most active modules.</p>
                        </div>
                        @if (Model.TopModules.Count == 0)
                        {
                            <p class="admin-senior-empty">No completed sessions are available.</p>
                        }
                        else
                        {
                            <div class="admin-senior-chart-wrap admin-senior-chart-wrap--bar">
                                <canvas data-senior-modules-chart data-labels="@moduleLabels"
                                        data-values="@moduleValues" role="img"
                                        aria-label="Top tutored modules chart"></canvas>
                            </div>
                        }
                    </article>
                </div>
            </section>
        </main>

        <aside class="admin-senior-review-sidebar">
            <section class="admin-senior-panel" aria-labelledby="applicant-details-title">
                <h2 id="applicant-details-title">Applicant details</h2>
                <div class="admin-senior-applicant-photo">
                    @if (!string.IsNullOrWhiteSpace(tutor.ProfileImagePath))
                    {
                        <img src="@tutor.ProfileImagePath" alt="Profile photo of @applicantName" />
                    }
                    else
                    {
                        <span aria-label="@applicantName initials">@applicantInitials</span>
                    }
                </div>
                <dl class="admin-senior-applicant-details">
                    <div><dt>Student number</dt><dd>@(tutor.BcUser.PersonnelNumber ?? "Not provided")</dd></div>
                    <div><dt>Email</dt><dd>@(tutor.BcUser.Email ?? "Not provided")</dd></div>
                    <div><dt>Programme</dt><dd>@tutor.Programme.Name</dd></div>
                    <div><dt>Year of study</dt><dd>@tutor.YearOfStudy</dd></div>
                    <div><dt>Campus</dt><dd>@tutor.CampusOfStudy</dd></div>
                    <div><dt>Tutor academic average</dt><dd>@tutor.OverallAverage.ToString("0.##")%</dd></div>
                    <div><dt>Active modules</dt><dd>@tutor.TutorCourseModules.Count</dd></div>
                </dl>
                <a asp-page="Profile" asp-route-id="@tutor.TutorId"
                   class="admin-senior-profile-link">View full tutor profile</a>
            </section>

            <section class="admin-senior-panel admin-senior-decision-panel"
                     aria-labelledby="decision-title">
                <h2 id="decision-title">Application decision</h2>
                @if (application.Status == TutorAccountRequestStatus.Pending &&
                    (!application.IsHeadOfTutorApplication || Model.CanReviewHeadApplication))
                {
                    <p>Review the application and performance statistics before making a final decision.</p>
                    <form id="senior-application-decision-form" method="post"
                          asp-page-handler="Review" asp-route-id="@application.SeniorTutorApplicationId">
                        <label asp-for="ReviewNote">
                            Internal decision note
                            <span>Required when rejecting</span>
                        </label>
                        <textarea asp-for="ReviewNote" rows="4" maxlength="500"
                                  placeholder="Add an internal note for administrators"
                                  aria-describedby="review-note-validation"></textarea>
                        <span asp-validation-for="ReviewNote" id="review-note-validation"
                              class="text-danger" data-review-note-validation></span>
                        <div class="admin-senior-decision-actions">
                            <button type="button" class="admin-senior-reject-button"
                                    data-senior-reject-trigger
                                    aria-controls="reject-senior-application-modal">Reject</button>
                            @if (application.IsHeadOfTutorApplication)
                            {
                                <button type="button" class="admin-senior-accept-button"
                                        data-bs-toggle="modal" data-bs-target="#approve-senior-application-modal">Accept</button>
                            }
                            else
                            {
                                <button type="submit" name="approve" value="true"
                                        class="admin-senior-accept-button">Accept</button>
                            }
                        </div>
                    </form>
                }
                else
                {
                    @if (application.Status == TutorAccountRequestStatus.Pending)
                    {
                        <p>A Super Admin must review this combined Senior Tutor and Head of Tutor application.</p>
                    }
                    <dl class="admin-senior-decision-details">
                        <div><dt>Decision</dt><dd>@application.Status</dd></div>
                        @if (application.IsHeadOfTutorApplication)
                        {
                            <div><dt>Head of Tutor decision</dt><dd>@(application.HeadOfTutorApproved.HasValue
                                ? application.HeadOfTutorApproved.Value ? "Approved" : "Declined"
                                : "Pending")</dd></div>
                        }
                        <div><dt>Reviewed by</dt><dd>@(application.ReviewedBy ?? "Administrator")</dd></div>
                        <div><dt>Reviewed</dt><dd>@application.ReviewedAt?.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</dd></div>
                        @if (!string.IsNullOrWhiteSpace(application.ReviewNote))
                        {
                            <div><dt>Decision note</dt><dd>@application.ReviewNote</dd></div>
                        }
                    </dl>
                }
            </section>
        </aside>
    </div>
</section>

@if (application.Status == TutorAccountRequestStatus.Pending)
{
    @if (application.IsHeadOfTutorApplication && Model.CanReviewHeadApplication)
    {
        <div class="modal fade" id="approve-senior-application-modal" tabindex="-1"
             aria-labelledby="approve-senior-application-title" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content admin-senior-reject-modal">
                    <div class="modal-header">
                        <h2 class="modal-title" id="approve-senior-application-title">Review application</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p>Select the roles you would like to approve for @applicantName.</p>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   id="approve-senior-toggle" name="approveSenior" value="true"
                                   form="senior-application-decision-form" />
                            <label class="form-check-label" for="approve-senior-toggle">Approve Senior Tutor</label>
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" role="switch"
                                   id="approve-head-toggle" name="approveHead" value="true"
                                   form="senior-application-decision-form" disabled />
                            <label class="form-check-label" for="approve-head-toggle">Also approve Head of Tutor</label>
                        </div>
                        <input type="hidden" name="approveHead" value="false" form="senior-application-decision-form" />
                    </div>
                    <div class="modal-footer">
                        <p id="senior-approval-summary" class="w-100 text-start mb-2" aria-live="polite" hidden></p>
                        <button type="button" class="admin-senior-reject-button"
                                data-senior-reject-trigger aria-controls="reject-senior-application-modal">Reject both</button>
                        <button type="submit" form="senior-application-decision-form"
                                name="approve" value="true" data-senior-approve-confirm
                                class="admin-senior-accept-button" disabled>Confirm approval</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal fade" id="confirm-head-approval-modal" tabindex="-1"
             aria-labelledby="confirm-head-approval-title" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content admin-senior-reject-modal">
                    <div class="modal-header">
                        <h2 class="modal-title" id="confirm-head-approval-title">Approve Senior Tutor and Head of Tutor?</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p>This will approve @applicantName's Senior Tutor and Head of Tutor applications and appoint them to the Head of Tutor role.</p>
                        <p>The tutor will be notified once you confirm.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Back</button>
                        <button type="button" class="admin-senior-accept-button" data-head-selection-confirm>Approve both</button>
                    </div>
                </div>
            </div>
        </div>
    }
    <div class="modal fade" id="reject-senior-application-modal" tabindex="-1"
         aria-labelledby="reject-senior-application-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content admin-senior-reject-modal">
                <div class="modal-header">
                    <h2 class="modal-title" id="reject-senior-application-title">@(application.IsHeadOfTutorApplication ? "Reject both applications?" : "Reject this application?")</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>This will reject @applicantName's @(application.IsHeadOfTutorApplication ? "Senior Tutor and Head of Tutor applications" : "Senior Tutor application") and notify the tutor.</p>
                    <p>The tutor will remain in the programme. Their account and application history will be kept.</p>
                    <label for="senior-rejection-note" class="form-label">Internal reason for rejection</label>
                    <textarea id="senior-rejection-note" class="form-control" rows="3" maxlength="500"
                              aria-describedby="senior-rejection-error"
                              placeholder="Record the reason for administrators only">@Model.ReviewNote</textarea>
                    <p class="form-text">This reason is internal and will not be shared with the tutor.</p>
                    <span id="senior-rejection-error" class="text-danger" aria-live="polite"></span>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" form="senior-application-decision-form"
                            name="approve" value="false"
                            data-senior-reject-confirm
                            class="admin-senior-reject-button">Confirm rejection</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js"></script>
    <script src="~/js/admin-senior-tutor-application.js" asp-append-version="true"></script>
}
