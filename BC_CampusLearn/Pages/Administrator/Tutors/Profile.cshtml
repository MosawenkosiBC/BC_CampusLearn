@page "{id:int}"
@model BC_CampusLearn.Pages.Administrator.Tutors.ProfileModel
@{
    ViewData["Title"] = "Tutor Profile";
    var tutor = Model.Tutor;
    var displayName = string.IsNullOrWhiteSpace(tutor.BcUser.DisplayName) ? tutor.BcUser.PersonnelNumber : tutor.BcUser.DisplayName;
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-tutors.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-tutor-profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/pagination.css" asp-append-version="true" />
}
<section class="admin-profile-page" aria-labelledby="admin-tutor-profile-title">
    <header class="admin-profile-heading admin-dashboard-header">
        <h1 id="admin-tutor-profile-title">Tutor Profile</h1>
        <div class="admin-profile-actions">
            <div class="admin-profile-date-filter">
                <nav class="admin-rating-periods" aria-label="Profile date range">
                    @foreach (var period in new[] { "day", "week", "month" })
                    {
                        <a asp-page="Profile" asp-route-id="@tutor.TutorId" asp-route-period="@period"
                           class="@(Model.Period == period ? "is-selected" : null)" aria-current="@(Model.Period == period ? "page" : null)">@(char.ToUpperInvariant(period[0]) + period.Substring(1))</a>
                    }
                    <button type="button" class="@(Model.Period == "custom" ? "is-selected" : null)"
                            data-bs-toggle="modal" data-bs-target="#custom-date-modal" aria-haspopup="dialog">Custom</button>
                </nav>
                <p class="admin-profile-muted admin-rating-date">@Model.PeriodLabel</p>
                @if (Model.DateFilterError is not null)
                {
                    <p class="admin-profile-date-error" role="alert">@Model.DateFilterError</p>
                }
            </div>
            <a asp-page="Profile" asp-route-id="@tutor.TutorId" asp-route-period="@Model.Period"
               asp-route-startDate="@(Model.Period == "custom" ? Model.StartDate?.ToString("yyyy-MM-dd") : null)"
               asp-route-endDate="@(Model.Period == "custom" ? Model.EndDate?.ToString("yyyy-MM-dd") : null)"
               asp-route-sessionPage="@Model.SessionPage" class="admin-profile-refresh"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Refresh</a>
        </div>
    </header>
    <div class="modal fade" id="custom-date-modal" tabindex="-1" aria-labelledby="custom-date-title" aria-hidden="true"
         data-date-error="@(Model.DateFilterError is not null ? "true" : "false")">
        <div class="modal-dialog modal-dialog-centered">
            <form method="get" asp-page="Profile" asp-route-id="@tutor.TutorId" class="modal-content" id="custom-date-form">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="custom-date-title">Custom date range</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="admin-profile-muted">Filter all stats and activity. Both dates are included.</p>
                    <input type="hidden" name="Period" value="custom" />
                    <div class="mb-3"><label asp-for="StartDate" class="form-label">From</label><input asp-for="StartDate" class="form-control" type="date" min="0001-01-02" max="9999-12-30" required /></div>
                    <div><label asp-for="EndDate" class="form-label">To</label><input asp-for="EndDate" class="form-control" type="date" min="0001-01-02" max="9999-12-30" required /></div>
                    @if (Model.DateFilterError is not null)
                    {
                        <p class="admin-profile-date-error" role="alert">@Model.DateFilterError</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="admin-profile-refresh border-0">Apply dates</button>
                </div>
            </form>
        </div>
    </div>
    <div class="admin-profile-layout">
        <aside class="admin-profile-personal admin-profile-panel" aria-label="Tutor personal details">
            <div class="admin-profile-identity">
                @if (!string.IsNullOrWhiteSpace(tutor.ProfileImagePath))
                {
                    <img src="@tutor.ProfileImagePath" alt="Profile photo of @displayName" />
                }
                else
                {
                    <div class="admin-profile-avatar" aria-hidden="true"><i class="bi bi-person"></i></div>
                }
                <h2>@displayName</h2>
            </div>
            <dl class="admin-profile-fields">
                @foreach (var field in new[] {
                    (Label: "Student number", Value: tutor.BcUser.PersonnelNumber, Copy: true),
                    (Label: "Student email", Value: tutor.BcUser.Email, Copy: true),
                    (Label: "Phone number", Value: tutor.PhoneNumber, Copy: true),
                    (Label: "Year of study", Value: tutor.YearOfStudy.ToString(), Copy: false),
                    (Label: "Programme", Value: tutor.Programme.Name, Copy: false),
                    (Label: "Campus", Value: tutor.CampusOfStudy, Copy: false) })
                {
                    <div>
                        <dt>@field.Label</dt>
                        <dd><span>@(string.IsNullOrWhiteSpace(field.Value) ? "Not provided" : field.Value)</span>
                            @if (field.Copy && !string.IsNullOrWhiteSpace(field.Value))
                            {
                                <button type="button" class="admin-profile-copy" data-copy-value="@field.Value" aria-label="Copy @field.Label"><i class="bi bi-copy" aria-hidden="true"></i></button>
                            }
                        </dd>
                    </div>
                }
            </dl>
            <p class="admin-profile-copy-status" role="status" aria-live="polite"></p>
            <span class="admin-tutor-status">@tutor.Status · @(tutor.IsActive ? "Active" : "Inactive")</span>
        </aside>
        <div class="admin-profile-content">
            <div class="admin-profile-stats">
                <article class="admin-profile-stat admin-profile-panel"><i class="bi bi-chat-dots" aria-hidden="true"></i><h2>Pending Student reviews</h2><strong>@Model.PendingStudentReviews</strong></article>
                <article class="admin-profile-stat admin-profile-panel"><i class="bi bi-chat-square-text" aria-hidden="true"></i><h2>Pending Tutor Reviews</h2><strong>@Model.PendingTutorReviews</strong></article>
                <article class="admin-profile-stat admin-profile-panel"><i class="bi bi-person-check" aria-hidden="true"></i><h2>Total Completed Sessions</h2><strong>@Model.CompletedSessions</strong></article>
            </div>
            <section id="recent-sessions" class="admin-profile-sessions admin-profile-panel" aria-labelledby="recent-sessions-title">
                <h2 id="recent-sessions-title">Recent sessions</h2>
                <div class="admin-profile-table-wrap" role="region" aria-label="Recent sessions table" tabindex="0">
                    <table class="admin-profile-table">
                        <thead><tr><th scope="col">Student</th><th scope="col">Module</th><th scope="col">Date</th><th scope="col">Status</th><th scope="col">Admin Approval</th><th scope="col">Action</th></tr></thead>
                        <tbody>
                            @foreach (var session in Model.RecentSessions)
                            {
                                <tr>
                                    <td>@session.StudentName</td>
                                    <td>@session.ProgrammeModule.ModuleCode</td>
                                    <td>@session.ScheduledStartTime.ToOffset(TimeSpan.FromHours(2)).ToString("dd MMM yyyy, HH:mm")</td>
                                    <td><span class="admin-tutor-status @(session.Status == BC_CampusLearn.Models.Entities.BookingStatus.Cancelled ? "admin-session-cancelled" : null)">@session.Status</span></td>
                                    <td>@(session.AdminSessionReview is not null ? "Yes" : "No")</td>
                                    <td><a asp-page="SessionDetails" asp-route-id="@session.BookingId" class="admin-session-details-link" aria-label="View details for @session.StudentName">View details</a></td>
                                </tr>
                            }
                            @if (Model.RecentSessions.Count == 0)
                            {
                                <tr><td colspan="6" class="admin-profile-empty">No sessions in this period.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.TotalSessionPages > 1)
                {
                    @await Component.InvokeAsync("Pagination", new {
                        currentPage = Model.SessionPage,
                        totalPages = Model.TotalSessionPages,
                        pageRouteValueName = "SessionPage",
                        fragment = "recent-sessions",
                        ariaLabel = "Recent sessions pages"
                    })
                }
            </section>
            <details id="ratings" class="admin-profile-ratings admin-profile-panel" open>
                <summary id="ratings-title">Statistics</summary>
                <div class="admin-ratings-body">
                <div class="admin-profile-stars" aria-label="@(Model.AverageRating.HasValue ? $"{Model.AverageRating.Value:0.0} out of 5 stars" : "No ratings in this period")">
                    @for (int star = 1; star <= 5; star++)
                    {
                        <i class="bi @(Model.AverageRating >= star ? "bi-star-fill" : "bi-star")" aria-hidden="true"></i>
                    }
                </div>
                @if (Model.AverageRating.HasValue)
                {
                    <p>
                        @Model.AverageRating.Value.ToString("0.0") out of 5 ·
                        @Model.ReviewCount @(Model.ReviewCount == 1 ? "review" : "reviews")
                    </p>
                }
                else
                {
                    <p class="admin-profile-muted">No student ratings in this period.</p>
                }
                <figure class="admin-module-chart" aria-labelledby="module-chart-title">
                    <figcaption id="module-chart-title">Completed sessions by module</figcaption>
                    @if (Model.TopModules.Count == 0)
                    {
                        <p class="admin-chart-empty">No completed sessions in this period.</p>
                    }
                    else
                    {
                        var slices = Model.TopModules.Select(module => (module.Code, module.Name, module.Count)).ToList();
                        var otherCount = Model.CompletedSessions - slices.Sum(slice => slice.Count);
                        if (otherCount > 0)
                        {
                            slices.Add(("Other", "Remaining modules", otherCount));
                        }
                        var colors = new[] { "#4f87a5", "#dc9344", "#6c9b71", "#9273b1", "#c46678", "#889399" };
                        <div class="admin-module-pie-layout">
                        <div class="admin-module-pie-wrapper">
                        <svg class="admin-module-pie" viewBox="0 0 240 240" role="group" aria-label="Completed sessions by module pie chart">
                            @{ double angle = -Math.PI / 2; }
                            @for (var index = 0; index < slices.Count; index++)
                            {
                                var slice = slices[index];
                                var share = (double)slice.Count / Model.CompletedSessions;
                                var endAngle = angle + share * 2 * Math.PI;
                                var tooltip = $"{slice.Code}: {(share * 100).ToString("0.#")}%";
                                var path = FormattableString.Invariant($"M 120 120 L {120 + 118 * Math.Cos(angle)} {120 + 118 * Math.Sin(angle)} A 118 118 0 {(share > .5 ? 1 : 0)} 1 {120 + 118 * Math.Cos(endAngle)} {120 + 118 * Math.Sin(endAngle)} Z");
                                <g class="admin-module-slice" tabindex="0" role="img" aria-label="@tooltip" data-pie-tooltip="@tooltip" fill="@colors[index]">
                                    @if (slices.Count == 1)
                                    {
                                        <circle cx="120" cy="120" r="118" />
                                    }
                                    else
                                    {
                                        <path d="@path" />
                                    }
                                </g>
                                angle = endAngle;
                            }
                        </svg>
                        <div class="admin-module-tooltip" role="tooltip" hidden></div>
                        </div>
                        <ul class="admin-module-legend" id="module-pie-legend">
                            @for (var index = 0; index < slices.Count; index++)
                            {
                                var slice = slices[index];
                                <li>
                                    <span class="admin-module-swatch" style="background: @colors[index]" aria-hidden="true"></span>
                                    <span class="admin-module-label">@slice.Code<span>@slice.Name</span></span>
                                    <span class="admin-module-share"><strong>@slice.Count</strong></span>
                                </li>
                            }
                        </ul>
                        </div>
                        <p class="admin-profile-muted admin-module-total">@Model.CompletedSessions completed sessions</p>
                    }
                </figure>
                </div>
            </details>
            <details class="admin-profile-about admin-profile-panel">
                <summary>About this tutor</summary>
                <h2>Biography</h2><p class="admin-tutor-bio">@(string.IsNullOrWhiteSpace(tutor.Biography) ? "No biography provided." : tutor.Biography)</p>
                <h2>Teaching style</h2><p class="admin-tutor-bio">@tutor.TeachingStyle</p>
                <h2>Assigned modules</h2>
                @if (tutor.TutorCourseModules.Count == 0) { <p>No modules assigned.</p> }
                <ul>@foreach (var module in tutor.TutorCourseModules.OrderBy(item => item.ProgrammeModule.ModuleCode)) { <li>@module.ProgrammeModule.ModuleCode — @module.ProgrammeModule.ModuleName</li> }</ul>
            </details>
        </div>
    </div>
</section>
@section Scripts {
    <script src="~/js/admin-tutor-profile.js" asp-append-version="true"></script>
}

