@model BC_CampusLearn.Models.ViewModels.AdminHeaderViewModel

<header class="admin-topbar">
    <div class="admin-topbar-title">
        <span>Administrator portal</span>
    </div>

    <div class="admin-topbar-actions">
        <div class="dropdown admin-notification-menu">
            <button class="admin-topbar-button"
                    type="button"
                    id="adminNotificationDropdown"
                    data-bs-toggle="dropdown"
                    data-bs-auto-close="outside"
                    aria-expanded="false"
                    aria-label="Administrative notifications, @Model.NotificationCount pending"
                    title="Notifications">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M0 0h24v24H0z" fill="none" />
                    <path fill="currentColor" d="M8.352 20.242A4.63 4.63 0 0 0 12 22a4.63 4.63 0 0 0 3.648-1.758a27.2 27.2 0 0 1-7.296 0M18.75 9v.704c0 .845.24 1.671.692 2.374l1.108 1.723c1.011 1.574.239 3.713-1.52 4.21a25.8 25.8 0 0 1-14.06 0c-1.759-.497-2.531-2.636-1.52-4.21l1.108-1.723a4.4 4.4 0 0 0 .693-2.374V9c0-3.866 3.022-7 6.749-7s6.75 3.134 6.75 7" />
                </svg>
                @if (Model.NotificationCount > 0)
                {
                    <span class="admin-notification-count">
                        @(Model.NotificationCount > 99 ? "99+" : Model.NotificationCount)
                    </span>
                }
            </button>

            <div class="dropdown-menu dropdown-menu-end admin-notification-dropdown"
                 aria-labelledby="adminNotificationDropdown">
                <div class="admin-notification-heading">
                    <strong>Notifications</strong>
                    <span>@Model.NotificationCount pending</span>
                </div>
                <div class="admin-notification-list">
                    @if (Model.IsSuperAdmin)
                    {
                    <a asp-page="/Administrator/Admin/Applications" class="admin-notification-item">
                        <span class="admin-notification-label">Tutor applications
                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M0 0h24v24H0z" fill="none" />
                                <path fill="currentColor" d="M18 7.05a1 1 0 0 0-1-1L9 6a1 1 0 0 0 0 2h5.56l-8.27 8.29a1 1 0 0 0 0 1.42a1 1 0 0 0 1.42 0L16 9.42V15a1 1 0 0 0 1 1a1 1 0 0 0 1-1Z" />
                            </svg>
                        </span>
                        <strong>@Model.PendingTutorApplications</strong>
                    </a>
                    }
                    <a asp-page="/Administrator/Modules/Index" asp-route-Tab="requests" class="admin-notification-item">
                        <span class="admin-notification-label">Module change requests
                            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M0 0h24v24H0z" fill="none" />
                                <path fill="currentColor" d="M18 7.05a1 1 0 0 0-1-1L9 6a1 1 0 0 0 0 2h5.56l-8.27 8.29a1 1 0 0 0 0 1.42a1 1 0 0 0 1.42 0L16 9.42V15a1 1 0 0 0 1 1a1 1 0 0 0 1-1Z" />
                            </svg>
                        </span>
                        <strong>@Model.PendingModuleRequests</strong>
                    </a>
                </div>
                @if (Model.NotificationCount == 0)
                {
                    <p class="admin-notification-empty">You are all caught up.</p>
                }
            </div>
        </div>

        <span class="admin-topbar-divider" aria-hidden="true"></span>

        <div class="dropdown admin-account-menu">
            <button class="admin-account-button"
                    type="button"
                    id="adminAccountDropdown"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    aria-label="Open administrator account menu">
                <span class="admin-account-initials">@Model.Initials</span>
                <span class="admin-account-copy">
                    <strong>@Model.DisplayName</strong>
                </span>
                <svg class="admin-account-chevron"
                     viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="m7 10l5 5l5-5" />
                </svg>
            </button>

            <ul class="dropdown-menu dropdown-menu-end admin-account-dropdown"
                aria-labelledby="adminAccountDropdown">
                <li class="admin-account-identity">
                    <strong>@Model.DisplayName</strong>
                    <span>@Model.RoleName</span>
                </li>
                <li>
                    <form method="post" asp-page="/Account/SignOut">
                        <button type="submit" class="dropdown-item admin-logout-button">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M10 17l5-5l-5-5M15 12H3M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                            </svg>
                            Log out
                        </button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</header>
