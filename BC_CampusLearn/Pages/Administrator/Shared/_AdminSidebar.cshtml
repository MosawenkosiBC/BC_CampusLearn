@{
    string currentPage =
        ViewContext.RouteData.Values["Page"]?.ToString()
        ?? string.Empty;
    bool isDashboard = currentPage.Equals(
        "/Administrator/Admin/Dashboard",
        StringComparison.OrdinalIgnoreCase);
    bool isTutors = currentPage.StartsWith(
        "/Administrator/Tutors/",
        StringComparison.OrdinalIgnoreCase);
}

<aside class="admin-sidebar" aria-label="Administrator navigation">
    <a asp-page="/Administrator/Admin/Dashboard"
       class="admin-sidebar-logo"
       aria-label="Campus Learn admin dashboard">
        <img src="~/Media/common/CampusLearnLogo.png"
             alt=""
             aria-hidden="true" />
    </a>

    <nav class="admin-sidebar-navigation">
        <a asp-page="/Administrator/Admin/Dashboard"
           class="admin-sidebar-link @(isDashboard ? "is-active" : null)"
           aria-current="@(isDashboard ? "page" : null)"
           aria-label="Dashboard"
           data-label="Dashboard">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M0 0h24v24H0z" fill="none" stroke="none" />
                <path d="M21 6.75a3.75 3.75 0 1 0-7.5 0a3.75 3.75 0 0 0 7.5 0Zm-10.5 0a3.75 3.75 0 1 0-7.5 0a3.75 3.75 0 0 0 7.5 0ZM21 17.25a3.75 3.75 0 1 0-7.5 0a3.75 3.75 0 0 0 7.5 0Zm-10.5 0a3.75 3.75 0 1 0-7.5 0a3.75 3.75 0 0 0 7.5 0Z" />
            </svg>
        </a>

        <a asp-page="/Administrator/Tutors/Index"
              class="admin-sidebar-link @(isTutors ? "is-active" : null)"
              aria-current="@(isTutors ? "page" : null)"
              aria-label="Tutors"
              data-label="Tutors">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M0 0h24v24H0z" fill="none" stroke="none" />
