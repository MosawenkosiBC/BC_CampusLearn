@page
@using BC_CampusLearn.Models.Entities
@model BC_CampusLearn.Pages.Administrator.Settings.UsersAccessModel
@{ ViewData["Title"] = "Users and access settings"; }
@section Styles {
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-tutors.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-settings.css" asp-append-version="true" />
}

<main class="admin-settings settings-users-access-page" aria-labelledby="settings-title" data-settings-page>
    <header class="admin-dashboard-header"><h1 id="settings-title">Settings</h1></header>
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        @await Html.PartialAsync("_CampusAlert", new CampusAlertViewModel(Model.SuccessMessage))
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        @await Html.PartialAsync(
            "_CampusAlert",
            new CampusAlertViewModel(Model.ErrorMessage, CampusAlertVariant.Danger))
    }
    <div class="settings-layout">
        <partial name="_SettingsNavigation" />
        <div class="settings-content">
            <section class="settings-section" aria-labelledby="access-title">
                <header class="settings-section-heading">
                    <div><h2 id="access-title">Users and access</h2><p>View administrative users and control privileged roles.</p></div>
                    @if (Model.CanManageAccess)
                    {
                        <button type="button" class="settings-primary-button settings-access-add"
                                data-bs-toggle="modal" data-bs-target="#grant-access-modal"
                                aria-controls="grant-access-modal">Add administrative access</button>
                    }
                </header>

                <div class="admin-tutors-workspace settings-access-workspace">
                    <aside class="admin-tutor-filters" aria-labelledby="access-filter-title">
                        <div class="admin-filter-heading">
                            <h3 id="access-filter-title">Filters</h3>
                            <a asp-page="/Administrator/Settings/UsersAccess">Clear All</a>
                        </div>
                        <form method="get" asp-page="/Administrator/Settings/UsersAccess" asp-fragment="access-results">
                            <div class="admin-filter-group">
                                <label asp-for="SearchTerm">Search users</label>
                                <div class="admin-filter-search">
                                    <input asp-for="SearchTerm" type="search" placeholder="Name, personnel number or email" />
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6" /><path d="m15 15 6 6" /></svg>
                                </div>
                            </div>
                            <fieldset class="admin-filter-years">
                                <legend>Role</legend>
                                <label><input type="checkbox" name="Roles" value="HeadOfTutors" checked="@(Model.Roles.Contains(BcUserRole.HeadOfTutors))" /><span>Head of Tutors</span></label>
                                <label><input type="checkbox" name="Roles" value="Admin" checked="@(Model.Roles.Contains(BcUserRole.Admin))" /><span>Admin</span></label>
                                <label><input type="checkbox" name="Roles" value="SuperAdmin" checked="@(Model.Roles.Contains(BcUserRole.SuperAdmin))" /><span>Super Admin</span></label>
                                <label><input type="checkbox" name="Roles" value="Dev" checked="@(Model.Roles.Contains(BcUserRole.Dev))" /><span>Developer</span></label>
                            </fieldset>
                            <fieldset class="admin-filter-years">
                                <legend>Status</legend>
                                <label><input type="checkbox" name="AccessStatus" value="Active" checked="@(Model.AccessStatus.Contains(UsersAccessModel.AccessStatusFilter.Active))" /><span>Active</span></label>
                                <label><input type="checkbox" name="AccessStatus" value="Inactive" checked="@(Model.AccessStatus.Contains(UsersAccessModel.AccessStatusFilter.Inactive))" /><span>Inactive</span></label>
                            </fieldset>
                            <button type="submit" class="admin-apply-filters">Apply Filters</button>
                        </form>
                    </aside>

                    <div class="admin-tutor-results" id="access-results">
                        <p class="admin-tutor-result-count" role="status">
                            Showing <strong>@Model.AccessUsers.Count</strong> of <strong>@Model.FilteredAccessUsers</strong> users
                        </p>
                        <div class="admin-tutors-table-wrap" role="region" aria-label="Users and access table" tabindex="0">
                            <table class="admin-tutors-table settings-access-table">
                                <caption class="visually-hidden">Users with administrative access</caption>
                                <thead><tr><th scope="col">User</th><th scope="col">Role</th><th scope="col">Status</th><th scope="col">Last login</th><th scope="col">Action</th></tr></thead>
                                <tbody>
                                @foreach (var user in Model.AccessUsers)
                                {
                                    <tr>
                                        <th scope="row" class="settings-access-user"><strong>@user.DisplayName</strong><span>@(user.Email ?? "No email")</span></th>
                                        <td><span class="settings-role">@UsersAccessModel.RoleLabel(user.Role)</span></td>
                                        <td><span class="admin-tutor-status settings-study-area-status @(user.IsActive ? "is-active" : "is-inactive")">@(user.IsActive ? "Active" : "Inactive")</span></td>
                                        <td>@(user.LastLoginAt?.ToString("dd MMM yyyy, HH:mm") ?? "Never")</td>
                                        <td>
                                            @if (Model.CanManageAccess && user.Role != BcUserRole.Dev && user.BcUserId != Model.CurrentUserId)
                                            {
                                                <button type="button" class="settings-access-menu-button"
                                                        data-bs-toggle="modal" data-bs-target="#access-role-modal"
                                                        data-user-id="@user.BcUserId" data-user-name="@user.DisplayName"
                                                        data-user-role="@((int)user.Role)"
                                                        data-demotion-role="@UsersAccessModel.RoleLabel(UsersAccessModel.DemotionRole(user.Role, user.IsTutor))"
                                                        aria-label="Manage access for @user.DisplayName" aria-controls="access-role-modal">
                                                    <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                                @if (Model.AccessUsers.Count == 0)
                                {
                                    <tr><td colspan="5" class="admin-tutors-empty">No users found. Try changing or clearing your filters.</td></tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="settings-permission-skeleton"><div><span class="settings-status">Skeleton</span><h3>Role permissions</h3></div><p>Permission controls for reviewing sessions, approving payments, finalising cycles, marking payments paid, changing rates, reopening cycles and managing administrators will be connected as those workflows are built.</p></div>
            </section>
        </div>
    </div>
</main>
@section Modals {
    @if (Model.CanManageAccess)
    {
        <div class="modal fade settings-grant-access-modal" id="access-role-modal" tabindex="-1"
             aria-labelledby="access-role-title" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title" id="access-role-title">Change role</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body settings-form" data-access-role-choices>
                        <p data-access-role-name></p>
                        <div class="settings-access-actions">
                            <button type="button" class="settings-access-action" data-access-choose="promote">Promote</button>
                            <button type="button" class="settings-access-action settings-access-action--demote" data-access-choose="demote">Demote</button>
                        </div>
                    </div>
                    <form method="post" data-access-role-form hidden
                          data-promote-url="@Url.Page("/Administrator/Settings/UsersAccess", "Promote")"
                          data-demote-url="@Url.Page("/Administrator/Settings/UsersAccess", "Demote")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="userId" data-access-role-user />
                        <div class="modal-body settings-form">
                            <p data-access-role-description></p>
                            <div class="settings-field" data-access-promotion-field>
                                <label for="access-promotion-role">Promote to</label>
                                <select id="access-promotion-role" name="role">
                                    <option value="@BcUserRole.Admin" data-rank="@((int)BcUserRole.Admin)">Admin</option>
                                    <option value="@BcUserRole.SuperAdmin" data-rank="@((int)BcUserRole.SuperAdmin)">Super Admin</option>
                                </select>
                            </div>
                            <div class="settings-field settings-access-action-reason">
                                <label for="access-role-reason">Reason (optional)</label>
                                <input id="access-role-reason" name="reason" maxlength="1000" placeholder="Reason for this role change" />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-access-role-back>Back</button>
                            <button type="submit" class="settings-primary-button" data-access-role-submit>Confirm</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="modal fade settings-grant-access-modal" id="grant-access-modal" tabindex="-1"
             aria-labelledby="grant-access-title" aria-hidden="true" data-settings-modal
             data-open-on-load="@((!ViewData.ModelState.IsValid).ToString().ToLowerInvariant())">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title" id="grant-access-title">Add administrative access</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form method="post" asp-page-handler="GrantAccess" data-access-grant-form>
                        <div class="modal-body settings-form">
                            <div class="settings-field-grid">
                                <div class="settings-field settings-field--wide">
                                    <label asp-for="Input.UserIdentifier"></label>
                                    <input asp-for="Input.UserIdentifier" placeholder="Type a student number or email address"
                                           autocomplete="off" data-access-search
                                           data-search-url="@Url.Page("/Administrator/Settings/UsersAccess", "SearchUsers")"
                                           aria-describedby="access-search-status" aria-controls="access-search-results" />
                                    <input asp-for="Input.UserId" type="hidden" data-access-user-id />
                                    <span asp-validation-for="Input.UserIdentifier"></span>
                                    <p id="access-search-status" class="settings-access-search-status" role="status" aria-live="polite">Type at least two characters to find a user.</p>
                                    <div id="access-search-results" class="settings-access-search-results" aria-label="Matching users" hidden></div>
                                </div>
                                <p class="settings-access-current-role settings-field--wide" data-access-current-role
                                   role="status" hidden="@(Model.SelectedAccessUser is null)">
                                    @if (Model.SelectedAccessUser is { } selected)
                                    {
                                        <text>@selected.DisplayName — Current role: @selected.Role. @(selected.HasAdministrativeAccess ? "Already has administrative access" + (selected.IsActive ? "." : " (inactive).") : "No administrative access assigned.")</text>
                                    }
                                </p>
                                <div class="settings-field settings-field--wide" data-access-grant-role hidden="@(Model.SelectedAccessUser?.Role == "Head of Tutors")"><label asp-for="Input.Role"></label><select asp-for="Input.Role"><option value="@BcUserRole.HeadOfTutors">Head of Tutors</option><option value="@BcUserRole.Admin">Admin</option><option value="@BcUserRole.SuperAdmin">Super Admin</option></select><span asp-validation-for="Input.Role"></span></div>
                                <div class="settings-field settings-field--wide"><label asp-for="Input.Reason"></label><input asp-for="Input.Reason" placeholder="Reason for this access change (optional)" /><span asp-validation-for="Input.Reason"></span></div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" asp-page-handler="RemoveSelectedAccess" class="settings-danger-button"
                                    data-access-remove hidden="@(Model.SelectedAccessUser?.HasAdministrativeAccess != true)">Remove access</button>
                            <button type="submit" class="settings-primary-button" data-access-save hidden="@(Model.SelectedAccessUser?.Role == "Head of Tutors")">@(Model.SelectedAccessUser?.HasAdministrativeAccess == true ? "Update access" : "Grant access")</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/admin-settings.js" asp-append-version="true"></script>
    <script src="~/js/admin-users-access.js" asp-append-version="true"></script>
}
