@page
@model BC_CampusLearn.Pages.Administrator.Settings.BookingsModel
@{
    ViewData["Title"] = "Booking settings";
    bool termsHaveErrors = ViewData.ModelState.TryGetValue(
        "Input.Terms",
        out var termsModelState) &&
        termsModelState.Errors.Count > 0;
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-settings.css" asp-append-version="true" />
}

<main class="admin-settings admin-booking-settings" aria-labelledby="settings-title" data-settings-page>
    <header class="admin-dashboard-header"><h1 id="settings-title">Settings</h1></header>
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        @await Html.PartialAsync("_CampusAlert", new CampusAlertViewModel(Model.SuccessMessage))
    }
    <div class="settings-layout">
        <partial name="_SettingsNavigation" />
        <section class="settings-section" aria-labelledby="bookings-title">
            <header class="settings-section-heading"><div><h2 id="bookings-title">Bookings and sessions</h2></div><span class="settings-status settings-status--live">Live</span></header>
            @if (Model.CanManageTeams)
            {
                <details class="teams-organizer-settings" open="@(ViewData.ModelState.ErrorCount > 0 || Model.TeamsOrganizerConfigurationError is not null || !string.IsNullOrWhiteSpace(Model.TeamsOrganizerMessage))">
                    <summary>Teams meeting account</summary>
                    <p>New pilot sessions are scheduled by this account. The tutor is invited as co-organiser and the student as attendee. Changes apply to new meeting requests only.</p>
                    <p>Shared account routing: <strong>@(Model.SharedOrganizerEnabled ? "Enabled for configured pilot tutors" : "Disabled in server configuration")</strong></p>
                    <p>Current account settings: <strong data-teams-organizer-source>@Model.TeamsOrganizerConfigurationSource</strong></p>
                    <p class="text-danger" role="alert" data-teams-organizer-configuration-error hidden="@(Model.TeamsOrganizerConfigurationError is null)">@Model.TeamsOrganizerConfigurationError</p>
                    <p role="status" aria-live="polite" data-teams-organizer-status hidden="@(string.IsNullOrWhiteSpace(Model.TeamsOrganizerMessage))">@Model.TeamsOrganizerMessage</p>
                    <form method="post" asp-page-handler="SaveTeamsOrganizer" data-teams-organizer-form novalidate>
                        <div asp-validation-summary="All" class="text-danger" role="alert" data-teams-organizer-validation></div>
                        <div class="teams-organizer-fields">
                            <div>
                                <label asp-for="TeamsOrganizer.Email">Account email</label>
                                <input asp-for="TeamsOrganizer.Email" type="email" autocomplete="off" />
                                <span asp-validation-for="TeamsOrganizer.Email" class="text-danger"></span>
                            </div>
                            <div>
                                <label asp-for="TeamsOrganizer.ObjectId">Microsoft Entra Object ID</label>
                                <input asp-for="TeamsOrganizer.ObjectId" autocomplete="off" placeholder="Account Object ID from Microsoft Entra" />
                                <span asp-validation-for="TeamsOrganizer.ObjectId" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="teams-organizer-actions">
                            <button type="submit" asp-page-handler="TestTeamsOrganizer" data-teams-organizer-test>Test calendar connection</button>
                            <button type="submit" asp-page-handler="SaveTeamsOrganizer">Save meeting account</button>
                        </div>
                    </form>
                </details>
            }

            <form method="post" class="settings-form">
                <div asp-validation-summary="ModelOnly" class="settings-validation"></div>
                <div class="settings-subsection-copy settings-terms-heading">
                    <h3>Booking terms and conditions</h3>
                </div>
                <div class="settings-terms-summary">
                    <div class="settings-terms-summary-copy">
                        <strong>Terms and conditions</strong>
                        <p>Open the editor to review or update the current terms.</p>
                    </div>
                    <button type="button"
                            class="settings-primary-button"
                            data-bs-toggle="modal"
                            data-bs-target="#booking-terms-modal">
                        Edit booking terms
                    </button>
                </div>
                <div class="settings-field settings-field--wide settings-booking-support">
                    <label asp-for="Input.SupportEmail"></label>
                    <input asp-for="Input.SupportEmail" type="email" />
                    <small>Used for booking and session support enquiries.</small>
                    <span asp-validation-for="Input.SupportEmail"></span>
                </div>

                <div class="modal fade settings-study-area-modal settings-booking-terms-modal"
                     id="booking-terms-modal"
                     tabindex="-1"
                     aria-labelledby="booking-terms-modal-title"
                     aria-hidden="true"
                     data-settings-modal
                     data-open-on-load="@termsHaveErrors.ToString().ToLowerInvariant()">
                    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                        <div class="modal-content">
                            <div class="modal-header">
                                <div>
                                    <h2 class="modal-title" id="booking-terms-modal-title">Booking terms and conditions</h2>
                                    <p>Enter one condition per line. Blank lines are removed when saved.</p>
                                </div>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body settings-form">
                                <div class="settings-field settings-field--wide">
                                    <label asp-for="Input.Terms"></label>
                                    <textarea asp-for="Input.Terms" rows="15"></textarea>
                                    <span asp-validation-for="Input.Terms"></span>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="settings-secondary-button" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="settings-primary-button">Save changes</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="settings-subsection">
                    <div class="settings-subsection-copy"><h3>Session Review Period</h3></div>
                    <div class="settings-review-table-wrap">
                        <table class="settings-review-table">
                            <thead><tr><th scope="col">Setting</th><th scope="col">Date</th><th scope="col" class="settings-review-toggle-heading">Option</th></tr></thead>
                            <tbody>
                                <tr>
                                    <th scope="row">Tutor Head review deadline<small>Final date for the Tutor Head to complete reviews.</small></th>
                                    <td><div class="settings-field"><label asp-for="Input.ReviewDeadline" class="visually-hidden"></label><input asp-for="Input.ReviewDeadline" type="date" /><span asp-validation-for="Input.ReviewDeadline"></span></div></td>
                                    <td class="settings-review-toggle-cell"><label class="settings-switch settings-table-switch"><input asp-for="Input.IsReviewDeadlineRecurring" /><span aria-hidden="true"></span><strong>Repeat monthly</strong></label></td>
                                </tr>
                                <tr>
                                    <th scope="row">Use the last day of each month<small>Automatically adjusts the deadline to each month's final day.</small></th>
                                    <td class="settings-review-empty-value">—</td>
                                    <td class="settings-review-toggle-cell"><label class="settings-switch settings-table-switch"><input asp-for="Input.UseLastDayOfMonth" /><span aria-hidden="true"></span><strong>Enabled</strong></label></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="settings-subsection">
                    <div class="settings-subsection-copy"><h3>Administrator Review Period</h3></div>
                    <div class="settings-review-table-wrap">
                        <table class="settings-review-table">
                            <thead><tr><th scope="col">Setting</th><th scope="col">Date</th><th scope="col" class="settings-review-toggle-heading">Option</th></tr></thead>
                            <tbody>
                                <tr>
                                    <th scope="row">Review period start date<small>First session date included in the administrator review period.</small></th>
                                    <td><div class="settings-field"><label asp-for="Input.AdminReviewPeriodStartDate" class="visually-hidden"></label><input asp-for="Input.AdminReviewPeriodStartDate" type="date" /><span asp-validation-for="Input.AdminReviewPeriodStartDate"></span></div></td>
                                    <td class="settings-review-toggle-cell"></td>
                                </tr>
                                <tr>
                                    <th scope="row">Administrator review deadline<small>Final date for administrators to complete their reviews.</small></th>
                                    <td><div class="settings-field"><label asp-for="Input.AdminReviewDeadline" class="visually-hidden"></label><input asp-for="Input.AdminReviewDeadline" type="date" /><span asp-validation-for="Input.AdminReviewDeadline"></span></div></td>
                                    <td class="settings-review-toggle-cell"><label class="settings-switch settings-table-switch"><input asp-for="Input.IsAdminReviewDeadlineRecurring" /><span aria-hidden="true"></span><strong>Repeat monthly</strong></label></td>
                                </tr>
                                <tr>
                                    <th scope="row">Use the last day of each month<small>Automatically adjusts the deadline to each month's final day.</small></th>
                                    <td class="settings-review-empty-value">—</td>
                                    <td class="settings-review-toggle-cell"><label class="settings-switch settings-table-switch"><input asp-for="Input.UseLastDayOfMonthForAdminReview" /><span aria-hidden="true"></span><strong>Enabled</strong></label></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <footer class="settings-form-footer"><button type="submit" class="settings-primary-button">Save booking and session settings</button></footer>
            </form>
        </section>
    </div>
</main>
@section Scripts {
    <script src="~/js/teams-organizer-settings.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/admin-settings.js" asp-append-version="true"></script>
}
