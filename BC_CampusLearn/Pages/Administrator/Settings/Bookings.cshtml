@page
@model BC_CampusLearn.Pages.Administrator.Settings.BookingsModel
@{ ViewData["Title"] = "Booking settings"; }
@section Styles {
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-settings.css" asp-append-version="true" />
}

<main class="admin-settings" aria-labelledby="settings-title" data-settings-page>
    <header class="admin-dashboard-header"><h1 id="settings-title">Settings</h1></header>
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        @await Html.PartialAsync("_CampusAlert", new CampusAlertViewModel(Model.SuccessMessage))
    }
    <div class="settings-layout">
        <partial name="_SettingsNavigation" />
        <section class="settings-section" aria-labelledby="bookings-title">
            <header class="settings-section-heading"><div><h2 id="bookings-title">Bookings and sessions</h2><p>Manage booking terms and the Tutor Head session-review deadline.</p></div><span class="settings-status settings-status--live">Live</span></header>
            <form method="post" class="settings-form">
                <div asp-validation-summary="ModelOnly" class="settings-validation"></div>
                <div class="settings-field settings-field--wide"><label asp-for="Input.Terms"></label><textarea asp-for="Input.Terms" rows="15"></textarea><small>Enter one condition per line. Blank lines are removed when saved.</small><span asp-validation-for="Input.Terms"></span></div>
                <div class="settings-subsection">
                    <div class="settings-subsection-copy"><h3>Session Review Period</h3><p>Set the deadline for the Tutor Head to complete session reviews.</p></div>
                    <div class="settings-field-grid">
                        <div class="settings-field"><label asp-for="Input.ReviewDeadline"></label><input asp-for="Input.ReviewDeadline" type="date" /><small>Date by which the Tutor Head should complete this period's reviews.</small><span asp-validation-for="Input.ReviewDeadline"></span></div>
                        <div class="settings-field settings-field--wide">
                            <label class="settings-switch">
                                <input asp-for="Input.IsReviewDeadlineRecurring" />
                                <span aria-hidden="true"></span>
                                <strong>Repeat this deadline monthly</strong>
                            </label>
                            <small>The next review period starts the day after this deadline and ends on the corresponding date the following month.</small>
                        </div>
                        <div class="settings-field settings-field--wide">
                            <label class="settings-switch">
                                <input asp-for="Input.UseLastDayOfMonth" />
                                <span aria-hidden="true"></span>
                                <strong>Use the last day of each month</strong>
                            </label>
                            <small>When monthly recurrence is enabled, deadlines use the 28th, 29th, 30th, or 31st as appropriate.</small>
                        </div>
                    </div>
                </div>
                <div class="settings-subsection">
                    <div class="settings-subsection-copy"><h3>Administrator Review Period</h3><p>Set the internal deadline for administrators to complete session approvals.</p></div>
                    <div class="settings-field-grid">
                        <div class="settings-field"><label asp-for="Input.AdminReviewPeriodStartDate"></label><input asp-for="Input.AdminReviewPeriodStartDate" type="date" /><small>Sessions completed from this date can enter the administrator review period.</small><span asp-validation-for="Input.AdminReviewPeriodStartDate"></span></div>
                        <div class="settings-field"><label asp-for="Input.AdminReviewDeadline"></label><input asp-for="Input.AdminReviewDeadline" type="date" /><small>Date by which administrators should complete this period's reviews.</small><span asp-validation-for="Input.AdminReviewDeadline"></span></div>
                        <div class="settings-field settings-field--wide">
                            <label class="settings-switch">
                                <input asp-for="Input.IsAdminReviewDeadlineRecurring" />
                                <span aria-hidden="true"></span>
                                <strong>Repeat the administrator review period monthly</strong>
                            </label>
                            <small>Both the start date and deadline advance on the first day of each month while keeping the configured date range.</small>
                        </div>
                        <div class="settings-field settings-field--wide">
                            <label class="settings-switch">
                                <input asp-for="Input.UseLastDayOfMonthForAdminReview" />
                                <span aria-hidden="true"></span>
                                <strong>Use the last day of each month</strong>
                            </label>
                            <small>Enabled by default. Turn this off to use the selected deadline day each month instead.</small>
                        </div>
                    </div>
                </div>
                <footer class="settings-form-footer"><button type="submit" class="settings-primary-button">Save booking and session settings</button></footer>
            </form>
        </section>
    </div>
</main>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/admin-settings.js" asp-append-version="true"></script> }
