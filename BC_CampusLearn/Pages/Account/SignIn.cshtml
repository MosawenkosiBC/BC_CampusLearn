@page
@model BC_CampusLearn.Pages.Account.SignInModel

@{
    ViewData["Title"] = "Log in";
}

<section class="container py-5">
    <div class="mx-auto" style="max-width: 480px;">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">Log in to CampusLearn</h1>

                <p class="text-muted">
                    Use your Belgium Campus Microsoft account to
                    access tutors and book sessions.
                </p>

                @if (Model.IsDevelopmentAuthentication)
                {
                    <div class="alert alert-warning">
                        Development authentication is active.
                        No real Microsoft account will be used.
                    </div>
                }

                <div asp-validation-summary="ModelOnly"
                     class="text-danger"></div>

                <form method="post">
                    <input type="hidden"
                           asp-for="ReturnUrl" />

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Log in with Microsoft
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>
