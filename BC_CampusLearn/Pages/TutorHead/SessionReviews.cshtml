@page
@model BC_CampusLearn.Pages.TutorHead.SessionReviewsModel

@{
    ViewData["Title"] = "Session Reviews";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Valley+Sans:ital,wght@0,100..900;1,100..900&amp;display=swap"
          rel="stylesheet" />
    <link rel="stylesheet"
          href="~/css/Dashboard.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/tutor-dashboard.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/tutors.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/bookings-index.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/tutor-head-session-reviews.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/components/navigation-drawer.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/components/pagination.css"
          asp-append-version="true" />
}

@await Html.PartialAsync(
    "~/Pages/Shared/Components/NavigationDrawer/_NavigationDrawer.cshtml")

<main class="container py-4 bookings-page tutor-head-session-reviews-page">
    <header class="bookings-heading">
        <h1>Session Reviews</h1>
    </header>

    <section class="tutor-head-period-overview"
             aria-label="Session review statistics">
        <div class="tutor-head-period-stats">
            <a asp-page="/TutorHead/SessionReviews"
               class="tutor-head-period-stat tutor-head-period-stat--interactive @(Model.ReviewStatusFilter is null ? "is-active" : null)"
               aria-current="@(Model.ReviewStatusFilter is null ? "true" : null)"
               aria-label="Show all sessions in this review period">
                <h2>Sessions this period</h2>
                <p>@Model.PeriodSummary.TotalSessions</p>
            </a>
            <a asp-page="/TutorHead/SessionReviews"
               asp-route-ReviewStatusFilter="awaiting"
               class="tutor-head-period-stat tutor-head-period-stat--interactive tutor-head-period-stat--awaiting @(Model.ReviewStatusFilter == "awaiting" ? "is-active" : null)"
               aria-current="@(Model.ReviewStatusFilter == "awaiting" ? "true" : null)"
               aria-label="Show sessions awaiting Tutor Head review">
                <h2>Awaiting review</h2>
                <p>@Model.PeriodSummary.AwaitingReview</p>
            </a>
            <a asp-page="/TutorHead/SessionReviews"
               asp-route-ReviewStatusFilter="reviewed"
               class="tutor-head-period-stat tutor-head-period-stat--interactive tutor-head-period-stat--reviewed @(Model.ReviewStatusFilter == "reviewed" ? "is-active" : null)"
               aria-current="@(Model.ReviewStatusFilter == "reviewed" ? "true" : null)"
               aria-label="Show sessions with completed Tutor Head reviews">
                <h2>Reviewed</h2>
                <p>@Model.PeriodSummary.Reviewed</p>
            </a>
            <div class="tutor-head-period-stat tutor-head-period-stat--deadline">
                <h2>Deadline</h2>
                <p>
                    <time datetime="@Model.PeriodSummary.Deadline.ToString("yyyy-MM-dd")">
                        @Model.PeriodSummary.Deadline.ToString("dd MMM yyyy")
                    </time>
                </p>
                <small>@Model.PeriodSummary.DeadlineStatus</small>
            </div>
        </div>
    </section>

    <div class="bookings-workspace @(Model.Sessions.Count == 0 && Model.HasActiveFilters ? "tutor-head-empty-workspace" : null)">
        <aside id="tutor-head-session-review-filter-panel"
               class="tutor-filters bookings-filters"
               aria-labelledby="tutor-head-session-review-filter-title"
               data-filter-breakpoint="1199.98"
               data-filter-panel>
            <div class="filter-heading">
                <h2 id="tutor-head-session-review-filter-title">Filters</h2>
                <a asp-page="/TutorHead/SessionReviews">Clear all</a>
                <button type="button"
                        class="filter-modal-close"
                        data-filter-close
                        aria-label="Close filters">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 6l12 12M18 6 6 18" />
                    </svg>
                </button>
            </div>

            <form method="get">
                @if (Model.ReviewStatusFilter is not null)
                {
                    <input type="hidden"
                           name="ReviewStatusFilter"
                           value="@Model.ReviewStatusFilter" />
                }
                <div class="filter-group">
                    <label asp-for="TutorFilter">Search by tutor</label>
                    <div class="filter-search">
                        <input asp-for="TutorFilter"
                               type="search"
                               autocomplete="off" />
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" />
                        </svg>
                    </div>
                </div>

                <div class="filter-group">
                    <label asp-for="StudentFilter">Search by student</label>
                    <div class="filter-search">
                        <input asp-for="StudentFilter"
                               type="search"
                               autocomplete="off" />
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" />
                        </svg>
                    </div>
                </div>

                <div class="filter-group tutor-head-date-range-filter">
                    <span class="tutor-head-filter-label">Custom date range</span>
                    <div class="tutor-head-date-range">
                        <div class="tutor-head-date-field">
                            <label asp-for="DateFrom">From</label>
                            <div class="filter-search bookings-date-filter">
                                <input asp-for="DateFrom" type="date" />
                            </div>
                        </div>
                        <div class="tutor-head-date-field">
                            <label asp-for="DateTo">To</label>
                            <div class="filter-search bookings-date-filter">
                                <input asp-for="DateTo" type="date" />
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.DateRangeError))
                    {
                        <span class="tutor-head-date-range-error" role="alert">
                            @Model.DateRangeError
                        </span>
                    }
                </div>

                <button type="submit" class="apply-filters">
                    Apply filters
                </button>
            </form>
        </aside>
        <button type="button"
                class="tutor-filter-backdrop"
                data-filter-close
                aria-label="Close filters"></button>

        <div class="bookings-results tutor-head-review-results">
            <button type="button"
                    class="mobile-filter-trigger tutor-head-mobile-filter-trigger @(Model.HasActiveFilters ? "has-active-filters" : null)"
                    data-filter-open
                    aria-controls="tutor-head-session-review-filter-panel"
                    aria-expanded="false">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path fill="currentColor"
                          d="M4.38 3.22A1 1 0 0 1 5 3h14a1 1 0 0 1 .79 1.62L15 10.75v9.13c.04.3-.06.62-.29.83a.996.996 0 0 1-1.41 0l-4.01-4.01a.99.99 0 0 1-.29-.83v-5.12L4.21 4.62a1 1 0 0 1 .17-1.4Z" />
                </svg>
                <span>Filter</span>
            </button>

            <section class="bookings-section"
                     aria-label="Session review results">
                @if (Model.Sessions.Count == 0 && Model.HasActiveFilters)
                {
                    <div class="empty-tutors bookings-empty-results">
                        <span class="bookings-empty-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24">
                                <circle cx="10.5" cy="10.5" r="6.5" />
                                <path d="m15.4 15.4 4.1 4.1" />
                            </svg>
                        </span>
                        <h2>No sessions match those filters</h2>
                        <p>
                            Try clearing a filter or searching for another session.
                        </p>
                        <a asp-page="/TutorHead/SessionReviews">Clear all filters</a>
                    </div>
                }
                else
                {
                    <div class="tutor-sessions">
                        <div class="tutor-sessions-table-wrap">
                            <table id="tutor-head-session-reviews-table"
                                   class="tutor-sessions-table bookings-table tutor-head-session-reviews-table">
                        <thead>
                            <tr>
                                <th scope="col">Tutor Name</th>
                                <th scope="col">Student Name</th>
                                <th scope="col">Date &amp; Time</th>
                                <th scope="col">Status</th>
                                <th scope="col">Module</th>
                                <th scope="col">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Sessions.Count == 0)
                            {
                                <tr>
                                    <td colspan="6"
                                        class="tutor-sessions-empty">
                                        No completed sessions have both reviews yet.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var session in Model.Sessions)
                                {
                                    DateTimeOffset localStart =
                                        session.ScheduledStartTime.ToLocalTime();
                                    DateTimeOffset localEnd =
                                        session.SessionEnd.ToLocalTime();

                                    <tr data-pagination-row>
                                        <td data-label="Tutor Name">
                                            @session.TutorDisplayName
                                        </td>
                                        <td data-label="Student Name">
                                            @session.StudentName
                                        </td>
                                        <td data-label="Date &amp; Time">
                                            <span class="tutor-session-date">
                                                @localStart.ToString("dd MMM yyyy")
                                            </span>
                                            <span class="tutor-session-time">
                                                @localStart.ToString("HH:mm")&ndash;@localEnd.ToString("HH:mm")
                                            </span>
                                        </td>
                                        <td data-label="Status">
                                            <span class="tutor-head-review-status @(session.HasTutorHeadReview ? "tutor-head-review-status--reviewed" : "tutor-head-review-status--awaiting")">
                                                @session.ReviewStatus
                                            </span>
                                        </td>
                                        <td data-label="Module"
                                            title="@session.ModuleCode">
                                            @session.ModuleCode
                                        </td>
                                        <td data-label="Action">
                                            <form method="get"
                                                  asp-page="/TutorHead/SessionDetails"
                                                  asp-route-id="@session.BookingId">
                                                <button type="submit"
                                                        class="tutor-head-view-session"
                                                        aria-label="View session for @session.StudentName with @session.TutorDisplayName">
                                                    View
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                            </table>
                        </div>

                        @await Component.InvokeAsync(
                            "Pagination",
                            new
                            {
                                targetId = "tutor-head-session-reviews-table",
                                mobilePageSize = 7,
                                defaultPageSize = 11,
                                ariaLabel = "Tutor Head session review table pages"
                            })
                    </div>
                }
            </section>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/components/navigation-drawer.js"
            asp-append-version="true"></script>
    <script src="~/js/tutors.js"
            asp-append-version="true"></script>
    <script src="~/js/components/pagination.js"
            asp-append-version="true"></script>
}
