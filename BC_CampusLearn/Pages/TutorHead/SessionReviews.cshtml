@page
@model BC_CampusLearn.Pages.TutorHead.SessionReviewsModel

@{
    ViewData["Title"] = "Session Reviews";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Valley+Sans:ital,wght@0,100..900;1,100..900&amp;display=swap"
          rel="stylesheet" />
    <link rel="stylesheet"
          href="~/css/Dashboard.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/tutor-dashboard.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/tutors.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/bookings-index.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/tutor-head-session-reviews.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/components/navigation-drawer.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/components/pagination.css"
          asp-append-version="true" />
}

@await Html.PartialAsync(
    "~/Pages/Shared/Components/NavigationDrawer/_NavigationDrawer.cshtml")

<main class="container py-4 bookings-page tutor-head-session-reviews-page">
    <header class="bookings-heading tutor-head-reviews-heading">
        <h1>Session Reviews</h1>
        <div class="tutor-head-heading-actions">
        <button type="button" class="tutor-head-performance-button"
                data-bs-toggle="modal" data-bs-target="#tutor-performance-modal"
                aria-controls="tutor-performance-modal" aria-label="View tutor performance">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10h4v10m2 0V4h4v16m2 0v-7h4v7M2 20h20" /></svg>
            <span>Tutor Performance</span>
        </button>
        <button type="button"
                class="tutor-head-ai-helper"
                data-bs-toggle="modal"
                data-bs-target="#gemini-key-modal"
                aria-controls="gemini-key-modal"
                aria-label="Set up Gemini AI review helper"
                title="Gemini AI review helper">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 3a7 7 0 0 0-4.7 12.18c.73.66 1.2 1.42 1.2 2.32h7c0-.9.47-1.66 1.2-2.32A7 7 0 0 0 12 3Z" />
                <path d="M9.5 21h5M9 17.5h6" />
            </svg>
            <span class="visually-hidden">Open Gemini settings</span>
        </button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.GeminiKeyMessage))
    {
        @await Html.PartialAsync(
            "_CampusAlert",
            new CampusAlertViewModel(Model.GeminiKeyMessage))
    }

    <section class="tutor-head-period-overview"
             aria-label="Session review statistics">
        <div class="tutor-head-period-stats">
            <a asp-page="/TutorHead/SessionReviews"
               class="tutor-head-period-stat tutor-head-period-stat--interactive @(Model.ReviewStatusFilter is null ? "is-active" : null)"
               aria-current="@(Model.ReviewStatusFilter is null ? "true" : null)"
               aria-label="Show all sessions in this review period">
                <h2>Sessions this period</h2>
                <p>@Model.PeriodSummary.TotalSessions</p>
            </a>
            <a asp-page="/TutorHead/SessionReviews"
               asp-route-ReviewStatusFilter="awaiting"
               class="tutor-head-period-stat tutor-head-period-stat--interactive tutor-head-period-stat--awaiting @(Model.ReviewStatusFilter == "awaiting" ? "is-active" : null)"
               aria-current="@(Model.ReviewStatusFilter == "awaiting" ? "true" : null)"
               aria-label="Show sessions awaiting Tutor Head review">
                <h2>Awaiting review</h2>
                <p>@Model.PeriodSummary.AwaitingReview</p>
            </a>
            <a asp-page="/TutorHead/SessionReviews"
               asp-route-ReviewStatusFilter="reviewed"
               class="tutor-head-period-stat tutor-head-period-stat--interactive tutor-head-period-stat--reviewed @(Model.ReviewStatusFilter == "reviewed" ? "is-active" : null)"
               aria-current="@(Model.ReviewStatusFilter == "reviewed" ? "true" : null)"
               aria-label="Show sessions with completed Tutor Head reviews">
                <h2>Reviewed</h2>
                <p>@Model.PeriodSummary.Reviewed</p>
            </a>
            <div class="tutor-head-period-stat tutor-head-period-stat--deadline">
                <h2>Deadline</h2>
                <p>
                    <time datetime="@Model.PeriodSummary.Deadline.ToString("yyyy-MM-dd")">
                        @Model.PeriodSummary.Deadline.ToString("dd MMM yyyy")
                    </time>
                </p>
                @if (!string.IsNullOrWhiteSpace(
                    Model.PeriodSummary.DeadlineStatus))
                {
                    <small>@Model.PeriodSummary.DeadlineStatus</small>
                }
            </div>
        </div>
    </section>

    <div class="bookings-workspace @(Model.Sessions.Count == 0 && Model.HasActiveFilters ? "tutor-head-empty-workspace" : null)">
        <aside id="tutor-head-session-review-filter-panel"
               class="tutor-filters bookings-filters"
               aria-labelledby="tutor-head-session-review-filter-title"
               data-filter-breakpoint="1199.98"
               data-filter-panel>
            <div class="filter-heading">
                <h2 id="tutor-head-session-review-filter-title">Filters</h2>
                <a asp-page="/TutorHead/SessionReviews">Clear all</a>
                <button type="button"
                        class="filter-modal-close"
                        data-filter-close
                        aria-label="Close filters">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 6l12 12M18 6 6 18" />
                    </svg>
                </button>
            </div>

            <form method="get">
                @if (Model.ReviewStatusFilter is not null)
                {
                    <input type="hidden"
                           name="ReviewStatusFilter"
                           value="@Model.ReviewStatusFilter" />
                }
                <div class="filter-group">
                    <label asp-for="TutorFilter">Search by tutor</label>
                    <div class="filter-search">
                        <input asp-for="TutorFilter"
                               type="search"
                               autocomplete="off" />
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" />
                        </svg>
                    </div>
                </div>

                <div class="filter-group">
                    <label asp-for="StudentFilter">Search by student</label>
                    <div class="filter-search">
                        <input asp-for="StudentFilter"
                               type="search"
                               autocomplete="off" />
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="m21 21-4.35-4.35m2.35-5.65a8 8 0 1 1-16 0 8 8 0 0 1 16 0Z" />
                        </svg>
                    </div>
                </div>

                <div class="filter-group tutor-head-date-range-filter">
                    <span class="tutor-head-filter-label">Custom date range</span>
                    <div class="tutor-head-date-range">
                        <div class="tutor-head-date-field">
                            <label asp-for="DateFrom">From</label>
                            <div class="filter-search bookings-date-filter">
                                <input asp-for="DateFrom" type="date" />
                            </div>
                        </div>
                        <div class="tutor-head-date-field">
                            <label asp-for="DateTo">To</label>
                            <div class="filter-search bookings-date-filter">
                                <input asp-for="DateTo" type="date" />
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.DateRangeError))
                    {
                        <span class="tutor-head-date-range-error" role="alert">
                            @Model.DateRangeError
                        </span>
                    }
                </div>

                <button type="submit" class="apply-filters">
                    Apply filters
                </button>
            </form>
        </aside>
        <button type="button"
                class="tutor-filter-backdrop"
                data-filter-close
                aria-label="Close filters"></button>

        <div class="bookings-results tutor-head-review-results">
            <button type="button"
                    class="mobile-filter-trigger tutor-head-mobile-filter-trigger @(Model.HasActiveFilters ? "has-active-filters" : null)"
                    data-filter-open
                    aria-controls="tutor-head-session-review-filter-panel"
                    aria-expanded="false">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path fill="currentColor"
                          d="M4.38 3.22A1 1 0 0 1 5 3h14a1 1 0 0 1 .79 1.62L15 10.75v9.13c.04.3-.06.62-.29.83a.996.996 0 0 1-1.41 0l-4.01-4.01a.99.99 0 0 1-.29-.83v-5.12L4.21 4.62a1 1 0 0 1 .17-1.4Z" />
                </svg>
                <span>Filter</span>
            </button>

            <section class="bookings-section"
                     aria-label="Session review results">
                @if (Model.Sessions.Count == 0 && Model.HasActiveFilters)
                {
                    <div class="empty-tutors bookings-empty-results">
                        <span class="bookings-empty-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24">
                                <circle cx="10.5" cy="10.5" r="6.5" />
                                <path d="m15.4 15.4 4.1 4.1" />
                            </svg>
                        </span>
                        <h2>No sessions match those filters</h2>
                        <p>
                            Try clearing a filter or searching for another session.
                        </p>
                        <a asp-page="/TutorHead/SessionReviews">Clear all filters</a>
                    </div>
                }
                else
                {
                    <div class="tutor-sessions">
                        <div class="tutor-sessions-table-wrap">
                            <table id="tutor-head-session-reviews-table"
                                   class="tutor-sessions-table bookings-table tutor-head-session-reviews-table">
                        <thead>
                            <tr>
                                <th scope="col">Tutor Name</th>
                                <th scope="col">Student Name</th>
                                <th scope="col">Date &amp; Time</th>
                                <th scope="col">Status</th>
                                <th scope="col">Module</th>
                                <th scope="col">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Sessions.Count == 0)
                            {
                                <tr>
                                    <td colspan="6"
                                        class="tutor-sessions-empty">
                                        No completed sessions have both reviews yet.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var session in Model.Sessions)
                                {
                                    DateTimeOffset localStart =
                                        session.ScheduledStartTime.ToLocalTime();
                                    DateTimeOffset localEnd =
                                        session.SessionEnd.ToLocalTime();

                                    <tr data-pagination-row>
                                        <td data-label="Tutor Name">
                                            @session.TutorDisplayName
                                        </td>
                                        <td data-label="Student Name">
                                            @session.StudentName
                                        </td>
                                        <td data-label="Date &amp; Time">
                                            <span class="tutor-session-date">
                                                @localStart.ToString("dd MMM yyyy")
                                            </span>
                                            <span class="tutor-session-time">
                                                @localStart.ToString("HH:mm")&ndash;@localEnd.ToString("HH:mm")
                                            </span>
                                        </td>
                                        <td data-label="Status">
                                            <span class="tutor-head-review-status @session.ReviewStatusClass">
                                                @session.ReviewStatus
                                            </span>
                                        </td>
                                        <td data-label="Module"
                                            title="@session.ModuleCode">
                                            @session.ModuleCode
                                        </td>
                                        <td data-label="Action">
                                            <form method="get"
                                                  asp-page="/TutorHead/SessionDetails"
                                                  asp-route-id="@session.BookingId">
                                                <button type="submit"
                                                        class="tutor-head-view-session"
                                                        aria-label="View session for @session.StudentName with @session.TutorDisplayName">
                                                    View
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                            </table>
                        </div>

                        @await Component.InvokeAsync(
                            "Pagination",
                            new
                            {
                                targetId = "tutor-head-session-reviews-table",
                                mobilePageSize = 7,
                                defaultPageSize = 11,
                                ariaLabel = "Tutor Head session review table pages"
                            })
                    </div>
                }
            </section>
        </div>
    </div>
</main>

@section Modals {
    <div class="modal fade tutor-performance-modal" id="tutor-performance-modal" tabindex="-1"
         aria-labelledby="tutor-performance-title" aria-hidden="true"
         data-open="@Model.ShowPerformance.ToString().ToLowerInvariant()">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h2 class="modal-title" id="tutor-performance-title">Tutor Performance</h2>
                        <div class="tutor-performance-duration" aria-label="Selected duration">
                            <strong>@Model.PerformanceFrom?.ToString("dd MMM yyyy") – @Model.PerformanceTo?.ToString("dd MMM yyyy")</strong>
                            <button type="button" class="tutor-performance-customize"
                                    aria-controls="tutor-performance-dates-modal"
                                    data-bs-toggle="modal" data-bs-target="#tutor-performance-dates-modal"
                                    data-performance-customize>Customize</button>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close tutor performance"></button>
                </div>
                <div class="modal-body">
                    <div class="tutor-performance-summary" aria-label="Totals across all tutors">
                        <div><span>Completed sessions</span><strong>@Model.TutorPerformance.Sum(tutor => tutor.Completed)</strong></div>
                        <div class="is-approved"><span>Approved</span><strong>@Model.TutorPerformance.Sum(tutor => tutor.Approved)</strong></div>
                        <div class="is-rejected"><span>Rejected</span><strong>@Model.TutorPerformance.Sum(tutor => tutor.Rejected)</strong></div>
                        <div class="is-escalated"><span>Escalated</span><strong>@Model.TutorPerformance.Sum(tutor => tutor.Escalated)</strong></div>
                    </div>
                    <div class="tutor-performance-toolbar">
                        <div class="tutor-performance-search">
                            <label for="tutor-performance-search">Find a tutor</label>
                            <input type="search" id="tutor-performance-search" placeholder="Search by name or personnel number" autocomplete="off" />
                        </div>
                        <p data-performance-count aria-live="polite">@Model.TutorPerformance.Count tutor@(Model.TutorPerformance.Count == 1 ? "" : "s")</p>
                    </div>
                    <div class="tutor-performance-table-wrap" role="region" aria-label="Tutor performance results" tabindex="0">
                        <table class="tutor-performance-table">
                            <caption class="visually-hidden">Completed sessions and review decisions by tutor for the selected dates.</caption>
                            <thead>
                                <tr>
                                    @foreach (var column in new[] { (Key: "name", Label: "Tutor"), (Key: "completed", Label: "Completed"), (Key: "approved", Label: "Approved"), (Key: "rejected", Label: "Rejected"), (Key: "escalated", Label: "Escalated") })
                                    {
                                        <th scope="col" aria-sort="@(column.Key == "completed" ? "descending" : "none")">
                                            <button type="button" class="tutor-performance-sort" data-performance-sort="@column.Key">
                                                @column.Label
                                                <svg viewBox="0 0 16 20" aria-hidden="true">
                                                    <path class="sort-up" d="m4 7 4-4 4 4" />
                                                    <path class="sort-down" d="m4 13 4 4 4-4" />
                                                </svg>
                                            </button>
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tutor in Model.TutorPerformance)
                                {
                                    <tr data-performance-row data-search="@tutor.DisplayName @tutor.PersonnelNumber"
                                        data-name="@tutor.DisplayName" data-completed="@tutor.Completed"
                                        data-approved="@tutor.Approved" data-rejected="@tutor.Rejected" data-escalated="@tutor.Escalated">
                                        <th scope="row">
                                            <div class="tutor-performance-identity">
                                                <span class="tutor-performance-avatar" aria-hidden="true">
                                                    @if (!string.IsNullOrWhiteSpace(tutor.ProfileImagePath))
                                                    {
                                                        <img src="@tutor.ProfileImagePath" alt="" loading="lazy" data-performance-photo />
                                                    }
                                                    <span data-performance-initials hidden="@(!string.IsNullOrWhiteSpace(tutor.ProfileImagePath))">@tutor.Initials</span>
                                                </span>
                                                <div><strong>@tutor.DisplayName</strong>@if (!string.IsNullOrWhiteSpace(tutor.PersonnelNumber)) { <small>@tutor.PersonnelNumber</small> }</div>
                                            </div>
                                        </th>
                                        <td><strong>@tutor.Completed</strong></td>
                                        <td><span class="tutor-performance-outcome is-approved">@tutor.Approved</span></td>
                                        <td><span class="tutor-performance-outcome is-rejected">@tutor.Rejected</span></td>
                                        <td><span class="tutor-performance-outcome is-escalated">@tutor.Escalated</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <p class="tutor-performance-empty" data-performance-empty hidden="@(Model.TutorPerformance.Count > 0)">
                            @(Model.TutorPerformance.Count == 0 ? "No tutors to show yet." : "No tutors match your search.")
                        </p>
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-dark" data-bs-dismiss="modal">Done</button></div>
            </div>
        </div>
    </div>
    <div class="modal fade tutor-performance-modal tutor-performance-dates-modal" id="tutor-performance-dates-modal"
         tabindex="-1" aria-labelledby="tutor-performance-dates-title" aria-hidden="true"
         data-open="@((Model.PerformanceRangeError is not null).ToString().ToLowerInvariant())">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title" id="tutor-performance-dates-title">Customize dates</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close date customization"></button>
                </div>
                <form method="get" id="tutor-performance-date-filter">
                    <div class="modal-body">
                        <input type="hidden" name="ShowPerformance" value="true" />
                        <input type="hidden" name="TutorFilter" value="@Model.TutorFilter" />
                        <input type="hidden" name="StudentFilter" value="@Model.StudentFilter" />
                        <input type="hidden" name="DateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="DateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="ReviewStatusFilter" value="@Model.ReviewStatusFilter" />
                        <div class="tutor-performance-date-filter">
                            <div><label for="performance-from">From</label><input asp-for="PerformanceFrom" id="performance-from" type="date" required /></div>
                            <div><label for="performance-to">To</label><input asp-for="PerformanceTo" id="performance-to" type="date" required /></div>
                        </div>
                        @if (Model.PerformanceRangeError is { } rangeError)
                        {
                            <p class="text-danger" role="alert">@rangeError</p>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-dark">Apply dates</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="modal fade tutor-head-gemini-modal" id="gemini-key-modal"
         tabindex="-1" aria-labelledby="gemini-key-modal-title"
         aria-hidden="true" data-open="@Model.OpenGeminiModal.ToString().ToLowerInvariant()">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <span class="tutor-head-gemini-eyebrow">AI review helper</span>
                        <h2 class="modal-title" id="gemini-key-modal-title">
                            Connect Gemini
                        </h2>
                    </div>
                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post" asp-page-handler="SaveGeminiKey">
                    <div class="modal-body">
                        <p>
                            Gemini can compare the student's booking summary,
                            both reviews, and the session message transcript to
                            produce an advisory session assessment.
                        </p>
                        <div class="tutor-head-gemini-privacy" role="note">
                            Session evidence is sent to Google's Gemini API only
                            when you request an assessment. Always verify its
                            findings before completing your review.
                        </div>
                        <label asp-for="GeminiApiKey"></label>
                        <div class="tutor-head-gemini-key-field">
                            <input asp-for="GeminiApiKey" type="password"
                                   autocomplete="new-password"
                                   placeholder="Paste your Gemini API key"
                                   aria-describedby="gemini-key-help" />
                            <button type="button" data-toggle-api-key
                                    aria-label="Show API key">Show</button>
                        </div>
                        <span asp-validation-for="GeminiApiKey"
                              class="text-danger"></span>
                        <small id="gemini-key-help">
                            @(Model.HasGeminiApiKey
                                ? "A key is already configured. Saving replaces it."
                                : "Your key is encrypted before it is stored and is never shown again.")
                        </small>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light"
                                data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="tutor-head-gemini-save">
                            @(Model.HasGeminiApiKey ? "Replace key" : "Save key")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/components/navigation-drawer.js"
            asp-append-version="true"></script>
    <script src="~/js/tutors.js"
            asp-append-version="true"></script>
    <script src="~/js/components/pagination.js"
            asp-append-version="true"></script>
    <script src="~/js/tutor-head-session-reviews.js"
            asp-append-version="true"></script>
}
