@page "{id:int}"
@model BC_CampusLearn.Pages.TutorHead.SessionDetailsModel
@using BC_CampusLearn.Models.Entities

@{
    ViewData["Title"] = "Session Review Details";
    Booking session = Model.Session;
    BcUser tutorUser = session.TutorCourseModule.Tutor.BcUser;
    string tutorName = string.IsNullOrWhiteSpace(tutorUser.DisplayName)
        ? tutorUser.PersonnelNumber
        : tutorUser.DisplayName;
    DateTimeOffset localStart = session.ScheduledStartTime.ToOffset(TimeSpan.FromHours(2));
    DateTimeOffset localEnd = localStart.AddHours((int)session.Duration);
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Valley+Sans:ital,wght@0,100..900;1,100..900&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/Dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-session-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tutor-head-session-details.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/navigation-drawer.css" asp-append-version="true" />
}

@await Html.PartialAsync("~/Pages/Shared/Components/NavigationDrawer/_NavigationDrawer.cshtml")

<main class="container py-4 admin-dashboard admin-session-information tutor-head-session-details-page"
      aria-labelledby="session-review-details-title">
    <header class="admin-dashboard-header tutor-head-details-heading">
        <h1 id="session-review-details-title">Session Review Details</h1>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.TutorHeadReviewMessage))
    {
        @await Html.PartialAsync(
            "_CampusAlert",
            new CampusAlertViewModel(Model.TutorHeadReviewMessage))
    }

    <div class="admin-session-content">
        <div class="tutor-head-summary-actions">
            <div class="tutor-head-summary-view-actions">
                <button type="button" class="admin-session-summary-button"
                        data-bs-toggle="modal" data-bs-target="#session-summary-modal"
                        aria-controls="session-summary-modal">
                    <span>View Session Summary</span>
                </button>
                @if (Model.AiAssessment is not null)
                {
                    <button type="button" class="tutor-head-view-ai-button"
                            data-bs-toggle="modal" data-bs-target="#ai-assessment-modal"
                            aria-controls="ai-assessment-modal">
                        View AI assessment
                    </button>
                }
            </div>
            @if (Model.AiAssessment is null)
            {
                <form method="post" asp-page-handler="GenerateAiAssessment"
                      asp-route-id="@session.BookingId"
                      data-ai-assessment-form>
                    <button type="submit" class="tutor-head-ai-assessment-button"
                            disabled="@(!Model.HasGeminiApiKey)">
                        <svg viewBox="0 0 24 24" aria-hidden="true"
                             data-ai-assessment-icon>
                            <path d="M12 3a7 7 0 0 0-4.7 12.18c.73.66 1.2 1.42 1.2 2.32h7c0-.9.47-1.66 1.2-2.32A7 7 0 0 0 12 3Z" />
                            <path d="M9.5 21h5M9 17.5h6" />
                        </svg>
                        <span class="tutor-head-ai-button-spinner"
                              data-ai-assessment-spinner aria-hidden="true"
                              hidden></span>
                        <span data-ai-assessment-label>Generate AI assessment</span>
                    </button>
                </form>
            }
        </div>

        @if (!Model.HasGeminiApiKey && Model.AiAssessment is null)
        {
            <p class="tutor-head-ai-setup-note">
                Configure your Gemini API key from the helper on
                <a asp-page="/TutorHead/SessionReviews">Session Reviews</a>
                to use AI assessments.
            </p>
        }

        @if (!string.IsNullOrWhiteSpace(Model.AiAssessmentError))
        {
            @await Html.PartialAsync(
                "_CampusAlert",
                new CampusAlertViewModel(
                    Model.AiAssessmentError,
                    CampusAlertVariant.Danger))
        }

        <section class="admin-session-reviews" aria-labelledby="session-reviews-title">
            <h2 id="session-reviews-title" class="visually-hidden">Session reviews</h2>
            <div class="admin-session-review-tabs tutor-head-review-tabs" role="tablist" aria-label="Session reviews">
                <button type="button" class="admin-session-review-tab is-active"
                        id="student-review-tab" role="tab" aria-controls="student-review-panel"
                        aria-selected="true" data-review-tab="student-review-panel">
                    <span>Student Review</span>
                    <strong class="is-submitted">Submitted</strong>
                </button>
                <button type="button" class="admin-session-review-tab"
                        id="tutor-review-tab" role="tab" aria-controls="tutor-review-panel"
                        aria-selected="false" tabindex="-1" data-review-tab="tutor-review-panel">
                    <span>Tutor Review</span>
                    <strong class="is-submitted">Submitted</strong>
                </button>
                <button type="button" class="admin-session-review-tab tutor-head-review-tab"
                        id="tutor-head-review-tab" role="tab" aria-controls="tutor-head-review-panel"
                        aria-selected="false" tabindex="-1" data-review-tab="tutor-head-review-panel">
                    <span>Tutor Head Review</span>
                    <strong class="@(Model.TutorHeadReview is not null ? "is-submitted" : "is-missing")">
                        @(Model.TutorHeadReview is not null ? "Submitted" : "Not submitted")
                    </strong>
                </button>
            </div>

            <section class="admin-session-review-panel-card" id="tutor-head-review-panel"
                     role="tabpanel" aria-labelledby="tutor-head-review-tab" tabindex="0" hidden
                     data-review-panel data-review-pager>
                <header class="admin-session-review-panel-heading">
                    <div>
                        <h2>Tutor Head Review</h2>
                    </div>
                    @if (Model.TutorHeadReview is { } recordedReview)
                    {
                        <span class="admin-session-recorded-at">
                            Recorded @recordedReview.CreatedAt.ToOffset(TimeSpan.FromHours(2)).ToString("dd MMM yyyy, HH:mm")
                        </span>
                    }
                </header>
                <div class="admin-session-review-body @(Model.TutorHeadReview is null ? "tutor-head-review-form-body" : null)">
                    @if (Model.TutorHeadReview is { } review)
                    {
                        <dl class="admin-session-answers tutor-head-own-review-answers"
                            id="tutor-head-review-answers">
                            <div data-review-answer><dt>Did the tutor engage the student appropriately?</dt><dd>@(review.StudentEngagement ?? "Not provided")</dd></div>
                            <div data-review-answer><dt>Were any concerns identified?</dt><dd>@(review.ConcernLevel ?? "Not provided")</dd></div>
                            <div data-review-answer><dt>Overall session assessment</dt><dd>@(review.OverallAssessment ?? $"{review.Rating}/5")</dd></div>
                            <div data-review-answer><dt>Decision</dt><dd>@(review.Decision ?? "Not provided")</dd></div>
                            <div data-review-answer><dt>Additional comments</dt><dd>@(string.IsNullOrWhiteSpace(review.Comment) ? "No additional comments." : review.Comment)</dd></div>
                        </dl>
                        <nav class="admin-session-review-pagination" aria-label="Tutor Head review pages" hidden>
                            <button type="button" data-review-previous>Previous</button>
                            <span data-review-page-status aria-live="polite"></span>
                            <button type="button" data-review-next>Next</button>
                        </nav>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="TutorHeadReview"
                              asp-route-id="@session.BookingId"
                              class="admin-session-review-form tutor-head-review-form"
                              data-tutor-head-review-form novalidate>
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <div id="tutor-head-review-form-steps">
                                @foreach (var question in new[] {
                                    new { Number = 1, Name = "StudentEngagement", Text = "Did the tutor engage the student appropriately?", Options = new[] { "Yes", "Partially", "No" }, Answer = Model.TutorHeadReviewInput.StudentEngagement },
                                    new { Number = 2, Name = "ConcernLevel", Text = "Were any concerns identified?", Options = new[] { "No Concerns", "Concerns" }, Answer = Model.TutorHeadReviewInput.ConcernLevel },
                                    new { Number = 3, Name = "OverallAssessment", Text = "Overall session assessment", Options = new[] { "Excellent", "Good", "Satisfactory", "Needs improvement" }, Answer = Model.TutorHeadReviewInput.OverallAssessment },
                                    new { Number = 4, Name = "Decision", Text = "Decision", Options = new[] { "Approve", "Reject", "Escalate" }, Answer = Model.TutorHeadReviewInput.Decision }
                                })
                                {
                                    <fieldset data-pagination-row data-review-answer data-option-question>
                                        <legend>@question.Number. @question.Text</legend>
                                        <div class="admin-session-review-options">
                                            @foreach (string option in question.Options)
                                            {
                                                string optionId = $"tutor-head-{question.Name}-{option.Replace(" ", "-").ToLowerInvariant()}";
                                                <label for="@optionId">
                                                    <input type="radio"
                                                           id="@optionId"
                                                           name="TutorHeadReviewInput.@question.Name"
                                                           value="@option"
                                                           checked="@(question.Answer == option)" />
                                                    @option
                                                </label>
                                            }
                                        </div>
                                    </fieldset>
                                }
                                <div class="tutor-head-review-comments" data-pagination-row data-review-answer>
                                    <label asp-for="TutorHeadReviewInput.AdditionalComments">
                                        5. Additional comments
                                        <span data-comments-required hidden="@(Model.TutorHeadReviewInput.ConcernLevel != "Concerns")">(required)</span>
                                    </label>
                                    <textarea asp-for="TutorHeadReviewInput.AdditionalComments"
                                              rows="3" maxlength="500"
                                              required="@(Model.TutorHeadReviewInput.ConcernLevel == "Concerns")"
                                              placeholder="Describe any concerns or add a comment"></textarea>
                                    <span asp-validation-for="TutorHeadReviewInput.AdditionalComments"
                                          data-comments-error role="alert"
                                          class="text-danger"></span>
                                </div>
                                <div class="tutor-head-review-submit">
                                    <button type="submit">Save review</button>
                                </div>
                            </div>
                            <nav class="admin-session-review-pagination" aria-label="Tutor Head review form pages" hidden>
                                <button type="button" data-review-previous>Previous</button>
                                <span data-review-page-status aria-live="polite"></span>
                                <button type="button" data-review-next>Next</button>
                            </nav>
                        </form>
                    }
                </div>
            </section>

            <section class="admin-session-review-panel-card" id="tutor-review-panel"
                     role="tabpanel" aria-labelledby="tutor-review-tab" tabindex="0" hidden
                     data-review-panel data-review-pager>
                <header class="admin-session-review-panel-heading">
                    <div>
                        <h2>Tutor Review</h2>
                    </div>
                    <div class="tutor-head-evidence-actions">
                        @if (Model.CanWatchRecording)
                        {
                            <a class="tutor-head-recording-button"
                               href="@Model.RecordingUrl" target="_blank" rel="noopener noreferrer">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10-6.5z" fill="currentColor" /></svg>
                                Watch recording
                            </a>
                        }
                        else
                        {
                            <span class="tutor-head-recording-unavailable">Recording unavailable</span>
                        }
                        @if (Model.HasTranscript)
                        {
                            <a class="tutor-head-recording-button"
                               href="@Url.Page(
                                   "/TutorHead/SessionDetails",
                                   "Transcript",
                                   new { id = session.BookingId })"
                               target="_blank" rel="noopener noreferrer">
                                Download transcript
                            </a>
                        }
                    </div>
                </header>
                <div class="admin-session-review-body">
                    <dl class="admin-session-answers" id="tutor-review-answers">
                        @foreach (var answer in Model.TutorReviewAnswers)
                        {
                            <div data-review-answer><dt>@answer.Question</dt><dd>@answer.Value</dd></div>
                        }
                    </dl>
                    <nav class="admin-session-review-pagination" aria-label="Tutor review pages" hidden>
                        <button type="button" data-review-previous>Previous</button>
                        <span data-review-page-status aria-live="polite"></span>
                        <button type="button" data-review-next>Next</button>
                    </nav>
                </div>
            </section>

            <section class="admin-session-review-panel-card" id="student-review-panel"
                     role="tabpanel" aria-labelledby="student-review-tab" tabindex="0"
                     data-review-panel data-review-pager>
                <header class="admin-session-review-panel-heading">
                    <div>
                        <h2>Student Review</h2>
                    </div>
                </header>
                <div class="admin-session-review-body">
                    <dl class="admin-session-answers" id="student-review-answers">
                        @foreach (var answer in Model.StudentReviewAnswers)
                        {
                            <div data-review-answer><dt>@answer.Question</dt><dd>@answer.Value</dd></div>
                        }
                    </dl>
                    <nav class="admin-session-review-pagination" aria-label="Student review pages" hidden>
                        <button type="button" data-review-previous>Previous</button>
                        <span data-review-page-status aria-live="polite"></span>
                        <button type="button" data-review-next>Next</button>
                    </nav>
                </div>
            </section>
        </section>
    </div>
</main>

@section Modals {
    @if (Model.AiAssessment is { } assessment)
    {
        <div class="modal fade" id="ai-assessment-modal" tabindex="-1"
             data-open-on-load="@Model.OpenAiAssessmentModal.ToString().ToLowerInvariant()"
             aria-labelledby="ai-assessment-title" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <div>
                            <div class="tutor-head-ai-title-row">
                                <h2 class="modal-title" id="ai-assessment-title">Session evidence summary</h2>
                                <span class="tutor-head-ai-review-notice">
                                    <strong>AI Disclaimer:</strong> AI-generated results may contain errors. Please verify the analysis against the transcript and reviews before making a decision
                                </span>
                            </div>
                            @if (Model.AiAssessmentGeneratedAt is { } generatedAt)
                            {
                                <small>
                                    Generated @generatedAt.ToOffset(TimeSpan.FromHours(2)).ToString("dd MMM yyyy, HH:mm")
                                </small>
                            }
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"
                                aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <section class="tutor-head-ai-assessment">
                            <header>
                                <h3>AI analysis</h3>
                            </header>
                            <div class="tutor-head-ai-verdicts">
                                <div><strong>Session validity</strong><span>@assessment.Validity</span></div>
                                <div><strong>Topic coverage</strong><span>@assessment.TopicCoverage</span></div>
                                <div><strong>Transcript duration</strong><span>@assessment.TranscriptDuration</span></div>
                            </div>
                            <p>@assessment.Summary</p>
                            <div class="tutor-head-ai-lists">
                                <div class="tutor-head-ai-list tutor-head-ai-list--winning">
                                    <h3>Winning points</h3>
                                    @if (assessment.Evidence.Count == 0)
                                    {
                                        <p>No winning points identified.</p>
                                    }
                                    else
                                    {
                                        <ul>@foreach (string item in assessment.Evidence) { <li><mark class="tutor-head-ai-highlight tutor-head-ai-highlight--winning">@item</mark></li> }</ul>
                                    }
                                </div>
                                <div class="tutor-head-ai-list tutor-head-ai-list--discrepancy">
                                    <h3>Discrepancies</h3>
                                    @if (assessment.Concerns.Count == 0)
                                    {
                                        <p>No discrepancies identified in the supplied evidence.</p>
                                    }
                                    else
                                    {
                                        <ul>@foreach (string item in assessment.Concerns) { <li><mark class="tutor-head-ai-highlight tutor-head-ai-highlight--discrepancy">@item</mark></li> }</ul>
                                    }
                                </div>
                            </div>
                            <div class="tutor-head-ai-recommendation">
                                <strong>Suggested next step</strong>
                                <p>@assessment.Recommendation</p>
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="modal fade admin-session-summary-modal" id="session-summary-modal"
         tabindex="-1" aria-labelledby="session-summary-title" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h2 class="modal-title" id="session-summary-title">Session Summary</h2>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <dl class="admin-session-summary-grid">
                        <div><dt>Tutor</dt><dd>@tutorName</dd></div>
                        <div><dt>Student</dt><dd>@session.StudentName</dd></div>
                        <div><dt>Module</dt><dd>@session.ProgrammeModule.ModuleCode · @session.ProgrammeModule.ModuleName</dd></div>
                        <div><dt>Date and time</dt><dd>@localStart.ToString("dd MMM yyyy"), @localStart.ToString("HH:mm")&ndash;@localEnd.ToString("HH:mm")</dd></div>
                        <div><dt>Location</dt><dd>@session.Location</dd></div>
                        <div><dt>Duration</dt><dd>@((int)session.Duration) hour@(session.Duration == SessionDuration.OneHour ? "" : "s")</dd></div>
                        <div class="admin-session-summary-wide">
                            <dt>Session summary</dt>
                            <dd class="admin-session-prose">@(string.IsNullOrWhiteSpace(session.Summary) ? "No session summary was provided." : session.Summary)</dd>
                        </div>
                    </dl>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/components/navigation-drawer.js"
            asp-append-version="true"></script>
    <script src="~/js/admin-session-details.js" asp-append-version="true"></script>
    <script src="~/js/tutor-head-session-details.js" asp-append-version="true"></script>
}
