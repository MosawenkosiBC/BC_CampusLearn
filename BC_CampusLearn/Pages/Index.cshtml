<div class="getToKnow p-0">
    <h2 class="p-0 mb-3 text-center">Get To Know Your Tutors</h2>
    <p class="p-0 text-center">
        Browse through our featured tutors and find the right support for your courses.
        Each tutor is here to help you excel in your <span class="course">BComp, BIT, and Diploma modules</span>
    </p>
    <div class="top-tutors mt-4">
    </div>

    <div class="top-tutors-slider mt-4">
        <div class="top-tutors-static" id="topTutorsStaticSlider">
            @foreach (var tutor in Model.FeaturedTutors)
            {
                <a asp-page="/Tutors/Details"
                   asp-route-id="@tutor.TutorId"
                    class="static-tutor-card text-decoration-none text-dark">
                    <div class="static-tutor-image-frame">
                        @if (!string.IsNullOrWhiteSpace(tutor.ProfileImagePath))
                        {
                            <img src="@tutor.ProfileImagePath"
                                 alt="Profile photo of @tutor.DisplayName" />
                        }
                        else
                        {
                            <span class="static-tutor-initials"
                                  aria-label="@tutor.DisplayName initials">
                                @tutor.Initials
                            </span>
                        }
                    </div>
                    <h4>@tutor.DisplayName <i class="bi bi-patch-check-fill"></i></h4>
                    <p class="static-tutor-program">@tutor.ProgrammeName</p>
                    <p class="static-tutor-meta">Year @tutor.YearOfStudy tutor</p>
                </a>
            }
        </div>

        @if (Model.FeaturedTutors.Count > 1)
        {
            <div class="top-tutors-dots" aria-label="Tutor carousel navigation">
                @for (int index = 0; index < Model.FeaturedTutors.Count; index++)
                {
                    <button type="button"
                            class="top-tutors-dot @(index == 0 ? "active" : null)"
                            aria-label="Show tutor @(index + 1)"></button>
                }
            </div>
        }
    </div>

    <div class="p-0 mb-4" style="text-align:center">
        <a class="btn btn-primary"
           style="background-color:#AD0151; border-color:#AD0151;"
           asp-page="/Tutors/Index">Meet All Tutors</a>
    </div>
</div>

<script>
    (() => {
        const slider = document.getElementById('topTutorsStaticSlider');
        const dots = document.querySelectorAll('.top-tutors-dot');
        const cards = slider ? slider.querySelectorAll('.static-tutor-card') : [];

        if (!slider || !dots.length || !cards.length) return;

        const setActiveDot = () => {
            const activeIndex = Array.from(cards).reduce((closestIndex, card, index) => {
                const currentDistance = Math.abs(card.offsetLeft - slider.scrollLeft);
                const closestDistance = Math.abs(cards[closestIndex].offsetLeft - slider.scrollLeft);
                return currentDistance < closestDistance ? index : closestIndex;
            }, 0);

            dots.forEach((dot, index) => dot.classList.toggle('active', index === activeIndex));
        };

        dots.forEach((dot, index) => {
            dot.addEventListener('click', () => {
                cards[index].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
            });
        });

        slider.addEventListener('scroll', setActiveDot, { passive: true });
    })();
</script>

@if (Model.ActiveEvents.Count > 0)
{
    <section class="home-events" aria-labelledby="home-events-title" data-event-carousel>
        <div class="home-events-heading">
            <div>
                <h2 id="home-events-title">Campus Events</h2>
            </div>
            @if (Model.ActiveEvents.Count > 1)
            {
                <p><span data-event-current>1</span> / @Model.ActiveEvents.Count</p>
            }
        </div>

        <div class="home-event-track" aria-live="polite">
            @for (int index = 0; index < Model.ActiveEvents.Count; index++)
            {
                var campusEvent = Model.ActiveEvents[index];
                <article class="home-event-card" data-event-card hidden="@(index != 0)">
                    <div class="home-event-banner">
                        @if (!string.IsNullOrWhiteSpace(campusEvent.BannerImagePath))
                        {
                            <img src="@campusEvent.BannerImagePath"
                                 alt="Banner for @campusEvent.Title" />
                        }
                        else
                        {
                            <div class="home-event-banner-placeholder" aria-hidden="true">
                                <i class="bi bi-calendar-event"></i>
                                <span>Campus event</span>
                            </div>
                        }
                    </div>
                    <div class="home-event-information">
                        <div>
                            <h3>@campusEvent.Title</h3>
                            <p class="home-event-description">@campusEvent.Description</p>
                        </div>
                        <dl>
                            <div>
                                <dt>Date and time</dt>
                                <dd>@campusEvent.StartsAt.ToOffset(TimeSpan.FromHours(2)).ToString("dd MMM yyyy, HH:mm")</dd>
                            </div>
                            <div><dt>Location</dt><dd>@campusEvent.Location</dd></div>
                            @if (!string.IsNullOrWhiteSpace(campusEvent.Disclaimer))
                            {
                                <div><dt>Disclaimer</dt><dd>@campusEvent.Disclaimer</dd></div>
                            }
                            @foreach (var detail in campusEvent.Details)
                            {
                                @if (detail.DataType == CampusEventDetailDataType.Url)
                                {
                                    <div class="home-event-link-detail">
                                        <dt class="visually-hidden">Event link</dt>
                                        <dd>
                                            <a class="home-event-detail-button"
                                               href="@detail.Value"
                                               target="_blank"
                                               rel="noopener noreferrer">
                                                @detail.Title
                                            </a>
                                        </dd>
                                    </div>
                                }
                                else
                                {
                                    <div>
                                        <dt>@detail.Title</dt>
                                        <dd>
                                        @if (detail.DataType == CampusEventDetailDataType.Email)
                                        {
                                            <a href="mailto:@detail.Value">@detail.Value</a>
                                        }
                                        else if (detail.DataType == CampusEventDetailDataType.YesNo)
                                        {
                                            @(bool.TryParse(detail.Value, out bool answer) && answer ? "Yes" : "No")
                                        }
                                        else
                                        {
                                            @detail.Value
                                        }
                                        </dd>
                                    </div>
                                }
                            }
                        </dl>
                    </div>
                </article>
            }
        </div>

        @if (Model.ActiveEvents.Count > 1)
        {
            <div class="home-event-controls">
                <button type="button" class="event-nav-button" data-event-previous aria-label="Previous event">
                    <i class="bi bi-caret-left-fill" aria-hidden="true"></i>
                </button>
                <div class="home-event-dots" aria-label="Event carousel navigation">
                    @for (int index = 0; index < Model.ActiveEvents.Count; index++)
                    {
                        <button type="button" data-event-dot
                                class="@(index == 0 ? "is-active" : null)"
                                aria-label="Show event @(index + 1)"></button>
                    }
                </div>
                <button type="button" class="event-nav-button" data-event-next aria-label="Next event">
                    <i class="bi bi-caret-right-fill" aria-hidden="true"></i>
                </button>
            </div>
        }
    </section>
}

<script src="~/js/home-events.js" asp-append-version="true"></script>

