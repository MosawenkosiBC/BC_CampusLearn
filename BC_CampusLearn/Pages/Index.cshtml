<div class="getToKnow p-0">
    <h2 class="p-0 mb-3 text-center">Get To Know Your Tutors</h2>
    <p class="p-0 text-center">
        Browse through our featured tutors and find the right support for your courses.
        Each tutor is here to help you excel in your <span class="course">BCom, BIT, and Diploma modules</span>
    </p>
    <div class="top-tutors mt-4">
    </div>

    <div class="top-tutors-slider mt-4">
        <div class="top-tutors-static" id="topTutorsStaticSlider">
            @foreach (var tutor in Model.FeaturedTutors)
            {
                <a asp-page="/Tutors/Details"
                   asp-route-id="@tutor.TutorId"
                   class="static-tutor-card text-decoration-none text-dark">
                    <div class="static-tutor-image-frame">
                        <img src="@tutor.ProfileImagePath"
                             alt="@tutor.DisplayName" />
                    </div>
                    <h4>@tutor.DisplayName <i class="bi bi-patch-check-fill"></i></h4>
                    <p class="static-tutor-program">@tutor.ProgrammeName</p>
                    <p class="static-tutor-meta">Year @tutor.YearOfStudy tutor</p>
                </a>
            }
        </div>

        @if (Model.FeaturedTutors.Count > 1)
        {
            <div class="top-tutors-dots" aria-label="Tutor carousel navigation">
                @for (int index = 0; index < Model.FeaturedTutors.Count; index++)
                {
                    <button type="button"
                            class="top-tutors-dot @(index == 0 ? "active" : null)"
                            aria-label="Show tutor @(index + 1)"></button>
                }
            </div>
        }
    </div>

    <div class="p-0 mb-4" style="text-align:center">
        <a class="btn btn-primary"
           style="background-color:#AD0151; border-color:#AD0151;"
           asp-page="/Tutors/Index">Meet All Tutors</a>
    </div>
</div>

<script>
    (() => {
        const slider = document.getElementById('topTutorsStaticSlider');
        const dots = document.querySelectorAll('.top-tutors-dot');
        const cards = slider ? slider.querySelectorAll('.static-tutor-card') : [];

        if (!slider || !dots.length || !cards.length) return;

        const setActiveDot = () => {
            const activeIndex = Array.from(cards).reduce((closestIndex, card, index) => {
                const currentDistance = Math.abs(card.offsetLeft - slider.scrollLeft);
                const closestDistance = Math.abs(cards[closestIndex].offsetLeft - slider.scrollLeft);
                return currentDistance < closestDistance ? index : closestIndex;
            }, 0);

            dots.forEach((dot, index) => dot.classList.toggle('active', index === activeIndex));
        };

        dots.forEach((dot, index) => {
            dot.addEventListener('click', () => {
                cards[index].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
            });
        });

        slider.addEventListener('scroll', setActiveDot, { passive: true });
    })();
</script>

<style>
    .event-nav-button {
        width: 46px;
        height: 46px;
        border: 2px solid #fff;
        border-radius: 50%;
        background-color: transparent;
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: background-color .2s ease, border-color .2s ease, box-shadow .2s ease, transform .2s ease;
    }

    .event-nav-button:hover {
        background-color: rgba(74, 193, 193, .25);
        border-color: #4AC1C1;
        box-shadow: 0 0 0 4px rgba(74, 193, 193, .18);
        transform: translateY(-2px);
    }

    .event-nav-button i {
        color: #fff;
        font-size: 1.25rem;
        line-height: 1;
    }
</style>

