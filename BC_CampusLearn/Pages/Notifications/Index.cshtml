@page "/Notifications"
@model BC_CampusLearn.Pages.Notifications.IndexModel

@{
    ViewData["Title"] = "Notifications";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Dashboard.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/components/pagination.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/notifications.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/components/navigation-drawer.css"
          asp-append-version="true" />
}

@await Html.PartialAsync(
    "~/Pages/Shared/Components/NavigationDrawer/_NavigationDrawer.cshtml")

<main class="notifications-page" aria-labelledby="notifications-title">
    <header class="notifications-header">
        <h1 id="notifications-title">Notifications</h1>
        @if (Model.Notifications.Count > 0)
        {
            <button type="button"
                    class="notifications-select-toggle"
                    data-notification-selection-toggle
                    aria-controls="notification-selection-form"
                    aria-expanded="false">
                Select
            </button>
        }
    </header>

    @if (Model.Notifications.Count == 0)
    {
        <section class="notifications-empty" aria-live="polite">
            <span aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" />
                </svg>
            </span>
            <h2>No notifications</h2>
            <p>There is nothing to show here yet.</p>
        </section>
    }
    else
    {
        <form method="post"
              asp-page-handler="BulkAction"
              id="notification-selection-form"
              class="notification-selection-form"
              data-notification-selection-form
              data-total-notifications="@Model.TotalCount"
              data-unread-notifications="@Model.UnreadCount">
            <input type="hidden"
                   name="currentPage"
                   value="@Model.CurrentPage" />
            <input type="hidden"
                   name="selectAll"
                   value="false"
                   data-notification-select-all-value />

            <div class="notification-selection-toolbar"
                 data-notification-selection-toolbar
                 hidden>
                <label class="notification-select-all">
                    <input type="checkbox"
                           data-notification-select-all />
                    <span>Select All</span>
                </label>
                <span class="notification-selection-count"
                      data-notification-selection-count
                      aria-live="polite">0 selected</span>
                <span class="notification-selection-actions">
                    <button type="submit"
                            name="notificationAction"
                            value="mark-read"
                            data-notification-mark-read
                            data-notification-selection-action
                            hidden
                            disabled>
                        Mark as read
                    </button>
                    <button type="submit"
                            name="notificationAction"
                            value="delete"
                            class="notification-delete-selected"
                            data-notification-selection-action
                            data-notification-delete
                            aria-label="Delete selected notifications"
                            disabled>
                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="1em"
                             height="1em"
                             viewBox="0 0 24 24"
                             aria-hidden="true">
                            <path d="M0 0h24v24H0z" fill="none" />
                            <path fill="none"
                                  stroke="currentColor"
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="1.5"
                                  d="M1 5h22m-8.75-4h-4.5a1.5 1.5 0 0 0-1.5 1.5V5h7.5V2.5a1.5 1.5 0 0 0-1.5-1.5m-4.5 16.75v-7.5m4.5 7.5v-7.5m4.61 11.37A1.49 1.49 0 0 1 17.37 23H6.63a1.49 1.49 0 0 1-1.49-1.38L3.75 5h16.5z" />
                        </svg>
                        <span>Delete</span>
                    </button>
                </span>
            </div>

            <ol class="notifications-list">
                @foreach (var notification in Model.Notifications)
                {
                    DateTimeOffset localCreatedAt = notification.CreatedAt
                        .ToOffset(TimeSpan.FromHours(2));
                    bool isUnread = !notification.ReadAt.HasValue;
                    <li class="notification-row @(isUnread ? "is-unread" : "is-read")"
                        data-notification-row>
                        <label class="notification-select-control">
                            <input type="checkbox"
                                   name="selectedNotificationIds"
                                   value="@notification.NotificationId"
                                   data-notification-checkbox />
                            <span class="visually-hidden">
                                Select @notification.Title
                            </span>
                        </label>
                        <time class="notification-date"
                              datetime="@notification.CreatedAt.ToString("O")">
                            @localCreatedAt.ToString("dd/MM/yyyy")
                        </time>
                        <a class="notification-card"
                           asp-page="/Notifications/Index"
                           asp-route-notificationId="@notification.NotificationId"
                           aria-label="Open @notification.Title notification">
                            <span class="notification-card-content">
                                <span class="notification-card-copy">
                                    <strong>@notification.Title</strong>
                                    <span class="@(notification.HighlightedClosingDate is not null ? "notification-card-message--application" : null)">
                                        @notification.PreviewMessage
                                    </span>
                                </span>
                                <time datetime="@notification.CreatedAt.ToString("O")">
                                    @localCreatedAt.ToString("HH:mm")
                                </time>
                            </span>
                            @if (isUnread)
                            {
                                <span class="notification-unread-dot"
                                      aria-label="Unread"></span>
                            }
                        </a>
                    </li>
                }
            </ol>

            @if (Model.TotalPages > 1)
            {
                @await Component.InvokeAsync(
                    "Pagination",
                    new
                    {
                        currentPage = Model.CurrentPage,
                        totalPages = Model.TotalPages,
                        ariaLabel = "Notifications pages",
                        pageRouteValueName = "CurrentPage",
                        excludedQueryKeys = new[] { "notificationId" }
                    })
            }
        </form>
    }
</main>

<dialog class="notification-delete-modal"
        data-notification-delete-modal
        aria-labelledby="notification-delete-title"
        aria-describedby="notification-delete-message">
    <div class="notification-delete-modal-header">
        <h2 id="notification-delete-title">Delete notifications?</h2>
        <button type="button"
                class="notification-modal-close"
                data-notification-delete-cancel
                aria-label="Cancel deletion">
            &times;
        </button>
    </div>
    <div class="notification-delete-modal-body">
        <p id="notification-delete-message">
            Are you sure you want to delete
            <strong data-notification-delete-scope></strong>?
            This cannot be undone.
        </p>
    </div>
    <div class="notification-delete-modal-footer">
        <button type="button"
                class="notification-delete-cancel"
                data-notification-delete-cancel>
            Cancel
        </button>
        <button type="button"
                class="notification-delete-confirm"
                data-notification-delete-confirm>
            Delete
        </button>
    </div>
</dialog>

@if (Model.SelectedNotification is not null)
{
    DateTimeOffset selectedLocalCreatedAt = Model.SelectedNotification.CreatedAt
        .ToOffset(TimeSpan.FromHours(2));
    <dialog class="notification-modal @(Model.SelectedNotification.IsTutorApprovalNotification ? "notification-modal--approval" : null)"
            data-notification-modal
            aria-labelledby="notification-modal-title">
        <div class="notification-modal-header">
            <h2 id="notification-modal-title">
                @Model.SelectedNotification.Title
            </h2>
            <button type="button"
                    class="notification-modal-close"
                    data-notification-modal-close
                    aria-label="Close notification">
                &times;
            </button>
        </div>
        <div class="notification-modal-body">
            <time datetime="@Model.SelectedNotification.CreatedAt.ToString("O")">
                @selectedLocalCreatedAt.ToString("dd MMMM yyyy 'at' HH:mm")
            </time>
            <p class="@(Model.SelectedNotification.HighlightedClosingDate is not null
                ? "notification-modal-message--application"
                : Model.SelectedNotification.IsTutorApprovalNotification
                    ? "notification-modal-message--approval"
                    : null)">
                @if (Model.SelectedNotification.IsTutorApprovalNotification)
                {
                    <span class="notification-message-summary"><button type="button"
                            class="notification-congratulations"
                            data-confetti-trigger
                            aria-label="Celebrate your tutor approval">Congratulations!</button><text> @Model.SelectedNotification.TutorApprovalMessage</text></span>
                }
                else
                {
                    <span class="notification-message-summary">@Model.SelectedNotification.SummaryMessage</span>
                }
                @if (Model.SelectedNotification.HighlightedClosingDate is not null)
                {
                    <strong class="tutor-application-closing-date">
                        Applications close: @Model.SelectedNotification.HighlightedClosingDate
                    </strong>
                }
            </p>
        </div>
        <div class="notification-modal-footer">
            <button type="button"
                    class="notification-modal-dismiss"
                    data-notification-modal-close>
                Close
            </button>
            @if (Model.SelectedNotification.ActionLabel is not null)
            {
                <a class="notification-modal-action"
                   href="/Notifications/Open/@Model.SelectedNotification.NotificationId">
                    @Model.SelectedNotification.ActionLabel
                </a>
            }
        </div>
    </dialog>
}

@section Scripts {
    <script src="~/js/components/navigation-drawer.js"
            asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
}
