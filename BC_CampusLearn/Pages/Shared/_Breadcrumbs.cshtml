@{
    var pagePath = ViewContext.RouteData.Values["Page"]?.ToString() ?? "/Index";
    var pageTitle = ViewData["Title"]?.ToString();
    var breadcrumbs = new List<(string Label, string? Page)>();
    var compensationReturnUrl = ViewData["CompensationReturnUrl"] as string;
    var hasAdminRole = User.IsInRole(nameof(BcUserRole.Admin)) ||
        User.IsInRole(nameof(BcUserRole.SuperAdmin)) ||
        User.IsInRole(nameof(BcUserRole.Dev));
    var isAdministrator = pagePath.StartsWith("/Administrator/", StringComparison.OrdinalIgnoreCase) ||
        (hasAdminRole && pagePath.Equals(
            "/LearningResources/Details",
            StringComparison.OrdinalIgnoreCase));
    var isTutor = User.IsInRole(nameof(BcUserRole.Tutor)) ||
        User.IsInRole(nameof(BcUserRole.HeadOfTutors));
    var dashboardPage = isAdministrator
        ? "/Administrator/Admin/Dashboard"
        : isTutor
            ? "/Tutors/TutorDashboard"
            : "/Student/Dashboard";
    var dashboardLabel = !isAdministrator && isTutor
        ? "Tutor Dashboard"
        : "Dashboard";

    void AddDashboard()
    {
        breadcrumbs.Add((dashboardLabel, pagePath == dashboardPage ? null : dashboardPage));
    }

    if (!pagePath.Equals(dashboardPage, StringComparison.OrdinalIgnoreCase))
    {
        AddDashboard();
    }

    switch (pagePath)
    {
        case "/Index":
            break;
        case "/Administrator/Admin/Dashboard":
            breadcrumbs.Add(("Dashboard", null));
            break;
        case "/Administrator/Admin/Statistics":
            breadcrumbs.Add(("Statistics", null));
            break;
        case "/Administrator/Admin/Applications":
            breadcrumbs.Add(("Applications", null));
            break;
        case "/Administrator/Admin/BookingsAndSessions":
            breadcrumbs.Add(("Bookings and Sessions", null));
            break;
        case "/Administrator/Events/Index":
            breadcrumbs.Add(("Events", null));
            break;
        case "/Administrator/Events/Create":
            breadcrumbs.Add(("Events", "/Administrator/Events/Index"));
            breadcrumbs.Add(("Create Event", null));
            break;
        case "/Administrator/Events/Edit":
            breadcrumbs.Add(("Events", "/Administrator/Events/Index"));
            breadcrumbs.Add(("Edit Event", null));
            break;
        case "/Administrator/Admin/ApplicationDetails":
            breadcrumbs.Add(("Applications", "/Administrator/Admin/Applications"));
            breadcrumbs.Add(("Application Details", null));
            break;
        case "/Administrator/Tutors/Index":
            breadcrumbs.Add(("Tutors", null));
            break;
        case "/Administrator/Tutors/Profile":
            breadcrumbs.Add(compensationReturnUrl is not null
                ? ("Compensation", "/Administrator/Admin/Compensation")
                : ("Tutors", "/Administrator/Tutors/Index"));
            breadcrumbs.Add(("Tutor Profile", null));
            break;
        case "/Administrator/Tutors/SeniorTutorApplicationDetails":
            breadcrumbs.Add(("Tutors", "/Administrator/Tutors/Index"));
            breadcrumbs.Add(("Senior Tutor Application", null));
            break;
        case "/Administrator/Tutors/SessionDetails":
            breadcrumbs.Add(("Bookings and Sessions", "/Administrator/Admin/BookingsAndSessions"));
            breadcrumbs.Add(("Session Details", null));
            break;
        case "/Administrator/Modules/Index":
            breadcrumbs.Add(("Modules", null));
            break;
        case "/Administrator/Modules/Details":
            breadcrumbs.Add(("Modules", "/Administrator/Modules/Index"));
            breadcrumbs.Add((pageTitle ?? "Module details", null));
            break;
        case "/Administrator/LearningResources/Index":
            breadcrumbs.Add(("Learning Resources", null));
            break;
        case "/Student/Dashboard":
            breadcrumbs.Add(("Dashboard", null));
            break;
        case "/Bookings/Index":
            breadcrumbs.Add(("All Sessions", null));
            break;
        case "/Bookings/SessionDetails":
            breadcrumbs.Add(("All Sessions", "/Bookings/Index"));
            breadcrumbs.Add(("Session Details", null));
            break;
        case "/Bookings/Create":
            breadcrumbs.Add(("Tutors", "/Tutors/Index"));
            breadcrumbs.Add(("Book Session", null));
            break;
        case "/Bookings/Unavailable":
            breadcrumbs.Add(("Tutors", "/Tutors/Index"));
            breadcrumbs.Add((pageTitle ?? "Session Unavailable", null));
            break;
        case "/Tutors/Index":
            breadcrumbs.Add(("Tutors", null));
            break;
        case "/Tutors/Details":
            breadcrumbs.Add(("Tutors", "/Tutors/Index"));
            breadcrumbs.Add(("Tutor Details", null));
            break;
        case "/Tutors/TutorApplication":
            breadcrumbs.Add(("Tutors", "/Tutors/Index"));
            breadcrumbs.Add(("Tutor Application", null));
            break;
        case "/Tutors/TutorDashboard":
            breadcrumbs.Add((dashboardLabel, null));
            break;
        case "/Tutors/Sessions":
            breadcrumbs.Add(("All Sessions", null));
            break;
        case "/Tutors/SessionDetails":
            breadcrumbs.Add(("All Sessions", "/Tutors/Sessions"));
            breadcrumbs.Add(("Session Details", null));
            break;
        case "/Tutors/ManageAvailability":
            breadcrumbs.Add(("Manage Availability", null));
            break;
        case "/Tutors/ManageResources":
            breadcrumbs.Add(("Manage Resources", null));
            break;
        case "/Tutors/Profile":
            breadcrumbs.Add(("Personal Details", null));
            break;
        case "/Tutors/PublicProfile":
            breadcrumbs.Add(("Personal Details", "/Tutors/Profile"));
            breadcrumbs.Add(("Public Profile", null));
            break;
        case "/Tutors/StatisticsOverview":
            breadcrumbs.Add(("Personal Details", "/Tutors/Profile"));
            breadcrumbs.Add(("Statistics Overview", null));
            break;
        case "/Tutors/SeniorTutorApplications":
            breadcrumbs.Add(("Personal Details", "/Tutors/Profile"));
            breadcrumbs.Add(("Senior Tutor Applications", null));
            break;
        case "/TutorHead/SessionReviews":
            breadcrumbs.Add(("Session Reviews", null));
            break;
        case "/TutorHead/SessionDetails":
            breadcrumbs.Add(("Session Reviews", "/TutorHead/SessionReviews"));
            breadcrumbs.Add(("Session Details", null));
            break;
        case "/TutorHead/ManageResources":
            breadcrumbs.Add(("Manage Resources", null));
            break;
        case "/LearningResources/Index":
            breadcrumbs.Add(("Learning Resources", null));
            break;
        case "/LearningResources/Details":
            breadcrumbs.Add((
                "Learning Resources",
                isAdministrator
                    ? "/Administrator/LearningResources/Index"
                    : User.IsInRole(nameof(BcUserRole.HeadOfTutors))
                        ? "/TutorHead/ManageResources"
                    : "/LearningResources/Index"));
            breadcrumbs.Add(("Resource Details", null));
            break;
        case "/Account/SignIn":
            breadcrumbs.Add(("Log In", null));
            break;
        case "/Account/AccessDenied":
            breadcrumbs.Add(("Access Denied", null));
            break;
        case "/Account/PostLogin":
            breadcrumbs.Add(("Signing In", null));
            break;
        case "/Account/SignOut":
            breadcrumbs.Add(("Signing Out", null));
            break;
        case "/Privacy":
            breadcrumbs.Add(("Privacy Policy", null));
            break;
        case "/Error":
            breadcrumbs.Add(("Error", null));
            break;
        case "/NotFound":
            breadcrumbs.Add(("Page Not Found", null));
            break;
        default:
            var fallbackLabel = pageTitle;
            if (string.IsNullOrWhiteSpace(fallbackLabel))
            {
                fallbackLabel = pagePath
                    .Split('/', StringSplitOptions.RemoveEmptyEntries)
                    .LastOrDefault()?
                    .Replace("-", " ") ?? "Page";
            }

            breadcrumbs.Add((fallbackLabel, null));
            break;
    }

    if (breadcrumbs.Count >= 4)
    {
        breadcrumbs =
        [
            breadcrumbs[0],
            ("...", null),
            breadcrumbs[^2],
            breadcrumbs[^1]
        ];
    }
}

@if (pagePath is not "/Index" and not "/Account/SignIn")
{
    <nav class="campus-breadcrumbs" aria-label="Breadcrumb">
        <ol class="campus-breadcrumbs-list">
            @for (var index = 0; index < breadcrumbs.Count; index++)
            {
                var breadcrumb = breadcrumbs[index];
                var isCurrent = index == breadcrumbs.Count - 1;
                var isCollapsed = breadcrumb.Label == "...";
                var useCompactMobileLabel = isCurrent && pagePath == "/Tutors/SeniorTutorApplications";

                <li class="campus-breadcrumbs-item@(isCurrent ? " is-current" : null)@(isCollapsed ? " is-collapsed" : null)"
                    @if (isCurrent)
                    {
                        <text>aria-current="page"</text>
                    }
                    @if (isCollapsed)
                    {
                        <text>aria-hidden="true"</text>
                    }>
                    @if (!string.IsNullOrWhiteSpace(breadcrumb.Page))
                    {
                        if (breadcrumb.Page == "/Administrator/Admin/Compensation" && compensationReturnUrl is not null)
                        {
                            <a href="@compensationReturnUrl" title="@breadcrumb.Label">@breadcrumb.Label</a>
                        }
                        else if (breadcrumb.Page == "/Administrator/Tutors/Profile" &&
                            ViewData["AdminTutorProfileId"] is int tutorId)
                        {
                            <a asp-page="@breadcrumb.Page" asp-route-id="@tutorId"
                               title="@breadcrumb.Label">@breadcrumb.Label</a>
                        }
                        else
                        {
                            <a asp-page="@breadcrumb.Page" title="@breadcrumb.Label">@breadcrumb.Label</a>
                        }
                    }
                    else
                    {
                        if (useCompactMobileLabel)
                        {
                            <span class="campus-breadcrumb-label-compact-mobile"
                                  data-mobile-label="ST Applications"
                                  title="@breadcrumb.Label">@breadcrumb.Label</span>
                        }
                        else
                        {
                            <span title="@(isCollapsed ? null : breadcrumb.Label)">@breadcrumb.Label</span>
                        }
                    }
                </li>
            }
        </ol>
    </nav>
}
