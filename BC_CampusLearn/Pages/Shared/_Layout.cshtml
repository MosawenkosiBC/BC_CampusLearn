@using BC_CampusLearn.Authentication

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CampusLearn</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CampusLearn.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    @RenderSection("Styles", false)

    <style>
        footer h5 {
            color: #fff;
            font-size: 1.5rem;
            font-weight: 700;
        }

        footer h5::after {
            content: "";
            display: block;
            width: 62px;
            height: 2px;
            margin-top: 10px;
            background-color: #4AC1C1;
        }

        footer p,
        footer li,
        footer a {
            color: #fff;
            font-size: 0.95rem;
        }

        footer a {
            text-decoration: none;
        }

        footer a:hover {
            color: #4AC1C1;
        }

        footer i {
            color: #fff;
        }

        .footer-links {
            margin: 0;
            padding-left: 1.3rem;
        }

        .footer-links li {
            margin-bottom: 7px;
        }

        footer .logo-box img {
            max-width: 230px;
            filter: brightness(0) invert(1);
        }

        @@media (max-width: 767.98px) {
            footer .container {
                max-width: 420px;
                margin-left: 0;
                padding-left: 26px;
                padding-right: 26px;
            }

            footer h5 {
                font-size: 1.55rem;
            }

            footer p,
            footer li,
            footer a {
                font-size: 0.82rem;
            }

            footer .logo-box {
                text-align: left;
            }

            footer .logo-box img {
                max-width: 260px;
            }
        }

        .navbar-nav .nav-link.active {
            border-bottom: 4px solid #4AC1C1;
            color: #000 !important;
            font-weight: 600;
        }

        .navbar-brand {
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
        }

        .navbar-brand-title {
            margin: 0;
            color: #1E1E1E;
            font-family: var(--campus-font-family);
            font-size: 1.35rem;
            font-weight: 600;
            line-height: 1;
            white-space: nowrap;
        }

        .navbar-nav .sign-in-button {
            align-self: center;
            margin-left: 1.5rem;
            padding: 0.5rem 1.25rem;
            color: #fff;
            background-color: #1E1E1E;
            border: 1px solid #1E1E1E;
            border-radius: 0.375rem;
            font-weight: 600;
            text-decoration: none;
        }

        .navbar-nav .sign-in-button:hover,
        .navbar-nav .sign-in-button:focus {
            color: #fff;
            background-color: #333;
            border-color: #333;
        }

        .navbar-nav .sign-in-button:focus-visible {
            outline: 3px solid rgba(74, 193, 193, 0.35);
            outline-offset: 2px;
        }

        .navbar-user-actions {
            flex-direction: row;
            align-items: center;
            margin-left: auto;
        }

        @@media (min-width: 576px) {
            .navbar-collapse {
                width: 100%;
                flex-grow: 1;
            }

            .navbar-primary-nav {
                justify-content: flex-end;
            }
        }

        .navbar-action-divider {
            width: 1px;
            height: 34px;
            margin: 0 0.5rem;
            background-color: #d8d8d8;
        }

        .navbar-action-button {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            padding: 0;
            color: #888888;
            background: transparent;
            border: 0;
            border-radius: 50%;
        }

        .navbar-action-button:hover,
        .navbar-action-button:focus {
            color: #666;
            background-color: #f3f3f3;
        }

        .navbar-action-button:focus-visible {
            outline: 3px solid rgba(74, 193, 193, 0.35);
            outline-offset: 2px;
        }

        .navbar-action-button svg {
            width: 22px;
            height: 22px;
        }

        .notification-indicator {
            position: absolute;
            top: 8px;
            right: 8px;
            width: 7px;
            height: 7px;
            background-color: #d83367;
            border: 1px solid #fff;
            border-radius: 50%;
        }

        .navbar-toggler {
            padding: 0.5rem;
            border: 0;
            box-shadow: none !important;
        }

        .navbar-toggler:focus-visible {
            outline: 3px solid rgba(74, 193, 193, 0.35);
            outline-offset: 2px;
        }

        .menu-toggle-icon {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            width: 28px;
            height: 18px;
        }

        .menu-toggle-icon span {
            display: block;
            height: 1.5px;
            background-color: #1E1E1E;
            border-radius: 2px;
            transition: width 0.2s ease, transform 0.2s ease, opacity 0.2s ease;
        }

        .menu-toggle-icon span:nth-child(1) {
            width: 18px;
            align-self: flex-start;
        }

        .menu-toggle-icon span:nth-child(2) {
            width: 28px;
        }

        .menu-toggle-icon span:nth-child(3) {
            width: 18px;
            align-self: flex-end;
        }

        .navbar-toggler[aria-expanded="true"] .menu-toggle-icon span:nth-child(1) {
            width: 24px;
            align-self: center;
            transform: translateY(8px) rotate(45deg);
        }

        .navbar-toggler[aria-expanded="true"] .menu-toggle-icon span:nth-child(2) {
            opacity: 0;
        }

        .navbar-toggler[aria-expanded="true"] .menu-toggle-icon span:nth-child(3) {
            width: 24px;
            align-self: center;
            transform: translateY(-8px) rotate(-45deg);
        }

        .user-menu {
            align-self: center;
            margin-left: 0.25rem;
        }

        .user-menu-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 0;
            color: #1E1E1E;
            background: transparent;
            border: 0;
        }

        .user-menu-initials {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 44px;
            height: 44px;
            background-color: #EAEAEA;
            border: 1px solid #EAEAEA;
            border-radius: 50%;
            font-weight: 600;
            line-height: 1;
        }

        .user-menu-button:hover .user-menu-initials,
        .user-menu-button:focus .user-menu-initials,
        .user-menu-button[aria-expanded="true"] .user-menu-initials {
            background-color: #d9d9d9;
            border-color: #d9d9d9;
        }

        .user-menu-button:focus-visible {
            outline: 3px solid rgba(74, 193, 193, 0.35);
            outline-offset: 2px;
        }

        .user-menu-chevron {
            width: 14px;
            height: 14px;
            transition: transform 0.2s ease;
        }

        .user-menu-button[aria-expanded="true"] .user-menu-chevron {
            transform: rotate(180deg);
        }

        .user-menu .dropdown-menu {
            min-width: 190px;
        }

        body > header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1030;
            background-color: #fff;
            box-shadow:
                0 0.35rem 0.9rem rgba(0, 0, 0, 0.08),
                0 0.08rem 0.3rem rgba(0, 0, 0, 0.04);
        }

        @@media (max-width: 575.98px) {
            .navbar .container-fluid {
                padding-left: 16px !important;
                padding-right: 16px !important;
            }

            .navbar-brand img {
                height: 44px !important;
            }

            .mobile-navbar-actions {
                margin-left: auto;
            }

            .mobile-navbar-actions .navbar-action-button {
                width: 36px;
                height: 36px;
            }

            .mobile-navbar-actions .navbar-action-button svg {
                width: 24px;
                height: 24px;
            }

            .navbar-toggler {
                margin-left: 0.25rem;
            }

            .navbar-collapse {
                padding-top: 12px;
            }

            .navbar-primary-nav {
                padding-bottom: 0.75rem;
                margin-bottom: 0.25rem;
                border-bottom: 1px solid #d8d8d8;
            }

            .navbar-primary-nav .nav-link.active {
                width: fit-content;
                padding-bottom: 0.25rem;
                border-bottom-width: 2px;
            }

            .navbar-user-actions {
                flex-direction: column;
                align-items: stretch;
                width: 100%;
                margin-left: 0;
            }

            .navbar-nav:last-child .btn {
                width: 100%;
                margin-top: 8px;
            }

            .navbar-nav:last-child .sign-in-button {
                margin-left: 0;
            }

            .user-menu {
                margin-top: 8px;
                margin-left: 0;
                width: 100%;
            }

            .user-menu-button {
                display: none;
            }

            .user-menu .dropdown-menu {
                position: static !important;
                display: block;
                min-width: 0;
                padding: 0;
                margin: 0;
                border: 0;
                box-shadow: none !important;
                transform: none !important;
            }

            .user-menu .dropdown-item {
                padding: 0.6rem 0;
            }

            .navbar-user-actions > .navbar-action-button,
            .navbar-user-actions > .navbar-action-divider {
                display: none;
            }
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow">
            <div class="container-fluid px-4">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <img src="/Media/common/CampusLearnLogo.png" alt="CampusLearn Logo" style="height:50px;" />
                    <h1 class="navbar-brand-title d-none d-xl-block">Campus Learn</h1>
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="mobile-navbar-actions d-flex align-items-center d-sm-none">
                        <button class="navbar-action-button"
                                type="button"
                                aria-label="Notifications"
                                title="Notifications">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="1em"
                                 height="1em"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true"
                                 focusable="false">
                                <path d="M0 0h24v24H0z" fill="none" />
                                <path fill="currentColor" d="M8.352 20.242A4.63 4.63 0 0 0 12 22a4.63 4.63 0 0 0 3.648-1.758a27.2 27.2 0 0 1-7.296 0M18.75 9v.704c0 .845.24 1.671.692 2.374l1.108 1.723c1.011 1.574.239 3.713-1.52 4.21a25.8 25.8 0 0 1-14.06 0c-1.759-.497-2.531-2.636-1.52-4.21l1.108-1.723a4.4 4.4 0 0 0 .693-2.374V9c0-3.866 3.022-7 6.749-7s6.75 3.134 6.75 7" />
                            </svg>
                            <span class="notification-indicator" aria-hidden="true"></span>
                        </button>

                        <button class="navbar-action-button"
                                type="button"
                                aria-label="Messages"
                                title="Messages">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 width="1em"
                                 height="1em"
                                 viewBox="0 0 24 24"
                                 aria-hidden="true"
                                 focusable="false">
                                <path d="M0 0h24v24H0z" fill="none" />
                                <path fill="currentColor" d="M4 20q-.825 0-1.412-.587T2 18V6q0-.825.588-1.412T4 4h16q.825 0 1.413.588T22 6v12q0 .825-.587 1.413T20 20zm8-7l8-5V6l-8 5l-8-5v2z" />
                            </svg>
                        </button>
                    </div>
                }
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="menu-toggle-icon" aria-hidden="true">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav navbar-primary-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Index" ? "active" : "")" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Student/Dashboard" ? "active" : "")" asp-area="" asp-page="/Student/Dashboard">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark @(ViewContext.RouteData.Values["Page"]?.ToString()?.StartsWith("/Tutors") == true ? "active" : "")" asp-area="" asp-page="/Tutors/Index">All Tutors</a>
                        </li>
                    </ul>

                    <div class="navbar-nav navbar-user-actions">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var displayName = User.FindFirst("name")?.Value
                                ?? User.Identity.Name
                                ?? "User";
                            var nameParts = displayName.Split(
                                ' ',
                                StringSplitOptions.RemoveEmptyEntries);
                            var initials = nameParts.Length > 1
                                ? $"{nameParts[0][0]}{nameParts[^1][0]}"
                                : displayName[..1];
                            initials = initials.ToUpperInvariant();
                            bool isTutor = User.HasClaim(
                                EntraClaimTypes.IsTutor,
                                bool.TrueString);

                            <span class="navbar-action-divider" aria-hidden="true"></span>

                            <button class="navbar-action-button"
                                    type="button"
                                    aria-label="Notifications"
                                    title="Notifications">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="1em"
                                     height="1em"
                                     viewBox="0 0 24 24"
                                     aria-hidden="true"
                                     focusable="false">
                                    <path d="M0 0h24v24H0z" fill="none" />
                                    <path fill="currentColor" d="M8.352 20.242A4.63 4.63 0 0 0 12 22a4.63 4.63 0 0 0 3.648-1.758a27.2 27.2 0 0 1-7.296 0M18.75 9v.704c0 .845.24 1.671.692 2.374l1.108 1.723c1.011 1.574.239 3.713-1.52 4.21a25.8 25.8 0 0 1-14.06 0c-1.759-.497-2.531-2.636-1.52-4.21l1.108-1.723a4.4 4.4 0 0 0 .693-2.374V9c0-3.866 3.022-7 6.749-7s6.75 3.134 6.75 7" />
                                </svg>
                                <span class="notification-indicator" aria-hidden="true"></span>
                            </button>

                            <button class="navbar-action-button"
                                    type="button"
                                    aria-label="Messages"
                                    title="Messages">
                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="1em"
                                     height="1em"
                                     viewBox="0 0 24 24"
                                     aria-hidden="true"
                                     focusable="false">
                                    <path d="M0 0h24v24H0z" fill="none" />
                                    <path fill="currentColor" d="M4 20q-.825 0-1.412-.587T2 18V6q0-.825.588-1.412T4 4h16q.825 0 1.413.588T22 6v12q0 .825-.587 1.413T20 20zm8-7l8-5V6l-8 5l-8-5v2z" />
                                </svg>
                            </button>

                            <span class="navbar-action-divider" aria-hidden="true"></span>

                            <div class="dropdown user-menu">
                                <button class="user-menu-button"
                                        type="button"
                                        id="userMenuDropdown"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false"
                                        aria-label="Open user menu">
                                    <span class="user-menu-initials">@initials</span>
                                    <svg class="user-menu-chevron"
                                         xmlns="http://www.w3.org/2000/svg"
                                         width="1em"
                                         height="1em"
                                         viewBox="0 0 1024 1024"
                                         aria-hidden="true"
                                         focusable="false">
                                        <path d="M0 0h1024v1024H0z" fill="none" />
                                        <path fill="currentColor" d="M831.9 340.9L512 652.7L192.1 340.9a30.6 30.6 0 0 0-42.7 0a29 29 0 0 0 0 41.6l340.3 331.7a32 32 0 0 0 44.6 0l340.3-331.7a29 29 0 0 0 0-41.7a30.6 30.6 0 0 0-42.7 0z" />
                                    </svg>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm"
                                    aria-labelledby="userMenuDropdown">
                                    @if (isTutor)
                                    {
                                        <li>
                                            <a asp-page="/Tutors/TutorDashboard"
                                               class="dropdown-item d-flex align-items-center gap-2">
                                                Tutor Dashboard
                                            </a>
                                        </li>
                                    }
                                    <li>
                                        @if (isTutor)
                                        {
                                            <a asp-page="/Tutors/Profile"
                                               class="dropdown-item d-flex align-items-center gap-2">
                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                 width="1em"
                                                 height="1em"
                                                 viewBox="0 0 24 24"
                                                 aria-hidden="true"
                                                 focusable="false">
                                                <path d="M0 0h24v24H0z" fill="none" />
                                                <g fill="none" stroke="currentColor" stroke-width="2">
                                                    <path stroke-linejoin="round" d="M4 18a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z" />
                                                    <circle cx="12" cy="7" r="3" />
                                                </g>
                                            </svg>
                                            Manage account
                                            </a>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="dropdown-item d-flex align-items-center gap-2">
                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                     width="1em"
                                                     height="1em"
                                                     viewBox="0 0 24 24"
                                                     aria-hidden="true"
                                                     focusable="false">
                                                    <path d="M0 0h24v24H0z" fill="none" />
                                                    <g fill="none" stroke="currentColor" stroke-width="2">
                                                        <path stroke-linejoin="round" d="M4 18a4 4 0 0 1 4-4h8a4 4 0 0 1 4 4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z" />
                                                        <circle cx="12" cy="7" r="3" />
                                                    </g>
                                                </svg>
                                                Manage account
                                            </button>
                                        }
                                    </li>
                                    <li>
                                        <form method="post"
                                              asp-page="/Account/SignOut">
                                            <button type="submit"
                                                    class="dropdown-item d-flex align-items-center gap-2">
                                                <svg xmlns="http://www.w3.org/2000/svg"
                                                     width="1em"
                                                     height="1em"
                                                     viewBox="0 0 24 24"
                                                     aria-hidden="true"
                                                     focusable="false">
                                                    <path d="M0 0h24v24H0z" fill="none" />
                                                    <path fill="currentColor" d="m17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4z" />
                                                </svg>
                                                Log out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-page="/Account/SignIn"
                               class="btn sign-in-button">
                                Log in
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="text-light pt-4 pb-4" style="background-color:#1E1E1E;">
        <div class="container">
            <div class="row text-start align-items-start">
                <div class="col-12 col-md-4 mb-4">
                    <h5 class="mb-3">Connect</h5>
                    <ul class="list-unstyled d-flex align-items-center gap-3 mb-0">
                        <li>
                            <a class="d-inline-flex align-items-center"
                               href="https://www.instagram.com/belgiumcampus?igsh=MWswN3hwNmZlYW5nbw=="
                               target="_blank"
                               rel="noopener noreferrer"
                               aria-label="Instagram"
                               title="Instagram">
                                <svg xmlns="http://www.w3.org/2000/svg" width="1.5em" height="1.5em" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="M0 0h24v24H0z" fill="none" />
                                    <path fill="currentColor" d="M17.34 5.46a1.2 1.2 0 1 0 1.2 1.2a1.2 1.2 0 0 0-1.2-1.2m4.6 2.42a7.6 7.6 0 0 0-.46-2.43a4.9 4.9 0 0 0-1.16-1.77a4.7 4.7 0 0 0-1.77-1.15a7.3 7.3 0 0 0-2.43-.47C15.06 2 14.72 2 12 2s-3.06 0-4.12.06a7.3 7.3 0 0 0-2.43.47a4.8 4.8 0 0 0-1.77 1.15a4.7 4.7 0 0 0-1.15 1.77a7.3 7.3 0 0 0-.47 2.43C2 8.94 2 9.28 2 12s0 3.06.06 4.12a7.3 7.3 0 0 0 .47 2.43a4.7 4.7 0 0 0 1.15 1.77a4.8 4.8 0 0 0 1.77 1.15a7.3 7.3 0 0 0 2.43.47C8.94 22 9.28 22 12 22s3.06 0 4.12-.06a7.3 7.3 0 0 0 2.43-.47a4.7 4.7 0 0 0 1.77-1.15a4.85 4.85 0 0 0 1.16-1.77a7.6 7.6 0 0 0 .46-2.43c0-1.06.06-1.4.06-4.12s0-3.06-.06-4.12M20.14 16a5.6 5.6 0 0 1-.34 1.86a3.06 3.06 0 0 1-.75 1.15a3.2 3.2 0 0 1-1.15.75a5.6 5.6 0 0 1-1.86.34c-1 .05-1.37.06-4 .06s-3 0-4-.06a5.7 5.7 0 0 1-1.94-.3a3.3 3.3 0 0 1-1.1-.75a3 3 0 0 1-.74-1.15a5.5 5.5 0 0 1-.4-1.9c0-1-.06-1.37-.06-4s0-3 .06-4a5.5 5.5 0 0 1 .35-1.9A3 3 0 0 1 5 5a3.1 3.1 0 0 1 1.1-.8A5.7 5.7 0 0 1 8 3.86c1 0 1.37-.06 4-.06s3 0 4 .06a5.6 5.6 0 0 1 1.86.34a3.06 3.06 0 0 1 1.19.8a3.1 3.1 0 0 1 .75 1.1a5.6 5.6 0 0 1 .34 1.9c.05 1 .06 1.37.06 4s-.01 3-.06 4M12 6.87A5.13 5.13 0 1 0 17.14 12A5.12 5.12 0 0 0 12 6.87m0 8.46A3.33 3.33 0 1 1 15.33 12A3.33 3.33 0 0 1 12 15.33" />
                                </svg>
                            </a>
                        </li>
