<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CampusLearn</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CampusLearn.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    @RenderSection("Styles", false)

    <style>
        footer h5 {
            color: #fff;
            font-size: 1.5rem;
            font-weight: 700;
        }

        footer h5::after {
            content: "";
            display: block;
            width: 62px;
            height: 2px;
            margin-top: 10px;
            background-color: #4AC1C1;
        }

        footer p,
        footer li,
        footer a {
            color: #fff;
            font-size: 0.95rem;
        }

        footer a {
            text-decoration: none;
        }

        footer a:hover {
            color: #4AC1C1;
        }

        footer i {
            color: #fff;
        }

        .footer-links {
            margin: 0;
            padding-left: 1.3rem;
        }

        .footer-links li {
            margin-bottom: 7px;
        }

        footer .logo-box img {
            max-width: 230px;
            filter: brightness(0) invert(1);
        }

        @@media (max-width: 767.98px) {
            footer .container {
                max-width: 420px;
                margin-left: 0;
                padding-left: 26px;
                padding-right: 26px;
            }

            footer h5 {
                font-size: 1.55rem;
            }

            footer p,
            footer li,
            footer a {
                font-size: 0.82rem;
            }

            footer .logo-box {
                text-align: left;
            }

            footer .logo-box img {
                max-width: 260px;
            }
        }

        .navbar-nav .nav-link.active {
            border-bottom: 4px solid #4AC1C1;
            color: #000 !important;
            font-weight: 600;
        }

        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1030;
        }

        @@media (max-width: 575.98px) {
            .navbar .container-fluid {
                padding-left: 16px !important;
                padding-right: 16px !important;
            }

            .navbar-brand img {
                height: 44px !important;
            }

            .navbar-collapse {
                padding-top: 12px;
            }

            .navbar-nav:last-child .btn {
                width: 100%;
                margin-top: 8px;
            }
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow">
            <div class="container-fluid px-4">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <img src="/Media/common/CampusLearnLogo.png" alt="CampusLearn Logo" style="height:50px;" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Index" ? "active" : "")" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Student/Dashboard" ? "active" : "")" asp-area="" asp-page="/Student/Dashboard">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Communication/Forum" ? "active" : "")" asp-area="" asp-page="/Communication/Forum">Forum</a>
                        </li>
                    </ul>

                    <div class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-page="/Student/Dashboard"
                               class="nav-link">
                                Dashboard
                            </a>

                            <a asp-page="/Tutors/Index"
                               class="nav-link">
                                Tutors
                            </a>

                            <a asp-page="/Bookings/Index"
                               class="nav-link">
                                My bookings
                            </a>

                            <form method="post"
                                  asp-page="/Account/SignOut"
                                  class="d-inline">
                                <button type="submit"
                                        class="btn btn-link nav-link">
                                    Sign out
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-page="/Account/SignIn"
                               class="nav-link">
                                Sign in
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="text-light pt-4 pb-4" style="background-color:#1E1E1E;">
        <div class="container">
            <div class="row text-start align-items-start">
                <div class="col-12 col-md-4 mb-4">
                    <h5 class="mb-3">Visit Us</h5>
                    <div class="location">
                        <p><i class="bi bi-geo-alt-fill me-2"></i> Pretoria Campus</p>
                        <p><i class="bi bi-geo-alt-fill me-2"></i> Kempton Park Campus</p>
                        <p><i class="bi bi-geo-alt-fill me-2"></i> Stellenbosch Campus</p>
                    </div>
                </div>

                <div class="col-12 col-md-4 mb-4">
                    <h5 class="mb-3">Important Links</h5>
                    <ul class="footer-links">
                        <li><a href="#">Apply Now</a></li>
                        <li><a href="#">Qualifications</a></li>
                        <li><a href="#">Important Documentation</a></li>
                        <li><a href="/Privacy">Privacy Policy</a></li>
                        <li><a href="#">Articles</a></li>
                    </ul>
                </div>

                <div class="col-12 col-md-4 mb-3">
                    <div class="logo-box">
                        <img src="/Media/common/footer-logo.png" alt="Belgium Campus ITversity Logo" class="img-fluid">
                    </div>
                </div>
            </div>

            <div class="text-center mt-4 border-top pt-3">
                <small>&copy; 2025 Belgium Campus ITversity. All Rights Reserved.</small>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
