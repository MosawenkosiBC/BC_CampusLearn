<div class="modal fade join-meeting-unavailable-modal"
     id="join-meeting-unavailable-modal"
     tabindex="-1"
     aria-labelledby="join-meeting-unavailable-title"
     aria-hidden="true"
     data-join-meeting-unavailable-modal>
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2 id="join-meeting-unavailable-title">Join meeting unavailable</h2>
                    <p data-join-meeting-unavailable-message>
                        You can join the meeting five minutes before the scheduled start time.
                    </p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-footer">
                <button type="button" class="join-meeting-unavailable-dismiss"
                        data-bs-dismiss="modal">Got it</button>
            </div>
        </div>
    </div>
</div>
