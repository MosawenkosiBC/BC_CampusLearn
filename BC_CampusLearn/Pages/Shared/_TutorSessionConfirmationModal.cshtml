@model BC_CampusLearn.Models.ViewModels.TutorSessionConfirmationViewModel
<div class="modal fade bookings-action-modal" id="tutor-confirm-session-modal"
     tabindex="-1" aria-labelledby="tutor-confirm-session-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="Confirm" data-tutor-confirm-form data-session-confirm-form="true"
                  data-teams-enabled="@(Model.TeamsMeetingCreationEnabled ? "true" : "false")" novalidate>
                <input type="hidden" name="bookingId" data-tutor-confirm-booking-id />
                <div class="modal-header">
                    <div>
                        <h2 id="tutor-confirm-session-title">Confirm session</h2>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (Model.TeamsMeetingCreationEnabled)
                    {
                        <p>Create a Teams meeting and invite the student.</p>
                        <button type="button" class="btn btn-secondary mb-3" data-toggle-manual-link
                                aria-expanded="false" aria-controls="tutor-manual-meeting-link" aria-label="Add a manual meeting link">+</button>
                    }
                    <div class="alert alert-danger" data-confirm-error role="alert" hidden></div>
                    <div data-confirm-success role="status" hidden>
                        <p>Your Teams meeting link has been generated, the invitation sent to the student, and the session confirmed.</p>
                        <button type="button" class="btn bookings-modal-primary">Done</button>
                    </div>
                    <p data-confirm-progress role="status" hidden>Creating your Teams meeting and confirming the session…</p>
                    <div id="tutor-manual-meeting-link" data-manual-link-section hidden="@Model.TeamsMeetingCreationEnabled">
                    <label for="tutor-confirm-meeting-link">Manual meeting link</label>
                    <input id="tutor-confirm-meeting-link" name="meetingLink"
                           type="url" maxlength="2048"
                           placeholder="https://teams.microsoft.com/..."
                           autocomplete="url" required />
                    <button type="submit" class="btn bookings-modal-primary mt-3">Confirm session</button>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light"
                            data-bs-dismiss="modal">Cancel</button>
                    @if (Model.TeamsMeetingCreationEnabled)
                    {
                        <button type="button" class="btn btn-teams" data-generate-teams-link
                                data-generate-url="@Model.GenerateUrl"><i class="bi bi-microsoft-teams me-2" aria-hidden="true"></i>Create Teams meeting</button>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

